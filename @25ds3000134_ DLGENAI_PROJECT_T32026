4095Z","iopub.status.busy":"2026-11-03T05:49:21.793207Z","iopub.status.idle":"2026-11-03T05:49:22.257065Z","shell.execute_reply":"2026-11-03T05:49:22.256174Z"},"papermill":{"duration":0.487198,"end_time":"2026-11-03T05:49:22.258773+00:00","exception":false,"start_time":"2026-11-03T05:49:21.771575+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Define image and mask loading","metadata":{"papermill":{"duration":0.018092,"end_time":"2026-11-03T05:49:22.296951+00:00","exception":false,"start_time":"2026-11-03T05:49:22.278859+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"import torch\nfrom torch.utils.data import Dataset, DataLoader\n\nDEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(\"Using device:\", DEVICE)\n\nHEIGHT, WIDTH = 128, 800\n\nclass DefectDataset(Dataset):\n    \"\"\"Returns (RGB image in 0-1, 4 binary masks). augment=True -> flips + brightness/contrast.\"\"\"\n    def __init__(self, dataframe, augment=False):\n        df = dataframe.reset_index(drop=True)\n        self.paths = df[\"image_path\"].tolist()\n        self.rles = df[CLASSES].values.tolist()\n        self.augment = augment\n\n    def __len__(self):\n        return len(self.paths)\n\n    def __getitem__(self, idx):\n        image = cv2.imread(self.paths[idx])\n        if image is None:\n            raise FileNotFoundError(self.paths[idx])\n        image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n        image = cv2.resize(image, (WIDTH, HEIGHT)).astype(np.float32) / 255.0\n\n        masks = np.stack([decode_rle(r, HEIGHT, WIDTH) for r in self.rles[idx]], axis=0).astype(np.float32)\n\n        if self.augment:\n            if random.random() < 0.5:                      # horizontal flip\n                image, masks = image[:, ::-1], masks[:, :, ::-1]\n            if random.random() < 0.5:                      # vertical flip\n                image, masks = image[::-1], masks[:, ::-1]\n            if random.random() < 0.5:                      # brightness / contrast\n                image = np.clip(image * random.uniform(0.8, 1.2) + random.uniform(-0.08, 0.08), 0, 1)\n\n        image = torch.from_numpy(np.ascontiguousarray(image.transpose(2, 0, 1)))\n        masks = torch.from_numpy(np.ascontiguousarray(masks))\n        return image, masks","metadata":{"execution":{"iopub.execute_input":"2026-11-03T05:49:22.334896Z","iopub.status.busy":"2026-11-03T05:49:22.334104Z","iopub.status.idle":"2026-11-03T05:49:29.533911Z","shell.execute_reply":"2026-11-03T05:49:29.533005Z"},"papermill":{"duration":7.221216,"end_time":"2026-11-03T05:49:29.535659+00:00","exception":false,"start_time":"2026-11-03T05:49:22.314443+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# 15. Create DataLoaders","metadata":{"papermill":{"duration":0.020353,"end_time":"2026-11-03T05:49:29.575684+00:00","exception":false,"start_time":"2026-11-03T05:49:29.555331+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"BATCH_SIZE = 8\n\ntrain_dataset = DefectDataset(train_df, augment=True)\nval_dataset = DefectDataset(val_df, augment=False)\n\ntrain_loader = DataLoader(\n    train_dataset, batch_size=BATCH_SIZE, shuffle=True, drop_last=True,\n    num_workers=2, pin_memory=torch.cuda.is_available(), persistent_workers=True\n)\nval_loader = DataLoader(\n    val_dataset, batch_size=BATCH_SIZE * 2, shuffle=False,\n    num_workers=2, pin_memory=torch.cuda.is_available(), persistent_workers=True\n)\n\nprint(\"Training batches:\", len(train_loader))\nprint(\"Validation batches:\", len(val_loader))","metadata":{"execution":{"iopub.execute_input":"2026-11-03T05:49:29.615304Z","iopub.status.busy":"2026-11-03T05:49:29.614636Z","iopub.status.idle":"2026-11-03T05:49:29.628634Z","shell.execute_reply":"2026-11-03T05:49:29.627866Z"},"papermill":{"duration":0.036223,"end_time":"2026-11-03T05:49:29.630692+00:00","exception":false,"start_time":"2026-11-03T05:49:29.594469+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Verify one batch before training","metadata":{"papermill":{"duration":0.019814,"end_time":"2026-11-03T05:49:29.671709+00:00","exception":false,"start_time":"2026-11-03T05:49:29.651895+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"images, masks = next(iter(train_loader))\n\nprint(\"Image batch:\", images.shape)\nprint(\"Mask batch:\", masks.shape)\nprint(\"Image range:\", images.min().item(), images.max().item())\nprint(\"Mask values:\", torch.unique(masks))","metadata":{"execution":{"iopub.execute_input":"2026-11-03T05:49:29.714817Z","iopub.status.busy":"2026-11-03T05:49:29.714011Z","iopub.status.idle":"2026-11-03T05:49:30.659977Z","shell.execute_reply":"2026-11-03T05:49:30.658901Z"},"papermill":{"duration":0.969977,"end_time":"2026-11-03T05:49:30.66208+00:00","exception":false,"start_time":"2026-11-03T05:49:29.692103+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# 17. The U-Net model from Scratch","metadata":{"papermill":{"duration":0.018984,"end_time":"2026-11-03T05:49:30.701065+00:00","exception":false,"start_time":"2026-11-03T05:49:30.682081+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"import torch.nn as nn\nimport torch.nn.functional as F\n\nclass ConvBlock(nn.Module):\n    def __init__(self, in_ch, out_ch):\n        super().__init__()\n        self.block = nn.Sequential(\n            nn.Conv2d(in_ch, out_ch, 3, padding=1),\n            nn.BatchNorm2d(out_ch),\n            nn.ReLU(inplace=True),\n            nn.Conv2d(out_ch, out_ch, 3, padding=1),\n            nn.BatchNorm2d(out_ch),\n            nn.ReLU(inplace=True)\n        )\n\n    def forward(self, x):\n        return self.block(x)\n\n\nclass UNet(nn.Module):\n    def __init__(self, out_channels=4):\n        super().__init__()\n        self.enc1 = ConvBlock(3, 32)\n        self.enc2 = ConvBlock(32, 64)\n        self.enc3 = ConvBlock(64, 128)\n        self.enc4 = ConvBlock(128, 256)\n\n        self.pool = nn.MaxPool2d(2)\n        self.bottleneck = ConvBlock(256, 512)\n\n        self.up4 = nn.ConvTranspose2d(512, 256, 2, stride=2)\n        self.dec4 = ConvBlock(512, 256)\n        self.up3 = nn.ConvTranspose2d(256, 128, 2, stride=2)\n        self.dec3 = ConvBlock(256, 128)\n        self.up2 = nn.ConvTranspose2d(128, 64, 2, stride=2)\n        self.dec2 = ConvBlock(128, 64)\n        self.up1 = nn.ConvTranspose2d(64, 32, 2, stride=2)\n        self.dec1 = ConvBlock(64, 32)\n\n        self.output = nn.Conv2d(32, out_channels, 1)\n\n    def forward(self, x):\n        e1 = self.enc1(x)\n        e2 = self.enc2(self.pool(e1))\n        e3 = self.enc3(self.pool(e2))\n        e4 = self.enc4(self.pool(e3))\n        b = self.bottleneck(self.pool(e4))\n\n        d4 = self.dec4(torch.cat([self.up4(b), e4], dim=1))\n        d3 = self.dec3(torch.cat([self.up3(d4), e3], dim=1))\n        d2 = self.dec2(torch.cat([self.up2(d3), e2], dim=1))\n        d1 = self.dec1(torch.cat([self.up1(d2), e1], dim=1))\n\n        return self.output(d1)\n\n\nmodel = UNet().to(DEVICE)\nprint(\"Model parameters:\", f\"{sum(p.numel() for p in model.parameters()):,}\")","metadata":{"execution":{"iopub.execute_input":"2026-11-03T05:49:30.741318Z","iopub.status.busy":"2026-11-03T05:49:30.740731Z","iopub.status.idle":"2026-11-03T05:49:30.852003Z","shell.execute_reply":"2026-11-03T05:49:30.851088Z"},"papermill":{"duration":0.133643,"end_time":"2026-11-03T05:49:30.853793+00:00","exception":false,"start_time":"2026-11-03T05:49:30.72015+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# 18. Define the combined loss and Dice metric","metadata":{"papermill":{"duration":0.018747,"end_time":"2026-11-03T05:49:30.900628+00:00","exception":false,"start_time":"2026-11-03T05:49:30.881881+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"def metric_aligned_loss(logits, targets, pos_weight=None, eps=1.0):\n    \"\"\"\n    BCE + soft-Dice. Dice is computed on every (strip, class) mask:\n      * positive masks  -> reward overlap            (70% foreground-Dice part of the metric)\n      * empty masks     -> soft-Dice = 1 - 1/(sum(p)+1), which punishes ANY predicted mass\n                           (the 20% false-positive + 10% empty-accuracy parts)\n    Independent sigmoid per class (multi-label), never softmax.\n    \"\"\"\n    logits = logits.float()\n    targets = targets.float()\n    probs = torch.sigmoid(logits)\n\n    p = probs.flatten(2)\n    t = targets.flatten(2)\n    dice_loss_map = 1.0 - (2.0 * (p * t).sum(2) + eps) / (p.sum(2) + t.sum(2) + eps)   # [B, 4]\n    positive = t.sum(2) > 0\n\n    fg = dice_loss_map[positive].mean() if positive.any() else probs.mean() * 0.0\n    empty = dice_loss_map[~positive].mean() if (~positive).any() else probs.mean() * 0.0\n\n    if pos_weight is None:\n        bce = F.binary_cross_entropy_with_logits(logits, targets)\n    else:\n        bce = F.binary_cross_entropy_with_logits(logits, targets, pos_weight=pos_weight.view(1, -1, 1, 1))\n\n    return bce + 0.7 * fg + 0.3 * empty\n\n\ndef dice_loss(logits, targets, smooth=1.0):\n    probs = torch.sigmoid(logits).flatten(2)\n    targets = targets.flatten(2)\n    dice = (2 * (probs * targets).sum(2) + smooth) / (probs.sum(2) + targets.sum(2) + smooth)\n    return 1 - dice.mean()\n\n\nbce_loss = nn.BCEWithLogitsLoss()\n\ndef combined_loss(logits, targets):\n    return metric_aligned_loss(logits, targets)\n\n\n@torch.no_grad()\ndef batch_dice_score(logits, targets, threshold=0.5, smooth=1.0):\n    preds = (torch.sigmoid(logits.float()) >= threshold).float().flatten(2)\n    targets = targets.flatten(2)\n    inter = (preds * targets).sum(2)\n    den = preds.sum(2) + targets.sum(2)\n    return ((2 * inter + smooth) / (den + smooth)).mean().item()\n\n\nprint(\"Independent-sigmoid outputs and BCE + Dice (positive/empty weighted) loss ready.\")","metadata":{"execution":{"iopub.execute_input":"2026-11-03T05:49:30.938528Z","iopub.status.busy":"2026-11-03T05:49:30.938149Z","iopub.status.idle":"2026-11-03T05:49:30.948787Z","shell.execute_reply":"2026-11-03T05:49:30.947894Z"},"papermill":{"duration":0.031414,"end_time":"2026-11-03T05:49:30.950204+00:00","exception":false,"start_time":"2026-11-03T05:49:30.91879+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 19. Weights & Biases experiment tracking","metadata":{"papermill":{"duration":0.019143,"end_time":"2026-11-03T05:49:30.989109+00:00","exception":false,"start_time":"2026-11-03T05:49:30.969966+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"# Track the experiments in the course W&B project.\nimport os\n\nwandb_run = None\nWANDB_ENABLED = False\n\ntry:\n    import wandb\n    from kaggle_secrets import UserSecretsClient\n\n    os.environ[\"WANDB_API_KEY\"] = UserSecretsClient().get_secret(\"WANDB_API_KEY\")\n    wandb.login()\n\n    wandb_run = wandb.init(\n        entity=\"25ds3000134-ds\",\n        project=\"25DS3000134_DLGENAI_PROJECT_T32026\",\n        name=\"industrial-surface_defect-pretrained-experiments\",\n        config={\n            \"task\": \"industrial_surface_defect_segmentation\",\n            \"dataset\": \"Industrial Surface Defect Detection\",\n            \"classes\": list(CLASSES),\n            \"image_height\": HEIGHT,\n            \"image_width\": WIDTH,\n            \"batch_size\": BATCH_SIZE,\n            \"models\": [\"Scratch U-Net\", \"FPN EfficientNet-B4\", \"U-Net++ EfficientNet-B3\"],\n            \"sampling\": \"defect-positive strips for training; full validation retained\",\n            \"tta\": \"four-way flips\",\n            \"postprocessing\": \"validation-tuned thresholds and strip gate\"\n        },\n    )\n    WANDB_ENABLED = True\n    print(\"W