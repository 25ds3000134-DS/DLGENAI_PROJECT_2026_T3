":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# 24. Evaluate Dice for each defect class","metadata":{"papermill":{"duration":0.026573,"end_time":"2026-11-03T06:35:20.492835+00:00","exception":false,"start_time":"2026-11-03T06:35:20.466262+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"class_scores = {}\n\nwith torch.no_grad():\n    for cls_idx, cls in enumerate(CLASSES):\n        intersections = 0\n        totals = 0\n\n        for images, masks in val_loader:\n            images = images.to(DEVICE)\n            probs = torch.sigmoid(model(images))[:, cls_idx]\n            preds = (probs >= 0.5).float()\n            targets = masks[:, cls_idx].to(DEVICE)\n\n            intersections += (preds * targets).sum().item()\n            totals += preds.sum().item() + targets.sum().item()\n\n        class_scores[cls] = (\n            2 * intersections + 1\n        ) / (totals + 1)\n\nprint(\"Per-class validation Dice:\")\ndisplay(pd.Series(class_scores, name=\"Dice Score\").to_frame())","metadata":{"execution":{"iopub.execute_input":"2026-11-03T06:35:20.547862Z","iopub.status.busy":"2026-11-03T06:35:20.547456Z","iopub.status.idle":"2026-11-03T06:36:53.435008Z","shell.execute_reply":"2026-11-03T06:36:53.434139Z"},"papermill":{"duration":92.94786,"end_time":"2026-11-03T06:36:53.467683+00:00","exception":false,"start_time":"2026-11-03T06:35:20.519823+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# import dill\n# # Save the entire notebook session state\n# dill.dump_session('/kaggle/working/notebook_env.db')\n","metadata":{"execution":{"iopub.execute_input":"2026-11-03T06:36:53.525421Z","iopub.status.busy":"2026-11-03T06:36:53.52496Z","iopub.status.idle":"2026-11-03T06:36:53.528747Z","shell.execute_reply":"2026-11-03T06:36:53.528092Z"},"papermill":{"duration":0.034003,"end_time":"2026-11-03T06:36:53.530405+00:00","exception":false,"start_time":"2026-11-03T06:36:53.496402+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# import dill\n# # Restore everything back into memory\n# dill.load_session('/kaggle/working/notebook_env.db')\n","metadata":{"execution":{"iopub.execute_input":"2026-11-03T06:36:53.586367Z","iopub.status.busy":"2026-11-03T06:36:53.585884Z","iopub.status.idle":"2026-11-03T06:36:53.589493Z","shell.execute_reply":"2026-11-03T06:36:53.588799Z"},"papermill":{"duration":0.03344,"end_time":"2026-11-03T06:36:53.591072+00:00","exception":false,"start_time":"2026-11-03T06:36:53.557632+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# 25. Tune Model 1's prediction threshold","metadata":{"papermill":{"duration":0.026913,"end_time":"2026-11-03T06:36:53.645603+00:00","exception":false,"start_time":"2026-11-03T06:36:53.61869+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"thresholds = [0.20, 0.30, 0.40, 0.50, 0.60]\nthreshold_results = []\n\nmodel.eval()\n\nwith torch.no_grad():\n    for threshold in thresholds:\n        intersection = torch.zeros(len(CLASSES), device=DEVICE)\n        denominator = torch.zeros(len(CLASSES), device=DEVICE)\n\n        for images, masks in val_loader:\n            images = images.to(DEVICE)\n            masks = masks.to(DEVICE)\n\n            probs = torch.sigmoid(model(images))\n            preds = (probs >= threshold).float()\n\n            intersection += (preds * masks).sum(dim=(0, 2, 3))\n            denominator += preds.sum(dim=(0, 2, 3)) + masks.sum(dim=(0, 2, 3))\n\n        dice = (2 * intersection + 1) / (denominator + 1)\n\n        threshold_results.append({\n            \"threshold\": threshold,\n            \"mean_dice\": dice.mean().item()\n        })\n\nthreshold_df = pd.DataFrame(threshold_results)\ndisplay(threshold_df)\n\nbest_threshold = float(\n    threshold_df.loc[threshold_df[\"mean_dice\"].idxmax(), \"threshold\"]\n)\nprint(\"Best threshold for this diagnostic:\", best_threshold)","metadata":{"execution":{"iopub.execute_input":"2026-11-03T06:36:53.701444Z","iopub.status.busy":"2026-11-03T06:36:53.700959Z","iopub.status.idle":"2026-11-03T06:38:49.99971Z","shell.execute_reply":"2026-11-03T06:38:49.998863Z"},"papermill":{"duration":116.352851,"end_time":"2026-11-03T06:38:50.025397+00:00","exception":false,"start_time":"2026-11-03T06:36:53.672546+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def encode_rle(mask):\n    pixels = np.asarray(mask, dtype=np.uint8).T.flatten()\n    pixels = np.concatenate(([0], pixels, [0]))\n\n    changes = np.where(pixels[1:] != pixels[:-1])[0] + 1\n    changes[1::2] -= changes[::2]\n\n    return \" \".join(map(str, changes))","metadata":{"execution":{"iopub.execute_input":"2026-11-03T06:38:50.079063Z","iopub.status.busy":"2026-11-03T06:38:50.078623Z","iopub.status.idle":"2026-11-03T06:38:50.083991Z","shell.execute_reply":"2026-11-03T06:38:50.08331Z"},"papermill":{"duration":0.034445,"end_time":"2026-11-03T06:38:50.085596+00:00","exception":false,"start_time":"2026-11-03T06:38:50.051151+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 6. Install and configure pretrained segmentation models\n\nThe data paths, image IDs, class names, and submission schema below follow the original `dl-25ds3000137-notebook-t32026 (resformer)` notebook. This version keeps the scratch U-Net and replaces the old ResNet34/ResFormer experiments with FPN–EfficientNet-B4 and U-Net++–EfficientNet-B3.","metadata":{"papermill":{"duration":0.027169,"end_time":"2026-11-03T06:38:50.139118+00:00","exception":false,"start_time":"2026-11-03T06:38:50.111949+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"import segmentation_models_pytorch as smp\nprint('segmentation-models-pytorch:', smp.__version__)","metadata":{"execution":{"iopub.execute_input":"2026-11-03T06:38:50.192896Z","iopub.status.busy":"2026-11-03T06:38:50.192605Z","iopub.status.idle":"2026-11-03T06:38:52.866976Z","shell.execute_reply":"2026-11-03T06:38:52.865823Z"},"papermill":{"duration":2.703873,"end_time":"2026-11-03T06:38:52.868972+00:00","exception":false,"start_time":"2026-11-03T06:38:50.165099+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### Model wrapper and ImageNet normalization\n\nThe original dataset returns RGB images scaled to 0–1. This wrapper applies ImageNet normalization only for the pretrained encoders; the scratch U-Net continues to use the original 0–1 input.","metadata":{"papermill":{"duration":0.032164,"end_time":"2026-11-03T06:38:52.933812+00:00","exception":false,"start_time":"2026-11-03T06:38:52.901648+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"import copy\nimport torch\nimport torch.nn as nn\nfrom tqdm.auto import tqdm\n\nclass PretrainedSegmentationModel(nn.Module):\n    def __init__(self, network):\n        super().__init__()\n        self.network = network\n        self.register_buffer(\"mean\", torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1))\n        self.register_buffer(\"std\", torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1))\n\n    def forward(self, images):\n        return self.network((images - self.mean) / self.std)\n\nmodel_fpn = PretrainedSegmentationModel(\n    smp.FPN(\n        encoder_name=\"efficientnet-b4\",\n        encoder_weights=\"imagenet\",\n        in_channels=3,\n        classes=len(CLASSES),\n        activation=None\n    )\n).to(DEVICE)\n\nmodel_unetpp = PretrainedSegmentationModel(\n    smp.UnetPlusPlus(\n        encoder_name=\"efficientnet-b3\",\n        encoder_weights=\"imagenet\",\n        in_channels=3,\n        classes=len(CLASSES),\n        activation=None\n    )\n).to(DEVICE)\n\nprint(\"FPN-EfficientNet-B4 and U-Net++-EfficientNet-B3 are ready.\")\n","metadata":{"execution":{"iopub.execute_input":"2026-11-03T06:38:52.999566Z","iopub.status.busy":"2026-11-03T06:38:52.999056Z","iopub.status.idle":"2026-11-03T06:38:56.703686Z","shell.execute_reply":"2026-11-03T06:38:56.702782Z"},"papermill":{"duration":3.738719,"end_time":"2026-11-03T06:38:56.705189+00:00","exception":false,"start_time":"2026-11-03T06:38:52.96647+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 7. Train FPN and U-Net++ (single split, up to 15 epochs each)","metadata":{"papermill":{"duration":0.026343,"end_time":"2026-11-03T06:38:56.758678+00:00","exception":false,"start_time":"2026-11-03T06:38:56.732335+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"EPOCHS_EXTRA = 15\nLR_EXTRA = 3e-4\nPATIENCE_EXTRA = 5\n\nprint(\"Each pretrained architecture: up to\", EPOCHS_EXTRA, \"epochs, AMP on, early-stopping patience\", PATIENCE_EXTRA)\n\nclass ModelEMA:\n    def __init__(self, source_model, decay=0.99):\n        self.ema = copy.deepcopy(source_model).eval()\n        self.decay = decay\n        for parameter in self.ema.parameters():\n            parameter.requires_grad_(False)\n\n    @torch.no_grad()\n    def update(self, source_model):\n        source_state = source_model.state_dict()\n        for key, ema_value in self.ema.state_dict().items():\n            source_value = source_state[key].detach()\n            if ema_value.is_floating_point():\n                ema_value.mul_(self.decay).add_(source_value, alpha=1.0 - self.decay)\n            else:\n                ema_value.copy_(source_value)\n\ndef train_pretrained_model(net, model_name, epochs=EPOCHS_EXTRA, lr=LR_EXTRA):\n    use_amp = DEVICE.type == \"cuda\"\n    optimizer_extra = torch.optim.AdamW(net.parameters(), lr=lr, weight_decay=1e-4)\n    scheduler_extra = torch.optim.lr_scheduler.OneCycleLR(\n        optimizer_extra, max_lr=lr, epochs=epochs, steps_per_epoch=len(train_loader), pct_start=0.15\n    )\n    scaler = torch.cuda.amp.GradScaler(enabled=use_amp)\n    ema = ModelEMA(net, decay=0.99)\n    best_val_loss = float(\"inf\")\n    best_path = f\"/kaggle/working/{model_name}_best_ema.pth\"\n    history_rows = []\n    wait = 0\n\n    for epoch in range(epochs):\n        net.train()\n        train_total = 0.0\n        for images, masks in tqdm(train_loader, desc=f\"{model_name} {epoch + 1}/{epochs}\"):\n            images, masks = images.to(DEVICE, non_blocking=True), masks.to(DEVICE, non_blocking=True)\n            optimizer_extra.zero_grad(set_to_none=True)\n            with torch.autocast(device_type=\"cuda\", dtype=torch.float16, enabled=use_amp):\n                logits = net(images)\n            loss = metric_aligned_loss(logits, masks)          # computed in float32\n            scaler.scale(loss).backward()\n            scaler.unscale_(optimizer_extra)\n            torch.nn.utils.clip_grad_norm_(net.parameters(), 1.0)\n            scaler.step(optimizer_extra)\n            scaler.update()\n            scheduler_extra.step()\n            ema.update(net)\n            train_total += loss.item()\n\n        ema.ema.eval()\n        val_total, dice_total = 0.0, 0.0\n        with torch.no_grad():\n            for images, masks in val_loader:\n                images, masks = images.to(DEVICE), masks.to(DEVICE)\n                with torch.autocast(device_type=\"cuda\", dtype=torch.float16, enabled=use_amp):\n                    logits = ema.ema(images)\n                val_total += metric_aligned_loss(logits, masks).item()\n                dice_total += batch_dice_score(logits, masks)\n\n        train_loss = train_total / max(1, len(train_loader))\n        val_loss = val_total / max(1, len(val_loader))\n        val_dice = dice_total / max(1, len(val_loader))\n        history_rows.append({\"epoch\": epoch + 1, \"train_loss\": train_loss,\n                             \"val_loss\": val_loss, \"val_dice\": val_dice})\n\n        if wandb_run is not None:\n            wandb_run.log({\n                f\"{model_name}/epoch\": epoch + 1,\n                f\"{model_name}/train_loss\": train_loss,\n                f\"{model_name}/val_loss_ema\": val_loss,\n                f\"{model_name}/val_dice_ema\": val_dice\n            })\n\n        print(f\"{model_name} | epoch {epoch + 1}: train={train_loss:.4f}, val={val_loss:.4f}, EMA Dice={val_dice:.4f}\")\n        if val_loss < best_val_loss:\n            best_val_loss = val_loss\n            wait = 0\n            torch.save(ema.ema.state_dict(), best_path)\n        else:\n            wait += 1\n            if wait >= PATIENCE_EXTRA:\n                print(f\"Early stopping {model_name}.\")\n                break\n\n    if not os.path.exists(best_path):\n        raise RuntimeError(f\"No best checkpoint was saved for {model_name}.\")\n    net.load_state_dict(torch.load(best_path, map_location=DEVICE, weights_only=True))\n    net.eval()\n    return net, pd.DataFrame(history_rows), best_path\n\nmodel_fpn, history_fpn, fpn_checkpoint = train_pretrained_model(model_fpn, \"fpn_effb4\")\ndisplay(history_fpn.tail())","metadata":{"execution":{"iopub.execute_input":"2026-11-03T06:38:56.814189Z","iopub.status.busy":"2026-11-03T06:38:56.813193Z","iopub.status.idle":"2026-11-03T07:19:00.372192Z","shell.execute_reply":"2026-11-03T07:19:00.371275Z"},"papermill":{"duration":2403.587498,"end_time":"2026-11-03T07:19:00.374128+00:00","exception":false,"start_time":"2026-11-03T06:38:56.78663+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### Train U-Net++–EfficientNet-B3","metadata":{"papermill":{"duration":0.028281,"end_time":"2026-11-03T07:19:00.431408+00:00","exception":false,"start_time":"2026-11-03T07:19:00.403127+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"model_unetpp, history_unetpp, unetpp_checkpoint = train_pretrained_model(\n    model_unetpp, \"unetpp_effb3\"\n)\ndisplay(history_unetpp.tail())\n","metadata":{"execution":{"iopub.execute_input":"2026-11-03T07:19:00.488147Z","iopub.status.busy":"2026-11-03T07:19:00.487693Z","iopub.status.idle":"2026-11-03T08:12:34.439101Z","shell.execute_reply":"2026-11-03T08:12:34.438311Z"},"papermill":{"duration":3213.981767,"end_time":"2026-11-03T08:12:34.44125+00:00","exception":false,"start_time":"2026-11-03T07:19:00.459483+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 8. Validation inference, ensemble-weight tuning and per-class post-processing tuned on the OFFICIAL metric\n\nFor every blend of the three models we tune, **per defect class**: pixel threshold, strip gate (max-probability needed to report the class at all) and minimum predicted area. Choices maximise 0.7 x foreground Dice + 0.2 x false-positive score + 0.1 x empty accuracy on the full validation split (clean strips included).","metadata":{"papermill":{"duration":0.034353,"end_time":"2026-11-03T08:12:34.510962+00:00","exception":false,"start_time":"2026-11-03T08:12:34.476609+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"import gc\n\n@torch.no_grad()\ndef predict_tta(net, images):\n    net.eval()\n    use_amp = DEVICE.type == \"cuda\"\n    with torch.autocast(device_type=\"cuda\", dtype=torch.float16, enabled=use_amp):\n        p0 = torch.sigmoid(net(images).float())\n        p1 = torch.flip(torch.sigmoid(net(torch.flip(images, dims=[3])).float()), dims=[3])\n        p2 = torch.flip(torch.sigmoid(net(torch.flip(images, dims=[2])).float()), dims=[2])\n        p3 = torch.flip(torch.sigmoid(net(torch.flip(images, dims=[2, 3])).float()), dims=[2, 3])\n    return (p0 + p1 + p2 + p3) / 4.0\n\n\n# ---- cache validation probabilities (float16 on disk) -------------------------------\nn_val = len(val_loader.dataset)\nval_shape = (n_val, len(CLASSES), HEIGHT, WIDTH)\nval_scratch = np.memmap(\"/kaggle/working/val_scratch_float16.dat\", mode=\"w+\", dtype=np.float16, shape=val_shape)\nval_fpn = np.memmap(\"/kaggle/working/val_fpn_float16.dat\", mode=\"w+\", dtype=np.float16, shape=val_shape)\nval_unetpp = np.memmap(\"/kaggle/working/val_unetpp_float16.dat\", mode=\"w+\", dtype=np.float16, shape=val_shape)\nval_truth = np.memmap(\"/kaggle/working/val_masks_uint8.dat\", mode=\"w+\", dtype=np.uint8, shape=val_shape)\n\noffset = 0\nwith torch.no_grad():\n    for images, masks in tqdm(val_loader, desc=\"Caching validation predictions\"):\n        images = images.to(DEVICE)\n        end = offset + images.shape[0]\n        val_scratch[offset:end] = predict_tta(model, images).cpu().numpy().astype(np.float16)\n        val_fpn[offset:end] = predict_tta(model_fpn, images).cpu().numpy().astype(np.float16)\n        val_unetpp[offset:end] = predict_tta(model_unetpp, images).cpu().numpy().astype(np.float16)\n        val_truth[offset:end] = masks.numpy().astype(np.uint8)\n        offset = end\nfor mm in (val_scratch, val_fpn, val_unetpp, val_truth):\n    mm.flush()\nassert offset == n_val\nprint(\"Validation maps ready:\", val_shape)\n\n\n# ---- official competition metric --------------------------------------------------------\nHW = HEIGHT * WIDTH\nPIX_T = [0.30, 0.40, 0.50, 0.60, 0.70, 0.80]        # pixel thresholds\nGATES = [0.0, 0.50, 0.60, 0.70, 0.80, 0.90]         # strip gate: max prob needed to report the class\nAREAS = [0, 100, 200, 400, 800, 1500, 3000]         # minimum predicted pixels\n\nweight_candidates = [          # (scratch, FPN-B4, U-Net++-B3)\n    (0.10, 0.45, 0.45), (0.00, 0.50, 0.50), (0.00, 0.60, 0.40),\n    (0.00, 0.40, 0.60), (0.00, 1.00, 0.00), (0.00, 0.00, 1.00),\n]\n\ndef blend_stats(weights, chunk=16):\n    \"\"\"Per (strip, class): predicted area / intersection for each pixel threshold, max prob, GT area.\"\"\"\n    T = len(PIX_T)\n    pa = np.zeros((T, n_val, 4)); inter = np.zeros((T, n_val, 4))\n    mx = np.zeros((n_val, 4), np.float32); ga = np.zeros((n_val, 4))\n    for s in range(0, n_val, chunk):\n        e = min(s + chunk, n_val)\n        p = (weights[0] * np.asarray(val_scratch[s:e], dtype=np.float32)\n             + weights[1] * np.asarray(val_fpn[s:e], dtype=np.float32)\n             + weights[2] * np.asarray(val_unetpp[s:e], dtype=np.float32))\n        y = np.asarray(val_truth[s:e], dtype=bool)\n        mx[s:e] = p.reshape(e - s, 4, -1).max(axis=2)\n        ga[s:e] = y.sum(axis=(2, 3))\n        for ti, t in enumerate(PIX_T):\n            pr = p >= t\n            pa[ti, s:e] = pr.sum(axis=(2, 3))\n            inter[ti, s:e] = (pr & y).sum(axis=(2, 3))\n    return pa, inter, mx, ga\n\ndef tune_per_class(pa, inter, mx, ga):\n    \"\"\"The official score is additive over classes, so each class is tuned independently.\"\"\"\n    pos, emp = ga > 0, ga == 0\n    n_pos, n_emp = max(pos.sum(), 1), max(emp.sum(), 1)\n    params, total = {}, 0.2          # 0.2 = FP-score constant when nothing is predicted on empties\n    for c, cls in enumerate(CLASSES):\n        best = (-1e9, None)\n        p_, e_, g_ = pos[:, c], emp[:, c], ga[:, c]\n        for ti, t in enumerate(PIX_T):\n            for g in GATES:\n                for a in AREAS:\n                    keep = (mx[:, c] >= g) & (pa[ti, :, c] >= a)\n                    pa2 = np.where(keep, pa[ti, :, c], 0.0)\n                    it2 = np.where(keep, inter[ti, :, c], 0.0)\n                    dice = 2 * it2[p_] / np.maximum(pa2[p_] + g_[p_], 1)\n                    s = (0.7 * dice.sum() / n_pos\n                         - 0.2 * (pa2[e_] / HW).sum() / n_emp\n                         + 0.1 * (pa2[e_] == 0).sum() / n_emp)\n                    if s > best[0]:\n                        best = (s, (t, g, a))\n        params[cls] = {\"pixel_threshold\": best[1][0], \"gate\": best[1][1], \"min_area\": best[1][2]}\n        total += best[0]\n    return params, total\n\ndef official_components(params, pa, inter, mx, ga):\n    pos, emp = ga > 0, ga == 0\n    PA = np.zeros_like(ga); IN = np.zeros_like(ga)\n    for c, cls in enumerate(CLASSES):\n        q = params[cls]; ti = PIX_T.index(q[\"pixel_threshold\"])\n        keep = (mx[:, c] >= q[\"gate\"]) & (pa[ti, :, c] >= q[\"min_area\"])\n        PA[:, c] = np.where(keep, pa[ti, :, c], 0); IN[:, c] = np.where(keep, inter[ti, :, c], 0)\n    fg = (2 * IN[pos] / np.maximum(PA[pos] + ga[pos], 1)).mean()\n    fp = 1 - (PA[emp] / HW).sum() / max(emp.sum(), 1)\n    ea = (PA[emp] == 0).sum() / max(emp.sum(), 1)\n    return 0.7 * fg + 0.2 * fp + 0.1 * ea, fg, fp, ea\n\n\n# ---- search blends; tune post-processing for each ---------------------------------------\nrows, best_overall = [], None\nfor w in weight_candidates:\n    stats = blend_stats(w)\n    params, total = tune_per_class(*stats)\n    rows.append({\"scratch\": w[0], \"fpn\": w[1], \"unetpp\": w[2], \"official_score\": total})\n    print(f\"weights {w}: official validation score = {total:.4f}\")\n    if best_overall is None or total > best_overall[0]:\n        best_overall = (total, w, params, stats)\n\nweight_results = pd.DataFrame(rows).sort_values(\"official_score\", ascending=False).reset_index(drop=True)\ndisplay(weight_results)\n\nbest_validation_official, best_ensemble_weights, class_params, best_stats = best_overall\nscore, fg, fp, ea = official_components(class_params, *best_stats)\nprint(\"\\nSelected weights (Scratch, FPN, U-Net++):\", best_ensemble_weights)\nprint(f\"Validation OFFICIAL score {score:.4f}  (fgDice {fg:.4f}, FP score {fp:.4f}, empty acc {ea:.4f})\")\ndisplay(pd.DataFrame(class_params).T)\n\n# kept so the W&B cell below still works\nbest_ensemble_threshold = float(np.mean([v[\"pixel_threshold\"] for v in class_params.values()]))\nbest_strip_gate_threshold = float(np.mean([v[\"gate\"] for v in class_params.values()]))\nbest_validation_mean_dice = float(fg)\n\ndel val_scratch, val_fpn, val_unetpp, val_truth, best_stats\ngc.collect()","metadata":{"execution":{"iopub.execute_input":"2026-11-03T08:12:34.589144Z","iopub.status.busy":"2026-11-03T08:12:34.588797Z","iopub.status.idle":"2026-11-03T08:21:52.095262Z","shell.execute_reply":"2026-11-03T08:21:52.094448Z"},"papermill":{"duration":557.547153,"end_time":"2026-11-03T08:21:52.097107+00:00","exception":false,"start_time":"2026-11-03T08:12:34.549954+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 9. Locate test images using the original competition IDs\n\nThis follows the previous notebook's approach: read the competition `sample_submission.csv`, find test images by their filename stems, and preserve the sample submission row order exactly.","metadata":{"papermill":{"duration":0.030731,"end_time":"2026-11-03T08:21:52.159726+00:00","exception":false,"start_time":"2026-11-03T08:21:52.128995+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"all_image_paths = glob.glob(\"/kaggle/input/**/*\", recursive=True)\nvalid_extensions = (\".png\", \".jpg\", \".jpeg\", \".bmp\")\nrequested_ids = sample_submission[\"image_id\"].astype(str).unique()\nrequested_stems = {Path(image_id).stem for image_id in requested_ids}\n\n# Prefer paths in a test directory, then fall back to any input image matching a requested ID.\ntest_candidates = [\n    path for path in all_image_paths\n    if path.lower().endswith(valid_extensions)\n    and \"/test/\" in path.replace(\"\\\\\", \"/\").lower()\n    and Path(path).stem in requested_stems\n]\nif not test_candidates:\n    test_candidates = [\n        path for path in all_image_paths\n        if path.lower().endswith(valid_extensions)\n        and Path(path).stem in requested_stems\n    ]\n\ntest_image_map = {}\nfor path in test_candidates:\n    test_image_map.setdefault(Path(path).stem, path)\n\nmissing_ids = [image_id for image_id in requested_ids if Path(image_id).stem not in test_image_map]\nif missing_ids:\n    # Match any remaining requested IDs anywhere under /kaggle/input.\n    fallback_paths = [\n        path for path in all_image_paths\n        if path.lower().endswith(valid_extensions)\n        and Path(path).stem in {Path(image_id).stem for image_id in missing_ids}\n    ]\n    for path in fallback_paths:\n        test_image_map.setdefault(Path(path).stem, path)\n\nmissing_ids = [image_id for image_id in requested_ids if Path(image_id).stem not in test_image_map]\nif missing_ids:\n    raise FileNotFoundError(\n        f\"Could not locate {len(missing_ids)} test images. Example IDs: {missing_ids[:5]}\"\n    )\n\nprint(\"Requested unique test images:\", len(requested_ids))\nprint(\"Matched test image paths:\", len(test_image_map))\n","metadata":{"execution":{"iopub.execute_input":"2026-11-03T08:21:52.222019Z","iopub.status.busy":"2026-11-03T08:21:52.221581Z","iopub.status.idle":"2026-11-03T08:21:56.243272Z","shell.execute_reply":"2026-11-03T08:21:56.242419Z"},"papermill":{"duration":4.054743,"end_time":"2026-11-03T08:21:56.24486+00:00","exception":false,"start_time":"2026-11-03T08:21:52.190117+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 10. Final submission\n\nPredicts every test strip with the weighted 3-model ensemble + 4-way flip TTA, applies the per-class pixel threshold / strip gate / minimum area chosen on validation, and writes `submission.csv` in exactly the sample-submission format (all fields quoted, `ID,image_id,defect_type,mask_rle`, empty mask = a single space).","metadata":{"papermill":{"duration":0.029983,"end_time":"2026-11-03T08:21:56.307524+00:00","exception":false,"start_time":"2026-11-03T08:21:56.277541+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"import csv\n\n# ---- test dataset (reuses DefectDataset; masks are all empty placeholders) ----------------\nunique_test_ids = sample_submission[\"image_id\"].astype(str).drop_duplicates().tolist()\ntest_df = pd.DataFrame({\"image_id\": unique_test_ids})\ntest_df[\"image_path\"] = test_df[\"image_id\"].map(lambda x: test_image_map[Path(x).stem])\nfor cls in CLASSES:\n    test_df[cls] = \"\"\ntest_loader = DataLoader(DefectDataset(test_df, augment=False), batch_size=16, shuffle=False,\n                         num_workers=2, pin_memory=torch.cuda.is_available())\n\ndef apply_class_params(probs):\n    \"\"\"probs: [B, 4, H, W] numpy -> boolean masks after per-class threshold, gate and min-area.\"\"\"\n    out = np.zeros(probs.shape, dtype=bool)\n    for c, cls in enumerate(CLASSES):\n        q = class_params[cls]\n        m = probs[:, c] >= q[\"pixel_threshold\"]\n        keep = (probs[:, c].reshape(len(probs), -1).max(axis=1) >= q[\"gate\"]) & \\\n               (m.reshape(len(probs), -1).sum(axis=1) >= max(q[\"min_area\"], 1))\n        out[:, c] = m & keep[:, None, None]\n    return out\n\nmodel.eval(); model_fpn.eval(); model_unetpp.eval()\nprediction_cache, cursor = {}, 0\nwith torch.no_grad():\n    for images, _ in tqdm(test_loader, desc=\"Predicting test images\"):\n        images = images.to(DEVICE)\n        probs = (best_ensemble_weights[0] * predict_tta(model, images)\n                 + best_ensemble_weights[1] * predict_tta(model_fpn, images)\n                 + best_ensemble_weights[2] * predict_tta(model_unetpp, images)).cpu().numpy()\n        masks_bool = apply_class_params(probs)\n        for b in range(len(images)):\n            image_id = unique_test_ids[cursor]; cursor += 1\n            prediction_cache[image_id] = {\n                cls: encode_rle(masks_bool[b, ci]) for ci, cls in enumerate(CLASSES)\n            }\nassert cursor == len(unique_test_ids)\n\n# ---- build the file exactly like sample_submission.csv --------------------------------------\nsubmission = sample_submission.copy()\nsubmission[\"image_id\"] = submission[\"image_id\"].astype(str)\nsubmission[\"defect_type\"] = submission[\"defect_type\"].astype(str)\nsubmission[\"mask_rle\"] = [\n    prediction_cache[i][d].strip() or \" \"          # sample format: empty mask is a single space\n    for i, d in zip(submission[\"image_id\"], submission[\"defect_type\"])\n]\nsubmission = submission[[\"ID\", \"image_id\", \"defect_type\", \"mask_rle\"]]\n\nassert len(submission) == len(sample_submission) == 12000\nassert (submission[\"ID\"].values == sample_submission[\"ID\"].values).all()\nassert (submission[\"image_id\"].values == sample_submission[\"image_id\"].astype(str).values).all()\nassert (submission[\"defect_type\"].values == sample_submission[\"defect_type\"].values).all()\nassert submission[\"mask_rle\"].notna().all()\n\noutput_path = \"/kaggle/working/submission.csv\"\nsubmission.to_csv(output_path, index=False, quoting=csv.QUOTE_ALL)    # all fields quoted, like the sample\n\n# ---- sanity checks ----------------------------------------------------------------------\nwith open(output_path) as f:\n    print(\"First lines of the file:\"); [print(\"  \", next(f).rstrip()[:110]) for _ in range(5)]\nnon_empty = (submission[\"mask_rle\"].str.strip() != \"\")\nprint(\"\\nRows:\", len(submission), \"| unique images:\", submission[\"image_id\"].nunique())\nprint(\"Non-empty masks:\", int(non_empty.sum()), f\"({100 * non_empty.mean():.1f}% of rows)\")\nprint(submission.assign(has=non_empty).groupby(\"defect_type\")[\"has\"].mean().round(3).to_dict())\nprint(\"File size (MB):\", round(os.path.getsize(output_path) / (1024 ** 2), 2))\ndisplay(submission.head(8))","metadata":{"execution":{"iopub.execute_input":"2026-11-03T08:21:56.370993Z","iopub.status.busy":"2026-11-03T08:21:56.37047Z","iopub.status.idle":"2026-11-03T08:25:59.272422Z","shell.execute_reply":"2026-11-03T08:25:59.271248Z"},"papermill":{"duration":242.93736,"end_time":"2026-11-03T08:25:59.274447+00:00","exception":false,"start_time":"2026-11-03T08:21:56.337087+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 11. W&B tracking\n\nThe original W&B setup and credentials in cell 38 are unchanged. The final CV cell adds fold metrics and artifact logging to the same run.\n","metadata":{"papermill":{"duration":0.030071,"end_time":"2026-11-03T08:25:59.337933+00:00","exception":false,"start_time":"2026-11-03T08:25:59.307862+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"if wandb_run is not None:\n    wandb_run.log({\n        \"ensemble/best_validation_pixel_threshold\": best_ensemble_threshold,\n        \"ensemble/best_validation_strip_gate_threshold\": best_strip_gate_threshold,\n        \"ensemble/best_validation_mean_dice\": best_validation_mean_dice,\n        \"training/scratch_epochs_completed\": len(history),\n        \"training/fpn_epochs_completed\": len(history_fpn),\n        \"training/unetpp_epochs_completed\": len(history_unetpp),\n        \"ensemble/weight_scratch_unet\": best_ensemble_weights[0],\n        \"ensemble/weight_fpn_effb4\": best_ensemble_weights[1],\n        \"ensemble/weight_unetpp_effb3\": best_ensemble_weights[2],\n        \"submission/rows\": int(len(submission)),\n        \"submission/unique_images\": int(submission[\"image_id\"].nunique()),\n    })\n\n    for artifact_name, checkpoint in [\n        (\"scratch-unet-best\", \"/kaggle/working/unet_scratch_best.pth\"),\n        (\"fpn-effb4-best\", fpn_checkpoint),\n        (\"unetpp-effb3-best\", unetpp_checkpoint),\n    ]:\n        if os.path.exists(checkpoint):\n            artifact = wandb.Artifact(name=artifact_name, type=\"model_weights\")\n            artifact.add_file(checkpoint)\n            wandb_run.log_artifact(artifact)\n\n    submission_artifact = wandb.Artifact(\n        name=\"industrial-defect-submission\",\n        type=\"submission\",\n        metadata={\n            \"rows\": int(len(submission)),\n            \"unique_images\": int(submission[\"image_id\"].nunique()),\n            \"threshold\": best_ensemble_threshold,\n        },\n    )\n    submission_artifact.add_file(output_path)\n    wandb_run.log_artifact(submission_artifact)\n    wandb_run.finish()\n    print(\"W&B run finished; checkpoints and submission artifact logged.\")\nelse:\n    print(\"W&B was not active. The submission CSV is still saved in