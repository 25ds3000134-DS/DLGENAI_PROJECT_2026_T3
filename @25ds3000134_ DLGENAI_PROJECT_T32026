its = model(images)\n","        loss = combined_loss(logits, masks)\n","\n","        loss.backward()\n","        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n","        optimizer.step()\n","\n","        train_loss_sum += loss.item()\n","        progress.set_postfix(loss=f\"{loss.item():.4f}\")\n","\n","    train_loss = train_loss_sum / max(1, len(train_loader))\n","\n","    model.eval()\n","    val_loss_sum = 0.0\n","    val_dice_sum = 0.0\n","\n","    with torch.no_grad():\n","        for images, masks in tqdm(val_loader, desc=\"Scratch U-Net validation\"):\n","            images = images.to(DEVICE, non_blocking=True)\n","            masks = masks.to(DEVICE, non_blocking=True)\n","\n","            logits = model(images)\n","            val_loss_sum += combined_loss(logits, masks).item()\n","            val_dice_sum += batch_dice_score(logits, masks)\n","\n","    val_loss = val_loss_sum / max(1, len(val_loader))\n","    val_dice = val_dice_sum / max(1, len(val_loader))\n","\n","    history.append({\n","        \"epoch\": epoch + 1,\n","        \"train_loss\": train_loss,\n","        \"val_loss\": val_loss,\n","        \"val_dice\": val_dice\n","    })\n","\n","    if wandb_run is not None:\n","        wandb_run.log({\n","            \"model1/epoch\": epoch + 1,\n","            \"model1/train_loss\": train_loss,\n","            \"model1/val_loss\": val_loss,\n","            \"model1/val_dice\": val_dice,\n","            \"model1/learning_rate\": optimizer.param_groups[0][\"lr\"],\n","        })\n","\n","    print(\n","        f\"Scratch U-Net epoch {epoch + 1}: \"\n","        f\"train_loss={train_loss:.4f}, \"\n","        f\"val_loss={val_loss:.4f}, \"\n","        f\"val_dice={val_dice:.4f}\"\n","    )\n","\n","    if val_loss < best_val_loss - 1e-6:\n","        best_val_loss = val_loss\n","        scratch_wait = 0\n","        torch.save(model.state_dict(), \"/kaggle/working/unet_scratch_best.pth\")\n","        print(\"Best Scratch U-Net checkpoint saved.