.scale = int(scale)\n","        self.register_buffer(\"mean\", torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1))\n","        self.register_buffer(\"std\", torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1))\n","\n","    def forward(self, images):\n","        x = (images - self.mean) / self.std\n","        if self.scale > 1:\n","            x = F.interpolate(x, scale_factor=(self.scale, 1), mode=\"bilinear\", align_corners=False)\n","        out = self.network(x)\n","        if self.scale > 1:\n","            out = F.avg_pool2d(out, kernel_size=(self.scale, 1))\n","        return out\n","\n","model_fpn = PretrainedSegmentationModel(\n","    smp.FPN(encoder_name=\"efficientnet-b4\", encoder_weights=\"imagenet\",\n","            in_channels=3, classes=len(CLASSES), activation=None), scale=2\n",").to(DEVICE)\n","\n","model_unetpp = PretrainedSegmentationModel(\n","    smp.UnetPlusPlus(encoder_name=\"efficientnet-b3\", encoder_weights=\"imagenet\",\n","                     in_channels=3, classes=len(CLASSES), activation=None), scale=1\n",").to(DEVICE)\n","\n","model_unet_b4 = None\n","if RUN_THIRD_MODEL:\n","    try:\n","        model_unet_b4 = PretrainedSegmentationModel(\n","            smp.Unet(encoder_name=\"efficientnet-b4\", encoder_weights=\"imagenet\",\n","                     in_channels=3, classes=len(CLASSES), activation=None), scale=2\n","        ).to(DEVICE)\n","    except Exception as exc:\n","        print(\"Third model unavailable, continuing without it:\", str(exc)[:200])\n","        RUN_THIRD_MODEL = False\n","\n","print(\"FPN-B4 (x2), U-Net++-B3 (x1)\", \"and U-Net-B4 (x2)\" if RUN_THIRD_MODEL else \"(third model off)\", \"are ready.\")"]},{"cell_type":"markdown","id":"78aa2935","metadata":{"papermill":{"duration":0.057637,"end_time":"2026-11-05T08:34:31.92974+00:00","exception":false,"start_time":"2026-11-05T08:34:31.872103+00:00","status":"completed"},"tags":[]},"source":["## 7. Train / reuse FPN (x2) and U-Net++, train U-Net-B4 (x2), then warm-restart fine-tuning"]},{"cell_type":"code","execution_count":34,"id":"fb68f8e4","metadata":{"execution":{"iopub.execute_input":"2026-11-05T08:34:32.048565Z","iopub.status.busy":"2026-11-05T08:34:32.048062Z","iopub.status.idle":"2026-11-05T10:00:48.533532Z","shell.execute_reply":"2026-11-05T10:00:48.532686Z"},"papermill":{"duration":5176.579759,"end_time":"2026-11-05T10:00:48.566851+00:00","exception":false,"start_time":"2026-11-05T08:34:31.987092+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"ef8f26269c154cd3b52b493424f3f71f","version_major":2,"version_minor":0},"text/plain":["fpn_effb4_x2 1/20:   0%|          | 0/793 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["fpn_effb4_x2 | epoch 1: train=0.8909, val=0.6395, official-proxy=0.5757, fgDice=0.4671\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"25dce1a742e94cd180d6b202d48e437d","version_major":2,"version_minor":0},"text/plain":["fpn_effb4_x2 2/20:   0%|          | 0/793 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["fpn_effb4_x2 | epoch 2: train=0.5836, val=0.4274, official-proxy=0.6483, fgDice=0.5173\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"04d930b280cc49a69b6d2e9b4e9678ed","version_major":2,"version_minor":0},"text/plain":["fpn_effb4_x2 3/20:   0%|          | 0/793 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["fpn_effb4_x2 | epoch 3: train=0.5137, val=0.3944, official-proxy=0.6466, fgDice=0.5026\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"8f86b4e411db484ebae9f61c4924904a","version_major":2,"version_minor":0},"text/plain":["fpn_effb4_x2 4/20:   0%|          | 0/793 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text"