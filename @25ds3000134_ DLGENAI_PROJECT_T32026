metadata":{},"output_type":"display_data"}],"source":["from sklearn.model_selection import train_test_split\n","\n","# Stratify on the label COMBINATION so rare classes (defect_b) appear in both splits\n","image_data[\"combination\"] = image_data[label_cols].apply(\n","    lambda r: \"+\".join(c.replace(\"_present\", \"\") for c in label_cols if r[c]) or \"clean\", axis=1\n",")\n","train_df, val_df = train_test_split(\n","    image_data, test_size=0.2, random_state=42, shuffle=True,\n","    stratify=image_data[\"combination\"]\n",")\n","\n","# Train on ALL defect-positive strips + a sample of clean strips.\n","# (Clean strips teach the model what \"no defect\" looks like -> far fewer false positives.)\n","is_pos = train_df[label_cols].sum(axis=1) > 0\n","pos_df = train_df.loc[is_pos]\n","clean_df = train_df.loc[~is_pos].sample(n=min(int(0.35 * len(pos_df)), int((~is_pos).sum())), random_state=42)\n","train_df = pd.concat([pos_df, clean_df]).sample(frac=1, random_state=42).reset_index(drop=True)\n","\n","# Validation keeps EVERY strip (clean + defective) so it mirrors the test distribution\n","val_df = val_df.reset_index(drop=True)\n","\n","print(\"Training images:\", len(train_df), f\"(positives {len(pos_df)}, clean {len(clean_df)})\")\n","print(\"Validation images:\", len(val_df))\n","print(\"\\nDefect-positive images in validation:\")\n","display(val_df[label_cols].sum().rename(index=lambda x: x.replace(\"_present\", \"\")))"]},{"cell_type":"markdown","id":"c7eef7a5","metadata":{"papermill":{"duration":0.055291,"end_time":"2026-11-09T03:59:01.192983+00:00","exception":false,"start_time":"2026-11-09T03:59:01.137692+00:00","status":"completed"},"tags":[]},"source":["# Define image and mask loading"]},{"cell_type":"code","execution_count":15,"id":"bf493d42","metadata":{"execution":{"iopub.execute_input":"2026-11-09T03:59:01.29968Z","iopub.status.busy":"2026-11-09T03:59:01.299299Z","iopub.status.idle":"2026-11-09T03:59:08.985734Z","shell.execute_reply":"2026-11-09T03: