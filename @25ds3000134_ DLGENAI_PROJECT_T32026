_b         \n","2   3  WAFNKCRR7Q    defect_c         \n","3   4  WAFNKCRR7Q    defect_d         \n","4   5  YZXKEWSUDD    defect_a         \n","5   6  YZXKEWSUDD    defect_b         \n","6   7  YZXKEWSUDD    defect_c         \n","7   8  YZXKEWSUDD    defect_d         "]},"metadata":{},"output_type":"display_data"}],"source":["import csv\n","\n","# ---- test dataset (reuses DefectDataset; masks are all empty placeholders) ----------------\n","unique_test_ids = sample_submission[\"image_id\"].astype(str).drop_duplicates().tolist()\n","test_df = pd.DataFrame({\"image_id\": unique_test_ids})\n","test_df[\"image_path\"] = test_df[\"image_id\"].map(lambda x: test_image_map[Path(x).stem])\n","for cls in CLASSES:\n","    test_df[cls] = \"\"\n","test_loader = DataLoader(DefectDataset(test_df, augment=False), batch_size=16, shuffle=False,\n","                         num_workers=2, pin_memory=torch.cuda.is_available())\n","\n","def apply_class_params(probs):\n","    \"\"\"probs: [B, 4, H, W] numpy -> boolean masks after per-class threshold, gate and min-area.\"\"\"\n","    out = np.zeros(probs.shape, dtype=bool)\n","    for c, cls in enumerate(CLASSES):\n","        q = class_params[cls]\n","        m = probs[:, c] >= q[\"pixel_threshold\"]\n","        keep = (probs[:, c].reshape(len(probs), -1).max(axis=1) >= q[\"gate\"]) & \\\n","               (m.reshape(len(probs), -1).sum(axis=1) >= max(q[\"min_area\"], 1))\n","        out[:, c] = m & keep[:, None, None]\n","    return out\n","\n","for m_ in ensemble_models.values():\n","    m_.eval()\n","prediction_cache, cursor = {}, 0\n","with torch.no_grad():\n","    for images, _ in tqdm(test_loader, desc=\"Predicting test images\"):\n","        images = images.to(DEVICE)\n","        probs = sum(w * predict_tta(ensemble_models[n], images)\n","                    for n, w in best_ensemble_weights.items()).cpu().numpy()\n","        masks_bool = apply_class_params(probs)\n","        for b in range(len(images)):\n","            image_id = unique_test_ids[cursor]; cursor += 1\n","            prediction_cache[image_id] = {\n","                cls: encode_rle(masks_bool[b, ci]) for ci, cls in enumerate(CLASSES)\n","            }\n","assert cursor == len(unique_test_ids)\n","\n","# ---- build the file exactly like sample_submission.csv --------------------------------------\n","submission = sample_submission.copy()\n","submission[\"image_id\"] = submission[\"image_id\"].astype(str)\n","submission[\"defect_type\"] = submission[\"defect_type\"].astype(str)\n","submission[\"mask_rle\"] = [\n","    prediction_cache[i][d].strip() or \" \"          # sample format: empty mask is a single space\n","    for i, d in zip(submission[\"image_id\"], submission[\"defect_type\"])\n","]\n","submission = submission[[\"ID\", \"image_id\", \"defect_type\", \"mask_rle\"]]\n","\n","assert len(submission) == len(sample_submission) == 12000\n","assert (submission[\"ID\"].values == sample_submission[\"ID\"].values).all()\n","assert (submission[\"image_id\"].values == sample_submission[\"image_id\"].astype(str).values).all()\n","assert (submission[\"defect_type\"].values == sample_submission[\"defect_type\"].values).all()\n","assert submission[\"mask_rle\"].notna().all()\n","\n","output_path = \"/kaggle/working/submission.csv\"\n","submission.to_csv(output_path, index=False, quoting=csv.QUOTE_ALL)    # all fields quoted, like the sample\n","\n","# ---- sanity checks ----------------------------------------------------------------------\n","with open(output_path) as f:\n","    print(\"First lines of the file:\"); [print(\"  \", next(f).rstrip()[:110]) for _ in range(5)]\n","non_empty = (submission[\"mask_rle\"].str.strip() != \"\")\n","print(\"\\nRows:\", len(submission), \"| unique images:\", submission[\"image_id\"].nunique())\n","print(\"Non-empty masks:\", int(non_empty.sum()), f\"({100 * non_empty.mean():.1f}% of rows)\")\n","print(submission.assign(has=non_empty).groupby(\"defect_type\")[\"has\"].mean().round(3).to_dict(