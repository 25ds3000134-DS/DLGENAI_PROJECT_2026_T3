 []\n\nfor epoch in range(0 if skip_scratch else EPOCHS):\n    model.train()\n    train_loss_sum = 0.0\n\n    progress = tqdm(train_loader, desc=f\"Scratch U-Net epoch {epoch + 1}/{EPOCHS}\")\n\n    for images, masks in progress:\n        images = images.to(DEVICE, non_blocking=True)\n        masks = masks.to(DEVICE, non_blocking=True)\n\n        optimizer.zero_grad(set_to_none=True)\n        logits = model(images)\n        loss = combined_loss(logits, masks)\n\n        loss.backward()\n        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n        optimizer.step()\n\n        train_loss_sum += loss.item()\n        progress.set_postfix(loss=f\"{loss.item():.4f}\")\n\n    train_loss = train_loss_sum / max(1, len(train_loader))\n\n    model.eval()\n    val_loss_sum = 0.0\n    val_dice_sum = 0.0\n\n    with torch.no_grad():\n        for images, masks in tqdm(val_loader, desc=\"Scratch U-Net validation\"):\n            images = images.to(DEVICE, non_blocking=True)\n            masks = masks.to(DEVICE, non_blocking=True)\n\n            logits = model(images)\n            val_loss_sum += combined_loss(logits, masks).item()\n            val_dice_sum += batch_dice_score(logits, masks)\n\n    val_loss = val_loss_sum / max(1, len(val_loader))\n    val_dice = val_dice_sum / max(1, len(val_loader))\n\n    history.append({\n        \"epoch\": epoch + 1,\n        \"train_loss\": train_loss,\n        \"val_loss\": val_loss,\n        \"val_dice\": val_dice\n    })\n\n    if wandb_run is not None:\n        wandb_run.log({\n            \"model1/epoch\": epoch + 1,\n            \"model1/train_loss\": train_loss,\n            \"model1/val_loss\": val_loss,\n            \"model1/val_dice\": val_dice,\n            \"model1/learning_rate\": optimizer.param_groups[0][\"lr\"],\n        })\n\n    print(\n        f\"Scratch U-Net epoch {epoch + 1}: \"\n        f\"train_loss={train_loss:.4f}, \"\n        f\"val_loss={val_loss:.4f}, \"\n        f\"val_dice={val_dice:.4f}\"\n    )\n\n    if val_loss < best_val_loss - 1e-6:\n        best_val_loss = val_loss\n        scratch_wait = 0\n        torch.save(model.state_dict(), \"/kaggle/working/unet_scratch_best.pth\")\n        print(\"Best Scratch U-Net checkpoint saved.\")\n    else:\n        scratch_wait += 1\n        print(f\"No validation-loss improvement ({scratch_wait}/{SCRATCH_PATIENCE}).\")\n        if scratch_wait >= SCRATCH_PATIENCE:\n            print(\"Early stopping Scratch U-Net.\")\n            break\n\n# Always continue with the best validation checkpoint, not the final epoch.\nmodel.load_state_dict(\n    torch.load(\"/kaggle/working/unet_scratch_best.pth\", map_location=DEVICE, weights_only=True)\n)\nmodel.eval()\nprint(\"Scratch U-Net best checkpoint restored.\")","metadata":{"execution":{"iopub.execute_input":"2026-11-05T07:27:21.998275Z","iopub.status.busy":"2026-11-05T07:27:21.997607Z","iopub.status.idle":"2026-11-05T08:30:45.428124Z","shell.execute_reply":"2026-11-05T08:30:45.426991Z"},"papermill":{"duration":3803.494395,"end_time":"2026-11-05T08:30:45.430219+00:00","exception":false,"start_time":"2026-11-05T07:27:21.935824+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Plot training progress","metadata":{"papermill":{"duration":0.057898,"end_time":"2026-11-05T08:30:45.546788+00:00","exception":false,"start_time":"2026-11-05T08:30:45.48889+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"history_df = pd.DataFrame(history)\nif history_df.empty:\n    print(\"No scratch history (checkpoint reused) - skipping plot.\")\nelse:\n    fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n\n    axes[0].plot(history_df[\"epoch\"], history_df[\"train_loss\"], label=\"Train\")\n    axes[0].plot(history_df[\"epoch\"], history_df[\"val_loss\"], label=\"Validation\")\n    axes[0].set_title(\"Training and Validation Loss\")\n    axes[0].set_xlabel(\"Epoch\")\n    axes[0].legend()\n\n    axes[1].plot(history_df[\"epo