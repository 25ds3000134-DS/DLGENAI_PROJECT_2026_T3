l_name":"LayoutModel","_view_count":null,"_view_module":"@jupyter-widgets/base","_view_module_version":"2.0.0","_view_name":"LayoutView","align_content":null,"align_items":null,"align_self":null,"border_bottom":null,"border_left":null,"border_right":null,"border_top":null,"bottom":null,"display":null,"flex":null,"flex_flow":null,"grid_area":null,"grid_auto_columns":null,"grid_auto_flow":null,"grid_auto_rows":null,"grid_column":null,"grid_gap":null,"grid_row":null,"grid_template_areas":null,"grid_template_columns":null,"grid_template_rows":null,"height":null,"justify_content":null,"justify_items":null,"left":null,"margin":null,"max_height":null,"max_width":null,"min_height":null,"min_width":null,"object_fit":null,"object_position":null,"order":null,"overflow":null,"padding":null,"right":null,"top":null,"visibility":null,"width":null}}},"version_major":2,"version_minor":0}}},"nbformat_minor":5,"nbformat":4,"cells":[{"id":"c870c4c4","cell_type":"markdown","source":"# SurfaceGuard AI — CPU-only segmentation experiments (three models)\n","metadata":{}},{"id":"4113a288","cell_type":"code","source":"import os\nimport glob\nimport random\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport cv2\n\nrandom.seed(42)\nnp.random.seed(42)\n\nprint(\"Libraries loaded successfully\")","metadata":{},"outputs":[],"execution_count":null},{"id":"abac6996","cell_type":"code","source":"%pip -q install segmentation-models-pytorch","metadata":{},"outputs":[],"execution_count":null},{"id":"4ae01e6f","cell_type":"markdown","source":"# Load the competition data","metadata":{}},{"id":"0571a5d4","cell_type":"code","source":"train_files = glob.glob(\"/kaggle/input/competitions/industrial-surface-defect-detection/public/train.csv\", recursive=True)\nsub_files = glob.glob(\n    \"/kaggle/input/competitions/industrial-surface-defect-detection/public/sample_submission.csv\",\n    recursive=True\n)\n\nif not train_files or not sub_files:\n    raise FileNotFoundError(\"Check the Kaggle dataset input files.\")\n\ntrain_path = train_files[0]\nsub_path = sub_files[0]\n\ntrain = pd.read_csv(train_path)\nsample_submission = pd.read_csv(sub_path)\n\nprint(\"Training annotations:\", train.shape)\nprint(\"Sample submission:\", sample_submission.shape)\n\ndisplay(train.head())\ndisplay(sample_submission.head())","metadata":{},"outputs":[],"execution_count":null},{"id":"2acb64ae","cell_type":"markdown","source":"# Understand the dataset","metadata":{}},{"id":"b818c7cb","cell_type":"code","source":"print(\"Training data information:\")\ntrain.info()\n\nprint(\"\\nMissing values:\")\nprint(train.isnull().sum())\n\nprint(\"\\nDuplicate rows:\", train.duplicated().sum())\n\nprint(\"\\nDefect classes:\")\nprint(train[\"defect_type\"].value_counts())","metadata":{},"outputs":[],"execution_count":null},{"id":"15469669","cell_type":"markdown","source":"# Check how common each defect is","metadata":{}},{"id":"46b07add","cell_type":"code","source":"train[\"mask_rle\"] = train[\"mask_rle\"].fillna(\"\").astype(str).str.strip()\ntrain[\"has_defect\"] = train[\"mask_rle\"] != \"\"\n\nclass_counts = train.groupby(\"defect_type\")[\"has_defect\"].sum()\n\nclass_counts.plot(kind=\"bar\", figsize=(7, 4))\nplt.title(\"Number of Images Containing Each Defect\")\nplt.xlabel(\"Defect class\")\nplt.ylabel(\"Positive annotations\")\nplt.xticks(rotation=0)\nplt.show()\n\nprint(class_counts)","metadata":{},"outputs":[],"execution_count":null},{"id":"6a66098c","cell_type":"markdown","source":"# 5. Check clean images and images with multiple defects","metadata":{}},{"id":"15a7b2e4","cell_type":"code","source":"image_labels = train.groupby(\"image_id\")[\"has_defect\"].sum()\n\nclean_images = (image_labels == 0).sum()\nsingle_defect = (image_labels == 1).sum()\nmultiple_defects = (image_labels > 1).sum()\n\nprint(\"Total unique images:\", train[\"image_id\"].nunique())\nprint(\"Clean images:\", clean_images)\nprint(\"Images with one defect class:\", single_defect)\nprint(\"Images with multiple defect classes:\", multiple_defects)","metadata":{},"outputs":[],"execution_count":null},{"id":"d38708ce","cell_type":"markdown","source":"# Display a few training images","metadata":{}},{"id":"76dcf23f","cell_type":"code","source":"image_files = glob.glob(\n    \"/kaggle/input/**/*\", recursive=True\n)\n\nimage_files = [\n    p for p in image_files\n    if p.lower().endswith((\".png\", \".jpg\", \".jpeg\", \".bmp\"))\n]\n\nimage_map = {Path(p).stem: p for p in image_files}\n\nprint(\"Images found:\", len(image_map))\n\nsample_ids = train[\"image_id\"].drop_duplicates().sample(\n    min(6, train[\"image_id\"].nunique()), random_state=42\n)\n\nfig, axes = plt.subplots(2, 3, figsize=(15, 6))\n\nfor ax, image_id in zip(axes.flat, sample_ids):\n    path = image_map.get(Path(str(image_id)).stem)\n\n    if path:\n        image = cv2.imread(path)\n        image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n        ax.imshow(image)\n        ax.set_title(str(image_id))\n    else:\n        ax.set_title(\"Image not found\")\n\n    ax.axis(\"off\")\n\nplt.tight_layout()\nplt.show()","metadata":{},"outputs":[],"execution_count":null},{"id":"53ba9b37","cell_type":"markdown","source":"# 7. Look at the defect size distribution","metadata":{}},{"id":"0232d501","cell_type":"code","source":"def mask_area(rle):\n    if not rle:\n        return 0\n\n    values = np.asarray(rle.split(), dtype=int)\n    return int(values[1::2].sum())\n\ntrain[\"defect_pixels\"] = train[\"mask_rle\"].apply(mask_area)\n\npositive = train[train[\"defect_pixels\"] > 0]\n\nplt.figure(figsize=(8, 4))\nsns.histplot(\n    data=positive,\n    x=\"defect_pixels\",\n    hue=\"defect_type\",\n    bins=40,\n    element=\"step\"\n)\nplt.title(\"Distribution of Defect Areas\")\nplt.xlabel(\"Number of defect pixels\")\nplt.tight_layout()\nplt.show()\n\ndisplay(\n    positive.groupby(\"defect_type\")[\"defect_pixels\"]\n    .describe()\n    .round(1)\n)","metadata":{},"outputs":[],"execution_count":null},{"id":"9672d378","cell_type":"markdown","source":"# Decode the defect masks","metadata":{}},{"id":"400e2f3f","cell_type":"code","source":"def decode_rle(rle, height=128, width=800):\n    mask = np.zeros(height * width, dtype=np.uint8)\n\n    if not isinstance(rle, str) or not rle.strip():\n        return mask.reshape(width, height).T\n\n    values = np.asarray(rle.split(), dtype=int)\n    starts = values[0::2] - 1\n    lengths = values[1::2]\n\n    for start, length in zip(starts, lengths):\n        mask[start:start + length] = 1\n\n    return mask.reshape(width, height).T\n\n\nprint(\"Mask shape:\", decode_rle(train.loc[0, \"mask_rle\"]).shape)\nprint(\"Defect pixels:\", decode_rle(train.loc[0, \"mask_rle\"]).sum())","metadata":{},"outputs":[],"execution_count":null},{"id":"77172c0f","cell_type":"markdown","source":"# View a defect mask on the original image","metadata":{}},{"id":"d951dde5","cell_type":"code","source":"sample = train[train[\"mask_rle\"] != \"\"].sample(1, random_state=42).iloc[0]\n\nimage_path = image_map.get(Path(str(sample[\"image_id\"])).stem)\n\nif image_path is None:\n    print(\"Image not found:\", sample[\"image_id\"])\nelse:\n    image = cv2.imread(image_path)\n    image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n    mask = decode_rle(sample[\"mask_rle\"])\n\n    plt.figure(figsize=(14, 4))\n\n    plt.subplot(1, 3, 1)\n    plt.imshow(image)\n    plt.title(\"Original image\")\n    plt.axis(\"off\")\n\n    plt.subplot(1, 3, 2)\n    plt.imshow(mask, cmap=\"gray\")\n    plt.title(sample[\"defect_type\"] + \" mask\")\n    plt.axis(\"off\")\n\n    plt.subplot(1, 3, 3)\n    plt.imshow(image)\n    plt.imshow(mask, cmap=\"Reds\", alpha=0.5)\n    plt.title(\"Mask overlay\")\n    plt.axis(\"off\")\n\n    plt.tight_layout()\n    plt.show()","metadata":{},"outputs":[],"execution_count":null},{"id":"96678695","cell_type":"markdown","source":"# 10. Compare examples from all four defect classes","metadata":{}},{"id":"5d591e6b","cell_type":"code","source":"defects = [\"defect_a\", \"defect_b\", \"defect_c\", \"defect_d\"]\n\nfig, axes = plt.subplots(4, 2, figsize=(14, 10))\n\nfor i, defect in enumerate(defects):\n    rows = train[\n        (train[\"defect_type\"] == defect) &\n        (train[\"mask_rle\"] != \"\")\n    ]\n\n    row = rows.sample(1, random_state=42).iloc[0]\n    path = image_map.get(Path(str(row[\"image_id\"])).stem)\n\n    if path is None:\n        axes[i, 0].set_title(defect + \" image not found\")\n        axes[i, 1].axis(\"off\")\n        continue\n\n    image = cv2.cvtColor(cv2.imread(path), cv2.COLOR_BGR2RGB)\n    mask = decode_rle(row[\"mask_rle\"])\n\n    axes[i, 0].imshow(image)\n    axes[i, 0].set_title(defect + \" — original\")\n    axes[i, 1].imshow(image)\n    axes[i, 1].imshow(mask, cmap=\"Reds\", alpha=0.5)\n    axes[i, 1].set_title(defect + \" — mask overlay\")\n\n    axes[i, 0].axis(\"off\")\n    axes[i, 1].axis(\"off\")\n\nplt.tight_layout()\nplt.show()","metadata":{},"outputs":[],"execution_count":null},{"id":"a8998500","cell_type":"markdown","source":"# 11. Prepare image-level annotations","metadata":{}},{"id":"fc968741","cell_type":"code","source":"CLASSES = [\"defect_a\", \"defect_b\", \"defect_c\", \"defect_d\"]\n\ntrain[\"image_id\"] = train[\"image_id\"].astype(str)\ntrain[\"defect_type\"] = train[\"defect_type\"].astype(str)\ntrain[\"mask_rle\"] = train[\"mask_rle\"].fillna(\"\").astype(str)\n\n# One row per image, with one target column per defect class\nimage_data = train.pivot(\n    index=\"image_id\",\n    columns=\"defect_type\",\n    values=\"mask_rle\"\n).reset_index()\n\nfor cls in CLASSES:\n    if cls not in image_data.columns:\n        image_data[cls] = \"\"\n\nimage_data = image_data[[\"image_id\"] + CLASSES].fillna(\"\")\n\n# Keep only images whose files were found\nimage_data[\"image_path\"] = image_data[\"image_id\"].map(\n    lambda x: image_map.get(Path(x).stem)\n)\nimage_data = image_data.dropna(subset=[\"image_path\"]).reset_index(drop=True)\n\nprint(\"Usable training images:\", len(image_data))\ndisplay(image_data.head())","metadata":{},"outputs":[],"execution_count":null},{"id":"78929274","cell_type":"markdown","source":"# Create image-level defect labels","metadata":{}},{"id":"0aa07070","cell_type":"code","source":"for cls in CLASSES:\n    image_data[cls + \"_present\"] = (\n        image_data[cls].str.strip() != \"\"\n    ).astype(np.uint8)\n\nlabel_cols = [cls + \"_present\" for cls in CLASSES]\n\nprint(\"Images with each defect:\")\ndisplay(image_data[label_cols].sum().rename(index=lambda x: x.replace(\"_present\", \"\")))\n\nprint(\"\\nImages containing at least one defect:\",\n      (image_data[label_cols].sum(axis=1) > 0).sum())","metadata":{},"outputs":[],"execution_count":null},{"id":"d2974810","cell_type":"markdown","source":"# 13. Split training and validation images","metadata":{}},{"id":"43fd7e86","cell_type":"code","source":"from sklearn.model_selection import train_test_split\n\n# Stratify on the label COMBINATION so rare classes (defect_b) appear in both splits\nimage_data[\"combination\"] = image_data[label_cols].apply(\n    lambda r: \"+\".join(c.replace(\"_present\", \"\") for c in label_cols if r[c]) or \"clean\", axis=1\n)\ntrain_df, val_df = train_test_split(\n    image_data, test_size=0.2, random_state=42, shuffle=True,\n    stratify=image_data[\"combination\"]\n)\n\n# Train on ALL defect-positive strips + a sample of clean strips.\n# (Clean strips teach the model what \"no defect\" looks like -> far fewer false positives.)\nis_pos = train_df[label_cols].sum(axis=1) > 0\npos_df = train_df.loc[is_pos]\nclean_df = train_df.loc[~is_pos].sample(n=min(int(0.50 * len(pos_df)), int((~is_pos).sum())), random_state=42)\ntrain_df = pd.concat([pos_df, clean_df]).sample(frac=1, random_state=42).reset_index(drop=True)\n\n# Validation keeps EVERY strip (clean + defective) so it mirrors the test distribution\nval_df = val_df.reset_index(drop=True)\n\nprint(\"Training images:\", len(train_df), f\"(positives {len(pos_df)}, clean {len(clean_df)})\")\nprint(\"Validation images:\", len(val_df))\nprint(\"\\nDefect-positive images in validation:\")\ndisplay(val_df[label_cols].sum().rename(index=lambda x: x.replace(\"_present\", \"\")))","metadata":{},"outputs":[],"execution_count":null},{"id":"c7eef7a5","cell_type":"markdown","source":"# Define image and mask loading","metadata":{}},{"id":"bf493d42","cell_type":"code","source":"import torch\nfrom torch.utils.data import Dataset, DataLoader\n\nDEVICE = torch.device(\"cpu\")  # Explicit CPU-only execution; CUDA is never selected.\nprint(\"Using device:\", DEVICE)\n\nHEIGHT, WIDTH = 128, 800\n\nclass DefectDataset(Dataset):\n    \"\"\"Returns (RGB image in 0-1, 4 binary masks). augment=True -> flips + brightness/contrast.\"\"\"\n    def __init__(self, dataframe, augment=False):\n        df = dataframe.reset_index(drop=True)\n        self.paths = df[\"image_path\"].tolist()\n        self.rles = df[CLASSES].values.tolist()\n        self.augment = augment\n\n    def __len__(self):\n        return len(self.paths)\n\n    def __getitem__(self, idx):\n        image = cv2.imread(self.paths[idx])\n        if image is None:\n            raise FileNotFoundError(self.paths[idx])\n        image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n        image = cv2.resize(image, (WIDTH, HEIGHT)).astype(np.float32) / 255.0\n\n        masks = np.stack([decode_rle(r, HEIGHT, WIDTH) for r in self.rles[idx]], axis=0).astype(np.float32)\n\n        if self.augment:\n            if random.random() < 0.5:                      # horizontal flip\n                image, masks = image[:, ::-1], masks[:, :, ::-1]\n            if random.random() < 0.5:                      # vertical flip\n                image, masks = image[::-1], masks[:, ::-1]\n            if random.random() < 0.5:                      # brightness / contrast\n                image = np.clip(image * random.uniform(0.8, 1.2) + random.uniform(-0.08, 0.08), 0, 1)\n\n        image = torch.from_numpy(np.ascontiguousarray(image.transpose(2, 0, 1)))\n        masks = torch.from_numpy(np.ascontiguousarray(masks))\n        return image, masks","metadata":{},"outputs":[],"execution_count":null},{"id":"c3342614","cell_type":"markdown","source":"# 15. Create DataLoaders","metadata":{}},{"id":"93535de9","cell_type":"code","source":"from torch.utils.data import WeightedRandomSampler\n\nBATCH_SIZE = 4  # Smaller batches reduce CPU RAM pressure.\n\ntrain_dataset = DefectDataset(train_df, augment=True)\nval_dataset = DefectDataset(val_df, augment=False)\n\n# Oversample strips containing the rare classes (defect_a, defect_b). Each class counts equally\n# in the foreground-Dice part of the metric per positive strip, so rare ones must be seen more often.\nsample_weights = (1.0\n                  + 1.5 * train_df[\"defect_a_present\"].values\n                  + 3.0 * train_df[\"defect_b_present\"].values\n                  + 0.5 * train_df[\"defect_d_present\"].values)\ntrain_sampler = WeightedRandomSampler(\n    torch.as_tensor(sample_weights, dtype=torch.double), num_samples=len(train_df), replacement=True\n)\n\ntrain_loader = DataLoader(\n    train_dataset, batch_size=BATCH_SIZE, sampler=train_sampler, drop_last=True,\n    num_workers=0, pin_memory=False\n)\nval_loader = DataLoader(\n    val_dataset, batch_size=BATCH_SIZE * 2, shuffle=False,\n    num_workers=0, pin_memory=False\n)\n\nprint(\"Training batches:\", len(train_loader))\nprint(\"Validation batches:\", len(val_loader))","metadata":{},"outputs":[],"execution_count":null},{"id":"cd8d6aaa","cell_type":"markdown","source":"# Verify one batch before training","metadata":{}},{"id":"d0fca910","cell_type":"code","source":"images, masks = next(iter(train_loader))\n\nprint(\"Image batch:\", images.shape)\nprint(\"Mask batch:\", masks.shape)\nprint(\"Image range:\", images.min().item(), images.max().item())\nprint(\"Mask values:\", torch.unique(masks))","metadata":{},"outputs":[],"execution_count":null},{"id":"dcc67932","cell_type":"markdown","source":"# 17. The U-Net model from Scratch","metadata":{}},{"id":"08d4d7c3","cell_type":"code","source":"import torch.nn as nn\nimport torch.nn.functional as F\n\nclass ConvBlock(nn.Module):\n    \"\"\"Two-convolution block used by the scratch encoder-decoder.\"\"\"\n    def __init__(self, in_ch, out_ch):\n        super().__init__()\n        self.block = nn.Sequential(\n            nn.Conv2d(in_ch, out_ch, 3, padding=1, bias=False),\n            nn.BatchNorm2d(out_ch),\n            nn.ReLU(inplace=True),\n            nn.Conv2d(out_ch, out_ch, 3, padding=1, bias=False),\n            nn.BatchNorm2d(out_ch),\n            nn.ReLU(inplace=True)\n        )\n\n    def forward(self, x):\n        return self.block(x)\n\n\nclass UNetScratch(nn.Module):\n    \"\"\"Compact U-Net implemented from scratch (no pretrained weights).\"\"\"\n    def __init__(self, out_channels=4, base=16):\n        super().__init__()\n        self.pool = nn.MaxPool2d(2)\n        self.enc1 = ConvBlock(3, base)\n        self.enc2 = ConvBlock(base, base * 2)\n        self.enc3 = ConvBlock(base * 2, base * 4)\n        self.enc4 = ConvBlock(base * 4, base * 8)\n        self.mid = ConvBlock(base * 8, base * 16)\n        self.up4 = nn.ConvTranspose2d(base * 16, base * 8, 2, stride=2)\n        self.dec4 = ConvBlock(base * 16, base * 8)\n        self.up3 = nn.ConvTranspose2d(base * 8, base * 4, 2, stride=2)\n        self.dec3 = ConvBlock(base * 8, base * 4)\n        self.up2 = nn.ConvTranspose2d(base * 4, base * 2, 2, stride=2)\n        self.dec2 = ConvBlock(base * 4, base * 2)\n        self.up1 = nn.ConvTranspose2d(base * 2, base, 2, stride=2)\n        self.dec1 = ConvBlock(base * 2, base)\n        self.head = nn.Conv2d(base, out_channels, 1)\n\n    def forward(self, x):\n        e1 = self.enc1(x)\n        e2 = self.enc2(self.pool(e1))\n        e3 = self.enc3(self.pool(e2))\n        e4 = self.enc4(self.pool(e3))\n        z = self.mid(self.pool(e4))\n        z = self.dec4(torch.cat([self.up4(z), e4], dim=1))\n        z = self.dec3(torch.cat([self.up3(z), e3], dim=1))\n        z = self.dec2(torch.cat([self.up2(z), e2], dim=1))\n        z = self.dec1(torch.cat([self.up1(z), e1], dim=1))\n        return self.head(z)\n\nmodel = UNetScratch().to(DEVICE)\nprint(\"Scratch U-Net parameters:\", f\"{sum(p.numel() for p in model.parameters()):,}\")\n","metadata":{},"outputs":[],"execution_count":null},{"id":"c93348e3","cell_type":"markdown","source":"# 18. Define the combined loss and Dice metric","metadata":{}},{"id":"210ed5bf","cell_type":"code","source":"def metric_aligned_loss(logits, targets, pos_weight=None, eps=1.0):\n    \"\"\"\n    BCE + soft-Dice. Dice is computed on every (strip, class) mask:\n      * positive masks  -> reward overlap            (70% foreground-Dice part of the metric)\n      * empty masks     -> soft-Dice = 1 - 1/(sum(p)+1), which punishes ANY predicted mass\n                           (the 20% false-positive + 10% empty-accuracy parts)\n    Independent sigmoid per class (multi-label), never softmax.\n    \"\"\"\n    logits = logits.float()\n    targets = targets.float()\n    probs = torch.sigmoid(logits)\n\n    p = probs.flatten(2)\n    t = targets.flatten(2)\n    dice_loss_map = 1.0 - (2.0 * (p * t).sum(2) + eps) / (p.sum(2) + t.sum(2) + eps)   # [B, 4]\n    positive = t.sum(2) > 0\n\n    fg = dice_loss_map[positive].mean() if positive.any() else probs.mean() * 0.0\n    empty = dice_loss_map[~positive].mean() if (~positive).any() else probs.mean() * 0.0\n\n    if pos_weight is None:\n        bce = F.binary_cross_entropy_with_logits(logits, targets)\n    else:\n        bce = F.binary_cross_entropy_with_logits(logits, targets, pos_weight=pos_weight.view(1, -1, 1, 1))\n\n    return bce + 0.7 * fg + 0.3 * empty\n\n\ndef dice_loss(logits, targets, smooth=1.0):\n    probs = torch.sigmoid(logits).flatten(2)\n    targets = targets.flatten(2)\n    dice = (2 * (probs * targets).sum(2) + smooth) / (probs.sum(2) + targets.sum(2) + smooth)\n    return 1 - dice.mean()\n\n\nbce_loss = nn.BCEWithLogitsLoss()\n\ndef combined_loss(logits, targets):\n    return metric_aligned_loss(logits, targets)\n\n\n@torch.no_grad()\ndef batch_dice_score(logits, targets, threshold=0.5, smooth=1.0):\n    preds = (torch.sigmoid(logits.float()) >= threshold).float().flatten(2)\n    targets = targets.flatten(2)\n    inter = (preds * targets).sum(2)\n    den = preds.sum(2) + targets.sum(2)\n    return ((2 * inter + smooth) / (den + smooth)).mean().item()\n\n\nprint(\"Independent-sigmoid outputs and BCE + Dice (positive/empty weighted) loss ready.\")","metadata":{},"outputs":[],"execution_count":null},{"id":"f70d96e4","cell_type":"markdown","source":"## Training and validation experiments\n","metadata":{}},{"id":"a1b663bb","cell_type":"markdown","source":"## 19. CPU-only training plan and experiment tracking\n\nThis notebook intentionally forces **CPU execution**. It does not select CUDA, enable AMP, or use GPU memory. CPU training is slower, so the default experiment budget is deliberately modest and can be increased after checking runtime.\n\nThe three required, distinct segmentation approaches are:\n1. **Scratch U-Net** — custom encoder-decoder built in this notebook.\n2. **Pretrained ResNet-18 U-Net** — U-Net decoder with ImageNet-pretrained ResNet-18 encoder.\n3. **Pretrained MobileNetV2 DeepLabV3+** — a different segmentation architecture and lightweight ImageNet-pretrained encoder.\n\nThe pretrained encoders are obtained through `segmentation-models-pytorch`. Kaggle Internet must be enabled for the first download unless the weights are already cached. The notebook will stop with a clear error rather than silently claiming an untrained model is pretrained.\n\nFor academic authenticity, keep the experiment history, explain each design choice, and cite the third-party library/backbone. Do not submit code or results you cannot explain in the viva.\n","metadata":{}},{"id":"9d93cbf6","cell_type":"code","source":"import gc\nimport time\nimport torch\nfrom torch.utils.data import DataLoader, WeightedRandomSampler\n\n# Hard guarantee: this notebook uses CPU even when Kaggle detects a GPU.\nDEVICE = torch.device(\"cpu\")\nassert DEVICE.type == \"cpu\"\ntorch.set_num_threads(min(4, os.cpu_count() or 2))\ntorch.manual_seed(42)\nnp.random.seed(42)\nrandom.seed(42)\n\nBATCH_SIZE = 4\nNUM_WORKERS = 0\nEPOCHS_PER_MODEL = 3       # Increase to 5-8 only if CPU time permits.\nEARLY_STOPPING_PATIENCE = 2\nMAX_TRAIN_IMAGES = None    # None = all prepared training images; set e.g. 2500 for a quick smoke test.\n\nif MAX_TRAIN_IMAGES is not None and len(train_df) > MAX_TRAIN_IMAGES:\n    # Stratified sample keeps rare defect combinations represented.\n    train_df = train_df.groupby(\"combination\", group_keys=False).apply(\n        lambda g: g.sample(\n            n=max(1, round(MAX_TRAIN_IMAGES * len(g) / len(train_df))),\n            random_state=42\n        ) if len(g) > 1 else g\n    ).sample(frac=1, random_state=42).head(MAX_TRAIN_IMAGES).reset_index(drop=True)\n\ntrain_dataset = DefectDataset(train_df, augment=True)\nval_dataset = DefectDataset(val_df, augment=False)\n\n# Moderate oversampling for rare categories; clean examples remain in every epoch.\nsample_weights = (\n    1.0\n    + 1.5 * train_df[\"defect_a_present\"].to_numpy()\n    + 3.0 * train_df[\"defect_b_present\"].to_numpy()\n    + 0.5 * train_df[\"defect_d_present\"].to_numpy()\n)\ntrain_sampler = WeightedRandomSampler(\n    torch.as_tensor(sample_weights, dtype=torch.double),\n    num_samples=len(train_df),\n    replacement=True\n)\n\ntrain_loader = DataLoader(\n    train_dataset, batch_size=BATCH_SIZE, sampler=train_sampler,\n    num_workers=NUM_WORKERS, pin_memory=False, drop_last=False\n)\nval_loader = DataLoader(\n    val_dataset, batch_size=BATCH_SIZE, shuffle=False,\n    num_workers=NUM_WORKERS, pin_memory=False\n)\nprint(\"DEVICE:\", DEVICE, \"| CPU threads:\", torch.get_num_threads())\nprint(\"Train images:\", len(train_dataset), \"| Validation images:\", len(val_dataset))\n","metadata":{},"outputs":[],"execution_count":null},{"id":"706e92c2","cell_type":"markdown","source":"## 20. Official validation metric","metadata":{}},{"id":"c2efa2c8","cell_type":"code","source":"@torch.no_grad()\ndef official_score_from_counts(pred_area, intersection, gt_area):\n    \"\"\"Compute the competition's weighted metric from [N,4] arrays/tensors.\"\"\"\n    if torch.is_tensor(pred_area):\n        pred_area = pred_area.cpu().numpy()\n        intersection = intersection.cpu().numpy()\n        gt_area = gt_area.cpu().numpy()\n    positive = gt_area > 0\n    empty = ~positive\n    fg_dice = (\n        2.0 * intersection[positive] /\n        np.maximum(pred_area[positive] + gt_area[positive], 1)\n    ).mean() if positive.any() else 0.0\n    fp_score = (\n        1.0 - (pred_area[empty] / float(HEIGHT * WIDTH)).mean()\n    ) if empty.any() else 1.0\n    empty_accuracy = (pred_area[empty] == 0).mean() if empty.any() else 1.0\n    score = 0.70 * fg_dice + 0.20 * fp_score + 0.10 * empty_accuracy\n    return float(score), float(fg_dice), float(fp_score), float(empty_accuracy)\n\n\n@torch.no_grad()\ndef evaluate_fixed_threshold(net, threshold=0.20):\n    net.eval()\n    pred_area, intersections, gt_area = [], [], []\n    for images, masks in val_loader:\n        images = images.to(DEVICE)\n        masks = masks.to(DEVICE)\n        probs = torch.sigmoid(net(images).float())\n        preds = probs >= threshold\n        pred_area.append(preds.sum((2, 3)).cpu())\n        intersections.append((preds & masks.bool()).sum((2, 3)).cpu())\n        gt_area.append(masks.sum((2, 3)).cpu())\n    return official_score_from_counts(\n        torch.cat(pred_area), torch.cat(intersections), torch.cat(gt_area)\n    )\n","metadata":{},"outputs":[],"execution_count":null},{"id":"16eca962","cell_type":"markdown","source":"## 21. Build the three model variants","metadata":{}},{"id":"07e457a8","cell_type":"code","source":"import segmentation_models_pytorch as smp\n\nclass RGBNormalize(nn.Module):\n    \"\"\"ImageNet normalization wrapper for pretrained RGB encoders.\"\"\"\n    def __init__(self, network):\n        super().__init__()\n        self.network = network\n        self.register_buffer(\n            \"mean\", torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1)\n        )\n        self.register_buffer(\n            \"std\", torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1)\n        )\n\n    def forward(self, x):\n        return self.network((x - self.mean) / self.std)\n\n\n# Model 1: custom scratch model.\nmodel_scratch = UNetScratch().to(DEVICE)\n\n# Models 2 and 3: genuinely pretrained ImageNet encoders.\ntry:\n    model_resnet_unet = RGBNormalize(\n        smp.Unet(\n            encoder_name=\"resnet18\", encoder_weights=\"imagenet\",\n            in_channels=3, classes=len(CLASSES), activation=None\n        )\n    ).to(DEVICE)\n\n    model_mobilenet_deeplab = RGBNormalize(\n        smp.DeepLabV3Plus(\n            encoder_name=\"mobilenet_v2\", encoder_weights=\"imagenet\",\n            in_channels=3, classes=len(CLASSES), activation=None\n        )\n    ).to(DEVICE)\nexcept Exception as exc:\n    raise RuntimeError(\n        \"Pretrained encoder weights could not be loaded. In Kaggle, enable Internet \"\n        \"or attach/cache the ImageNet weights, then rerun this cell. The notebook \"\n        \"does not silently replace a pretrained model with random weights.\"\n    ) from exc\n\nmodels = {\n    \"scratch_unet\": model_scratch,\n    \"resnet18_unet_pretrained\": model_resnet_unet,\n    \"mobilenetv2_deeplabv3plus_pretrained\": model_mobilenet_deeplab,\n}\nfor model_name, net in models.items():\n    print(model_name, f\"{sum(p.numel() for p in net.parameters()):,} parameters\")\n","metadata":{},"outputs":[],"execution_count":null},{"id":"9c295080","cell_type":"markdown","source":"## 22. Train each model on CPU and log three separate W&B runs","metadata":{}},{"id":"35c1681d","cell_type":"code","source":"# W&B credentials are read from Kaggle Secrets. If unavailable, training still runs\n# and local CSV history is saved for comparison.\nWANDB_ENTITY = \"25ds3000134-ds\"\nWANDB_PROJECT = \"25DS3000134_DLGENAI_PROJECT_T32026\"\nwandb_api_key = None\ntry:\n    from kaggle_secrets import UserSecretsClient\n    wandb_api_key = UserSecretsClient().get_secret(\"WANDB_API_KEY\")\nexcept Exception:\n    pass\n\ndef start_wandb_run(model_name):\n    if not wandb_api_key:\n        return None\n    try:\n        import wandb\n        wandb.login(key=wandb_api_key)\n        return wandb.init(\n            entity=WANDB_ENTITY, project=WANDB_PROJECT,\n            name=f\"cpu-{model_name}-2026\",\n            reinit=True,\n            config={\n                \"model\": model_name, \"device\": \"cpu\",\n                \"image_height\": HEIGHT, \"image_width\": WIDTH,\n                \"batch_size\": BATCH_SIZE, \"epochs_max\": EPOCHS_PER_MODEL,\n                \"loss\": \"BCE + positive/empty soft Dice\",\n                \"validation_split\": 0.20\n            }\n        )\n    except Exception as exc:\n        print(\"W&B run unavailable for\", model_name, \":\", str(exc)[:180])\n        return None\n\n\ndef train_one_model(model_name, net, epochs=EPOCHS_PER_MODEL, lr=2e-4):\n    \"\"\"Train on CPU, select checkpoint by the official validation score proxy.\"\"\"\n    net.to(DEVICE)\n    optimizer = torch.optim.AdamW(net.parameters(), lr=lr, weight_decay=1e-4)\n    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=max(1, epochs))\n    checkpoint = f\"/kaggle/working/{model_name}_best_cpu.pth\"\n    best_score, wait, rows = -1.0, 0, []\n    run = start_wandb_run(model_name)\n    start = time.time()\n\n    for epoch in range(1, epochs + 1):\n        net.train()\n        running_loss, batches = 0.0, 0\n        for images, masks in train_loader:\n            images, masks = images.to(DEVICE), masks.to(DEVICE)\n            optimizer.zero_grad(set_to_none=True)\n            logits = net(images)\n            loss = metric_aligned_loss(logits, masks)\n            loss.backward()\n            torch.nn.utils.clip_grad_norm_(net.parameters(), 1.0)\n            optimizer.step()\n            running_loss += float(loss.detach())\n            batches += 1\n\n        scheduler.step()\n        val_score, val_fg, val_fp, val_empty = evaluate_fixed_threshold(net, threshold=0.20)\n        train_loss = running_loss / max(1, batches)\n        row = {\n            \"model\": model_name, \"epoch\": epoch, \"train_loss\": train_loss,\n            \"val_official_at_0.20\": val_score, \"val_foreground_dice\": val_fg,\n            \"val_fp_score\": val_fp, \"val_empty_accuracy\": val_empty,\n            \"learning_rate\": optimizer.param_groups[0][\"lr\"]\n        }\n        rows.append(row)\n        print(\n            f\"{model_name} | epoch {epoch}/{epochs} | loss={train_loss:.4f} \"\n            f\"| official@0.20={val_score:.4f} | fgDice={val_fg:.4f}\"\n        )\n        if run is not None:\n            run.log(row)\n\n        if val_score > best_score + 1e-5:\n            best_score, wait = val_score, 0\n            torch.save(net.state_dict(), checkpoint)\n        else:\n            wait += 1\n            if wait >= EARLY_STOPPING_PATIENCE:\n                print(\"Early stopping:\", model_name)\n                break\n\n    net.load_state_dict(torch.load(checkpoint, map_location=DEVICE, weights_only=True))\n    net.eval()\n    if run is not None:\n        run.summary[\"best_validation_official_at_0.20\"] = best_score\n        run.finish()\n    print(f\"{model_name} completed in {(time.time()-start)/60:.1f} minutes; best={best_score:.4f}\")\n    return net, pd.DataFrame(rows), checkpoint\n\n\nhistories, checkpoints, fixed_scores = {}, {}, {}\nfor name, net in models.items():\n    lr = 5e-4 if name == \"scratch_unet\" else 1.5e-4\n    models[name], histories[name], checkpoints[name] = train_one_model(name, net, lr=lr)\n    fixed_scores[name] = evaluate_fixed_threshold(models[name], threshold=0.20)[0]\n    gc.collect()\n\nhistory_all = pd.concat(histories.values(), ignore_index=True)\nhistory_all.to_csv(\"/kaggle/working/cpu_model_comparison.csv\", index=False)\ndisplay(history_all)\nprint(\"Fixed-threshold model comparison:\", fixed_scores)\n","metadata":{},"outputs":[],"execution_count":null},{"id":"bd0efaab","cell_type":"markdown","source":"## 23. Tune thresholds on validation data and choose the best model\n\nThe tuning below uses only the held-out validation split. It searches per-class thresholds and minimum component areas against the weighted competition metric. The chosen model is selected from the three validation results; the test set is not used for model selection.\n","metadata":{}},{"id":"74c59137","cell_type":"code","source":"@torch.no_grad()\ndef tune_model_on_validation(net):\n    net.eval()\n    n = len(val_dataset)\n    thresholds = [0.06, 0.08, 0.10, 0.12, 0.15, 0.18, 0.22, 0.26, 0.32, 0.40, 0.50]\n    areas = [0, 20, 50, 100, 200, 400]\n    # Compact statistics only: no multi-gigabyte probability-map cache.\n    pred_counts = np.zeros((len(thresholds), n, 4), dtype=np.int32)\n    intersections = np.zeros_like(pred_counts)\n    max_prob = np.zeros((n, 4), dtype=np.float32)\n    gt_area = np.zeros((n, 4), dtype=np.int32)\n\n    offset = 0\n    for images, masks in val_loader:\n        images, masks = images.to(DEVICE), masks.to(DEVICE)\n        probs = torch.sigmoid(net(images).float())\n        b = len(images)\n        gt_area[offset:offset+b] = masks.sum((2, 3)).cpu().numpy()\n        max_prob[offset:offset+b] = probs.flatten(2).amax(2).cpu().numpy()\n        for ti, threshold in enumerate(thresholds):\n            pred = probs >= threshold\n            pred_counts[ti, offset:offset+b] = pred.sum((2, 3)).cpu().numpy()\n            intersections[ti, offset:offset+b] = (\n                (pred & masks.bool()).sum((2, 3)).cpu().numpy()\n            )\n        offset += b\n\n    pos = gt_area > 0\n    empty = ~pos\n    n_pos = max(int(pos.sum()), 1)\n    n_empty = max(int(empty.sum()), 1)\n    params = {}\n    for c, cls in enumerate(CLASSES):\n        best = (-1e9, None)\n        for ti, threshold in enumerate(thresholds):\n            for min_area in areas:\n                # Small connected-component filtering is applied later at inference.\n                pa = pred_counts[ti, :, c].copy()\n                it = intersections[ti, :, c].copy()\n                keep = pa >= min_area\n                pa[~keep] = 0\n                it[~keep] = 0\n                # Strip-level confidence gate helps avoid isolated false alarms.\n                for gate in [0.0, 0.12, 0.20, 0.30, 0.40, 0.50]:\n                    gate_keep = max_prob[:, c] >= gate\n                    pa2, it2 = pa.copy(), it.copy()\n                    pa2[~gate_keep] = 0\n                    it2[~gate_keep] = 0\n                    dice_sum = (\n                        2.0 * it2[pos[:, c]] /\n                        np.maximum(pa2[pos[:, c]] + gt_area[pos[:, c], c], 1)\n                    ).sum()\n                    fp_pixels = pa2[empty[:, c]].sum()\n                    empty_correct = (pa2[empty[:, c]] == 0).sum()\n                    score_contribution = (\n                        0.70 * dice_sum / n_pos\n                        - 0.20 * fp_pixels / (HEIGHT * WIDTH * n_empty)\n                        + 0.10 * empty_correct / n_empty\n                    )\n                    if score_contribution > best[0]:\n                        best = (score_contribution, {\n                            \"threshold\": threshold, \"min_area\": min_area, \"gate\": gate\n                        })\n        params[cls] = best[1]\n\n    # Re-run validation once to compute the combined official score with tuned rules.\n    final_pa, final_it = [], []\n    offset = 0\n    for images, masks in val_loader:\n        probs = torch.sigmoid(net(images.to(DEVICE)).float()).cpu().numpy()\n        m = np.zeros((len(images), 4), dtype=np.int32)\n        it = np.zeros_like(m)\n        y = masks.numpy()\n        for c, cls in enumerate(CLASSES):\n            q = params[cls]\n            binary = probs[:, c] >= q[\"threshold\"]\n            binary_area = binary.sum((1, 2))\n            keep = (probs[:, c].max((1, 2)) >= q[\"gate\"]) & (binary_area >= q[\"min_area\"])\n            binary[~keep] = False\n            m[:, c] = binary.sum((1, 2))\n            it[:, c] = (binary * y[:, c]).sum((1, 2))\n        final_pa.append(m); final_it.append(it)\n    score, fg, fp, ea = official_score_from_counts(\n        np.concatenate(final_pa), np.concatenate(final_it), gt_area\n    )\n    return score, fg, fp, ea, params\n\n\ntuned_results = {}\nfor name, net in models.items():\n    result = tune_model_on_validation(net)\n    tuned_results[name] = result\n    print(name, \"tuned official score:\", round(result[0], 5),\n          \"| foreground Dice:\", round(result[1], 5))\n    print(\"Thresholds:\", result[4])\n\nbest_model_name = max(tuned_results, key=lambda k: tuned_results[k][0])\nbest_model = models[best_model_name]\nbest_validation_official = tuned_results[best_model_name][0]\nbest_class_params = tuned_results[best_model_name][4]\nprint(\"\\nSelected model:\", best_model_name)\nprint(\"Best tuned validation official score:\", round(best_validation_official, 5))\n","metadata":{},"outputs":[],"execution_count":null},{"id":"ce9ee0b5","cell_type":"markdown","source":"## 24. Test image discovery and RLE helpers","metadata":{}},{"id":"63794480","cell_type":"code","source":"# Reuse the official competition sample-submission order.\nall_image_paths = glob.glob(\"/kaggle/input/**/*\", recursive=True)\nvalid_extensions = (\".png\", \".jpg\", \".jpeg\", \".bmp\")\nrequested_ids = sample_submission[\"image_id\"].astype(str).unique()\nrequested_stems = {Path(x).stem for x in requested_ids}\ntest_candidates = [\n    p for p in all_image_paths\n    if p.lower().endswith(valid_extensions)\n    and \"/test/\" in p.replace(\"\\\\\", \"/\").lower()\n    and Path(p).stem in requested_stems\n]\nif not test_candidates:\n    test_candidates = [\n        p for p in all_image_paths\n        if p.lower().endswith(valid_extensions) and Path(p).stem in requested_stems\n    ]\ntest_image_map = {}\nfor pth in test_candidates:\n    test_image_map.setdefault(Path(pth).stem, pth)\nmissing = [x for x in requested_ids if Path(x).stem not in test_image_map]\nif missing:\n    raise FileNotFoundError(f\"Missing {len(missing)} test images; examples: {missing[:5]}\")\n\ndef apply_minimum_mask_area(binary_mask, min_area):\n    \"\"\"Match validation tuning: discard a whole class mask if its total area is too small.\"\"\"\n    binary_mask = binary_mask.astype(np.uint8)\n    if int(binary_mask.sum()) < int(min_area):\n        binary_mask[:] = 0\n    return binary_mask\n\n\ndef encode_rle(mask):\n    pixels = np.asarray(mask, dtype=np.uint8).T.flatten()\n    pixels = np.concatenate(([0], pixels, [0]))\n    changes = np.where(pixels[1:] != pixels[:-1])[0] + 1\n    changes[1::2] -= changes[::2]\n    return \" \".join(map(str, changes))\n","metadata":{},"outputs":[],"execution_count":null},{"id":"27dcf56d","cell_type":"markdown","source":"## 25. CPU-only test inference and submission generation","metadata":{}},{"id":"73a19d5f","cell_type":"code","source":"class TestImageDataset(torch.utils.data.Dataset):\n    def __init__(self, ids):\n        self.ids = list(ids)\n    def __len__(self):\n        return len(self.ids)\n    def __getitem__(self, idx):\n        image_id = self.ids[idx]\n        image = cv2.imread(test_image_map[Path(image_id).stem])\n        if image is None:\n            raise FileNotFoundError(test_image_map[Path(image_id).stem])\n        image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n        image = cv2.resize(image, (WIDTH, HEIGHT)).astype(np.float32) / 255.0\n        tensor = torch.from_numpy(np.ascontiguousarray(image.transpose(2, 0, 1)))\n        return image_id, tensor\n\n\ntest_ids = sample_submission[\"image_id\"].astype(str).drop_duplicates().tolist()\ntest_loader = DataLoader(\n    TestImageDataset(test_ids), batch_size=BATCH_SIZE,\n    shuffle=False, num_workers=0, pin_memory=False\n)\n\nbest_model.eval()\nprediction_cache = {}\nwith torch.no_grad():\n    for batch_ids, images in test_loader:\n        images = images.to(DEVICE)\n        # Horizontal-flip TTA; average aligned probability maps.\n        p0 = torch.sigmoid(best_model(images).float())\n        p1 = torch.flip(\n            torch.sigmoid(best_model(torch.flip(images, dims=[3])).float()),\n            dims=[3]\n        )\n        probs = ((p0 + p1) / 2.0).cpu().numpy()\n\n        for b, image_id in enumerate(batch_ids):\n            masks_for_image = {}\n            for c, cls in enumerate(CLASSES):\n                q = best_class_params[cls]\n                binary = (probs[b, c] >= q[\"threshold\"]).astype(np.uint8)\n                if probs[b, c].max() < q[\"gate\"]:\n                    binary[:] = 0\n                binary = apply_minimum_mask_area(binary, q[\"min_area\"])\n                masks_for_image[cls] = encode_rle(binary)\n            prediction_cache[image_id] = masks_for_image\n\nsubmission = sample_submission.copy()\nsubmission[\"image_id\"] = submission[\"image_id\"].astype(str)\nsubmission[\"defect_type\"] = submission[\"defect_type\"].astype(str)\nsubmission[\"mask_rle\"] = [\n    prediction_cache[image_id][defect].strip() or \" \"\n    for image_id, defect in zip(submission[\"image_id\"], submission[\"defect_type\"])\n]\nsubmission = submission[[\"ID\", \"image_id\", \"defect_type\", \"mask_rle\"]]\n\nassert len(submission) == len(sample_submission)\nassert submission[\"ID\"].equals(sample_submission[\"ID\"])\nassert submission[\"image_id\"].equals(sample_submission[\"image_id\"].astype(str))\nassert submission[\"defect_type\"].equals(sample_submission[\"defect_type\"].astype(str))\nassert submission[\"mask_rle\"].notna().all()\n\noutput_path = \"/kaggle/working/submission.csv\"\nsubmission.to_csv(output_path, index=False)\nprint(\"Saved:\", output_path)\nprint(\"Chosen model:\", best_model_name)\nprint(\"Validation official score:\", round(best_validation_official, 5))\nprint(\"Submission rows:\", len(submission), \"| images:\", submission[\"image_id\"].nunique())\nprint(\"Non-empty masks:\", int((submission[\"mask_rle\"].str.strip() != \"\").sum()))\ndisplay(submission.head())\n","metadata":{},"outputs":[],"execution_count":null},{"id":"429afaad","cell_type":"markdown","source":"## 26. Final experiment summary and academic integrity checklist\n\n- Three model families are trained and compared on the same split and metric.\n- Model 1 is implemented from scratch in this notebook.\n- Models 2 and 3 use documented pretrained ImageNet encoders via `segmentation-models-pytorch`.\n- Each model gets a separate W&B run when credentials are available; local history is saved to `cpu_model_comparison.csv`.\n- The final model is selected only using the held-out validation set. Per-class thresholds are tuned on validation data.\n- Test inference is CPU-only and uses horizontal-flip TTA.\n- The output follows the supplied `sample_submission.csv` row order and schema.\n\n**Authenticity:** This is a newly organized implementation for this dataset and CPU constraint, not a guarantee that a similarity checker will report zero matches. Common architectures, standard PyTorch patterns, and third-party library calls naturally resemble public examples. Cite PyTorch, OpenCV, and `segmentation-models-pytorch`; keep your own experiment logs and Git history; and be prepared to explain the code line by line. Do not claim that generated code was written independently without reviewing and adapting it yourself.\n\n**Score caution:** The 0.85 target is an experiment goal, not a promised outcome. Check the validation score, compare the per-model histories, and use actual Kaggle leaderboard feedback before making any performance claim.\n","metadata":{}}]}