= nn.Sequential(\n            nn.Conv2d(in_ch, out_ch, 3, padding=1),\n            nn.BatchNorm2d(out_ch),\n            nn.ReLU(inplace=True),\n            nn.Conv2d(out_ch, out_ch, 3, padding=1),\n            nn.BatchNorm2d(out_ch),\n            nn.ReLU(inplace=True)\n        )\n\n    def forward(self, x):\n        return self.block(x)\n\n\nclass UNet(nn.Module):\n    def __init__(self, out_channels=4):\n        super().__init__()\n        self.enc1 = ConvBlock(3, 32)\n        self.enc2 = ConvBlock(32, 64)\n        self.enc3 = ConvBlock(64, 128)\n        self.enc4 = ConvBlock(128, 256)\n\n        self.pool = nn.MaxPool2d(2)\n        self.bottleneck = ConvBlock(256, 512)\n\n        self.up4 = nn.ConvTranspose2d(512, 256, 2, stride=2)\n        self.dec4 = ConvBlock(512, 256)\n        self.up3 = nn.ConvTranspose2d(256, 128, 2, stride=2)\n        self.dec3 = ConvBlock(256, 128)\n        self.up2 = nn.ConvTranspose2d(128, 64, 2, stride=2)\n        self.dec2 = ConvBlock(128, 64)\n        self.up1 = nn.ConvTranspose2d(64, 32, 2, stride=2)\n        self.dec1 = ConvBlock(64, 32)\n\n        self.output = nn.Conv2d(32, out_channels, 1)\n\n    def forward(self, x):\n        e1 = self.enc1(x)\n        e2 = self.enc2(self.pool(e1))\n        e3 = self.enc3(self.pool(e2))\n        e4 = self.enc4(self.pool(e3))\n        b = self.bottleneck(self.pool(e4))\n\n        d4 = self.dec4(torch.cat([self.up4(b), e4], dim=1))\n        d3 = self.dec3(torch.cat([self.up3(d4), e3], dim=1))\n        d2 = self.dec2(torch.cat([self.up2(d3), e2], dim=1))\n        d1 = self.dec1(torch.cat([self.up1(d2), e1], dim=1))\n\n        return self.output(d1)\n\n\nmodel = UNet().to(DEVICE)\nprint(\"Model parameters:\", f\"{sum(p.numel() for p in model.parameters()):,}\")","metadata":{"execution":{"iopub.execute_input":"2026-11-05T07:27:09.49362Z","iopub.status.busy":"2026-11-05T07:27:09.492881Z","iopub.status.idle":"2026-11-05T07:27:09.594749Z","shell.execute_reply":"2026-11-05T07:27:09.59393Z"},"papermill":{"duration":0.152151,"end_time":"2026-11-05T07:27:09.596331+00:00","exception":false,"start_time":"2026-11-05T07:27:09.44418+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# 18. Define the combined loss and Dice metric","metadata":{"papermill":{"duration":0.043535,"end_time":"2026-11-05T07:27:09.684521+00:00","exception":false,"start_time":"2026-11-05T07:27:09.640986+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"def metric_aligned_loss(logits, targets, pos_weight=None, eps=1.0):\n    \"\"\"\n    BCE + soft-Dice. Dice is computed on every (strip, class) mask:\n      * positive masks  -> reward overlap            (70% foreground-Dice part of the metric)\n      * empty masks     -> soft-Dice = 1 - 1/(sum(p)+1), which punishes ANY predicted mass\n                           (the 20% false-positive + 10% empty-accuracy parts)\n    Independent sigmoid per class (multi-label), never softmax.\n    \"\"\"\n    logits = logits.float()\n    targets = targets.float()\n    probs = torch.sigmoid(logits)\n\n    p = probs.flatten(2)\n    t = targets.flatten(2)\n    dice_loss_map = 1.0 - (2.0 * (p * t).sum(2) + eps) / (p.sum(2) + t.sum(2) + eps)   # [B, 4]\n    positive = t.sum(2) > 0\n\n    fg = dice_loss_map[positive].mean() if positive.any() else probs.mean() * 0.0\n    empty = dice_loss_map[~positive].mean() if (~positive).any() else probs.mean() * 0.0\n\n    if pos_weight is None:\n        bce = F.binary_cross_entropy_with_logits(logits, targets)\n    else:\n        bce = F.binary_cross_entropy_with_logits(logits, targets, pos_weight=pos_weight.view(1, -1, 1, 1))\n\n    return bce + 0.7 * fg + 0.3 * empty\n\n\ndef dice_loss(logits, targets, smooth=1.0):\n    probs = torch.sigmoid(logits).flatten(2)\n    targets = targets.flatten(2)\n    dice = (2 * (probs * targets).sum(2) + smooth) / (probs.sum(2) + targets.sum(2) + smooth)\n    return 1 - dice.mean()\n\n\nbce_loss = nn.BCEWithLogitsLoss()\n\ndef combined_loss(logits, targets):\n    return metric_aligned_loss(logits, targets)\n\n\n@torch.no_grad()\ndef batch_dice_score(logits, targets, threshold=0.5, smooth=1.0):\n    preds = (torch.sigmoid(logits.float()) >= threshold).float().flatten(2)\n    targets = targets.flatten(2)\n    inter = (preds * targets).sum(2)\n    den = preds.sum(2) + targets.sum(2)\n    return ((2 * inter + smooth) / (den + smooth)).mean().item()\n\n\nprint(\"Independent-sigmoid outputs and BCE + Dice (positive/empty weighted) loss ready.\")","metadata":{"execution":{"iopub.execute_input":"2026-11-05T07:27:09.770455Z","iopub.status.busy":"2026-11-05T07:27:09.769995Z","iopub.status.idle":"2026-11-05T07:27:09.779137Z","shell.execute_reply":"2026-11-05T07:27:09.7785Z"},"papermill":{"duration":0.053792,"end_time":"2026-11-05T07:27:09.780783+00:00","exception":false,"start_time":"2026-11-05T07:27:09.726991+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 19. Weights & Biases experiment tracking","metadata":{"papermill":{"duration":0.046321,"end_time":"2026-11-05T07:27:09.869861+00:00","exception":false,"start_time":"2026-11-05T07:27:09.82354+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"# Track the experiments in the course W&B project.\nimport os\n\nwandb_run = None\nWANDB_ENABLED = False\n\ntry:\n    import wandb\n    from kaggle_secrets import UserSecretsClient\n\n    os.environ[\"WANDB_API_KEY\"] = UserSecretsClient().get_secret(\"WANDB_API_KEY\")\n    wandb.login()\n\n    wandb_run = wandb.init(\n        entity=\"25ds3000134-ds\",\n        project=\"25DS3000134_DLGENAI_PROJECT_T32026\",\n        name=\"industrial-surface_defect-pretrained-experiments\",\n        config={\n            \"task\": \"industrial_surface_defect_segmentation\",\n            \"dataset\": \"Industrial Surface Defect Detection\",\n            \"classes\": list(CLASSES),\n            \"image_height\": HEIGHT,\n            \"