      continue\n\n    values = rle.split()\n\n    if len(values) % 2 != 0:\n        malformed_rows += 1\n        continue\n\n    try:\n        values = list(map(int, values))\n    except ValueError:\n        malformed_rows += 1\n        continue\n\n    total_runs += len(values) // 2\n\n    for start, length in zip(values[0::2], values[1::2]):\n        endpoint = start + length - 1\n        max_endpoint = max(max_endpoint, endpoint)\n\n        if start < 1 or length < 1 or endpoint > 128 * 800:\n            invalid_runs += 1\n\nprint(\"Total RLE runs:\", total_runs)\nprint(\"Malformed rows:\", malformed_rows)\nprint(\"Invalid runs:\", invalid_runs)\nprint(\"Largest endpoint:\", max_endpoint)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-17T10:52:57.238987Z","iopub.execute_input":"2026-10-17T10:52:57.239276Z","iopub.status.idle":"2026-10-17T10:52:57.711121Z","shell.execute_reply.started":"2026-10-17T10:52:57.239256Z","shell.execute_reply":"2026-10-17T10:52:57.710561Z"}},"outputs":[{"name":"stdout","text":"Total RLE runs: 797406\nMalformed rows: 0\nInvalid runs: 0\nLargest endpoint: 102400\n","output_type":"stream"}],"execution_count":9},{"cell_type":"markdown","source":"# Q5 Geometric Distortion Under Resizing","metadata":{}},{"cell_type":"code","source":"\n# Original and resized image dimensions\noriginal_width, original_height = 800, 128\nnew_width, new_height = 256, 256\n\nsx = new_width / original_width\nsy = new_height / original_height\n\nprint(\"Horizontal scale:\", sx)\nprint(\"Vertical scale:\", sy)\nprint(\"Scale ratio:\", max(sx, sy) / min(sx, sy))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-17T10:52:57.712147Z","iopub.execute_input":"2026-10-17T10:52:57.71254Z","iopub.status.idle":"2026-10-17T10:52:57.717468Z","shell.execute_reply.started":"2026-10-17T10:52:57.712512Z","shell.execute_reply":"2026-10-17T10:52:57.716822Z"}},"outputs":[{"name":"stdout","text":"Horizontal scale: 0.32\nVertical scale: 2.0\nScale ratio: 6.25\n","output_type":"stream"}],"execution_count":10},{"cell_type":"markdown","source":"# Photometric Invisibility & Defect Feature Types","metadata":{}},{"cell_type":"code","source":"\n#Q6 Photometric Invisibility & Defect Feature Types (Cohen's d)\n\nimport glob\nfrom pathlib import Path\nimport cv2\nDEFECTS = [\"defect_a\", \"defect_b\", \"defect_c\", \"defect_d\"]\nimage_files = glob.glob(\"/kaggle/input/**/train/**/*\", recursive=True)\nimage_files = [\n    p for p in image_files\n    if p.lower().endswith((\".jpg\", \".jpeg\", \".png\", \".bmp\"))\n]\nimage_map = {Path(p).stem: p for p in image_files}\n\nprint(\"Training images found:\", len(image_map))\n\nrng = np.random.default_rng(42)\nkernel = np.ones((7, 7), np.uint8)\n\nfor defect in DEFECTS:\n    defect_pixels, bg_pixels = [], []\n\n    rows = train[\n        (train[\"defect_type\"] == defect) &\n        (train[\"mask_rle\"] != \"\")\n    ].sample(frac=1, random_state=42).head(100)\n\n    for _, row in rows.iterrows():\n        image_id = Path(str(row[\"image_id\"])).stem\n        path = image_map.get(image_id)\n\n        if path is None:\n            continue\n\n        image = cv2.imread(path, cv2.IMREAD_GRAYSCALE)\n        if image is None:\n            continue\n\n        mask = decode_rle(row[\"mask_rle\"]).astype(bool)\n        if mask.shape != image.shape or not mask.any():\n            continue\n\n        expanded = cv2.dilate(mask.astype(np.uint8), kernel).astype(bool)\n        background = expanded & ~mask\n\n        if not background.any():\n            continue\n\n        d_values = image[mask].ravel()\n        b_values = image[background].ravel()\n\n        # Sample pixels so large defects do not dominate memory.\n        if len(d_values) > 20000:\n            d_values = rng.choice(d_values, 20000, replace=False)\n        if len(b_values) > 20000:\n            b_values = rng.choice(b_values, 20000, replace=False)\n\n        defect_pixels.extend(d_values.tolist())\n        bg_pixels.extend(b_values.tolist())\n\n    d_pixels = np.asarray(defect_pixels, dtype=float)\n    b_pixels = np.asarray(bg_pixels, dtype=float)\n\n    if len(d_pixels) < 2 or len(b_pixels) < 2:\n        print(defect, \"not enough pixels to calculate Cohen's d\")\n        continue\n\n    pooled_sd = np.sqrt(\n        ((len(d_pixels) - 1) * d_pixels.var(ddof=1)\n         + (len(b_pixels) - 1) * b_pixels.var(ddof=1))\n        / (len(d_pixels) + len(b_pixels) - 2)\n    )\n\n    cohens_d = (\n        (d_pixels.mean() - b_pixels.mean()) / pooled_sd\n        if pooled_sd > 0 else 0.0\n    )\n\n    print(defect, \"Cohen's d:\", round(cohens_d, 4))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-17T10:52:57.71847Z","iopub.execute_input":"2026-10-17T10:52:57.718752Z","iopub.status.idle":"2026-10-17T10:53:34.576934Z","shell.execute_reply.started":"2026-10-17T10:52:57.718733Z","shell.execute_reply":"2026-10-17T10:53:34.576227Z"}},"outputs":[{"name":"stdout","text":"Training images found: 11393\ndefect_a Cohen's d: 0.0051\ndefect_b Cohen's d: -0.0964\ndefect_c Cohen's d: 0.0498\ndefect_d Cohen's d: -0.1709\n","output_type":"stream"}],"execution_count":11},{"cell_type":"markdown","source":"# Questions 7 and 8: Metric Behavior and Official Competition Weighted Metric","metadata":{}},{"cell_type":"code","source":"\n# Question 7: Metric Behavior — The Discontinuous Step Function of Naive Dice\n\ndice1 = 1.0  # empty prediction and empty ground truth\ndice2 = 0.0  # two predicted pixels, but empty ground truth\n\nprint(\"Q7 answer:\", dice1, dice2)\n\n\n# Question 8: Official Competition Weighted Metric — Toy Batch Calculation\n\nforeground_dice = (6 * 0.80 + 4 * 0.40) / 10\n\nfp_fraction = (4 * (1024 / 102400)) / 40\nfalse_positive_score = 1 - fp_fraction\n\nempty_accuracy = 36 / 40\n\nfinal_score = (\n    0.70 * foreground_dice\n    + 0.20 * false_positive_score\n    + 0.10 * empty_accuracy\n)\n\nprint(\"ForegroundDice:\", round(foreground_dice, 4))\nprint(\"FalsePositiveScore:\", round(false_positive_score, 4))\nprint(\"EmptyAccuracy:\", round(empty_accuracy, 4))\nprint(\"Final weighted score:\", round(final_score, 4))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-17T10:53:34.578024Z","iopub.execute_input":"2026-10-17T10:53:34.578334Z","iopub.status.idle":"2026-10-17T10:53:34.584741Z","shell.execute_reply.started":"2026-10-17T10:53:34.578311Z","shell.execute_reply":"2026-10-17T10:53:34.584075Z"}},"outputs":[{"name":"stdout","text":"Q7 answer: 1.0 0.0\nForegroundDice: 0.64\nFalsePositiveScore: 0.999\nEmptyAccuracy: 0.9\nFinal weighted score: 0.7378\n","output_type":"stream"}],"execution_count":12},{"cell_type":"markdown","source":"# Question 9: The “All-Empty Baseline” on the Full Training Set","metadata":{}},{"cell_type":"code","source":"\n# Question 9: The “All-Empty Baseline” on the Full Training Set\n\ntotal_pairs = len(train)\nempty_pairs = (train[\"mask_rle\"] == \"\").sum()\npositive_pairs = total_pairs - empty_pairs\n\n# Empty-aware naive Dice: empty pairs score 1, positive pairs score 0\nnaive_dice = empty_pairs / total_pairs\n\n# All-empty predictions: no false positives, but no true defects detected\nforeground_dice = 0.0 if positive_pairs else 1.0\nfalse_positive_score = 1.0\nempty_accuracy = 1.0\n\nofficial_score = (\n    0.70 * foreground_dice\n    + 0.20 * false_positive_score\n    + 0.10 * empty_accuracy\n)\n\nprint(\"Total pairs:\", total_pairs)\nprint(\"Empty ground-truth pairs:\", empty_pairs)\nprint(\"Naive mean Dice:\", round(naive_dice, 4))\nprint(\"Official competition score:\", round(official_score, 4))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-17T10:53:34.585663Z","iopub.execute_input":"2026-10-17T10:53:34.58598Z","iopub.status.idle":"2026-10-17T10:53:34.610029Z","shell.execute_reply.started":"2026-10-17T10:53:34.585943Z","shell.execute_reply":"2026-10-17T10:53:34.609375Z"}},"outputs":[{"name":"stdout","text":"Total pairs: 45572\nEmpty ground-truth pairs: 38371\nNaive mean Dice: 0.842\nOfficial competition score: 0.3\n","output_type":"stream"}],"execution_count":13},{"cell_type":"markdown","source":"# Question 10: Morphological Noise Filtering — Minimum Area Recall Ceilings","metadata":{}},{"cell_type":"code","source":"\n# Question 10: Morphological Noise Filtering — Minimum Area Recall Ceilings\n\nimport cv2\n\nmin_area_b = float(\"inf\")\ntotal_b_pixels = 0\nlost_b_pixels = 0\n\ntotal_a_pixels = 0\nlost_a_pixels = 0\n\nfor _, row in train.iterrows():\n    rle = row[\"mask_rle\"]\n    if not rle:\n        continue\n\n    defect = row[\"defect_type\"]\n    if defect not in (\"defect_a\", \"defect_b\"):\n        continue\n\n    mask = decode_rle(rle).astype(np.uint8)\n    total_pixels = int(mask.sum())\n\n    if total_pixels == 0:\n        continue\n\n    _, labels, stats, _ = cv2.connectedComponentsWithStats(\n        mask, connectivity=8\n    )\n    areas = stats[1:, cv2.CC_STAT_AREA]\n\n    if defect == \"defect_b\":\n        if len(areas):\n            min_area_b = min(min_area_b, int(areas.min()))\n        total_b_pixels += total_pixels\n        lost_b_pixels += int(areas[areas < 50].sum())\n\n    elif defect == \"defect_a\":\n        total_a_pixels += total_pixels\n        lost_a_pixels += int(areas[areas < 200].sum())\n\nlost_b_pct = 100 * lost_b_pixels / total_b_pixels\nlost_a_pct = 100 * lost_a_pixels / total_a_pixels\n\nprint(\"Smallest defect_b component:\", min_area_b)\nprint(\"defect_b pixels lost at N=50 (%):\", round(lost_b_pct, 4))\nprint(\"defect_a pixels lost at N=200 (%):\", round(lost_a_pct, 4))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-17T10:53:34.610991Z","iopub.execute_input":"2026-10-17T10:53:34.61128Z","iopub.status.idle":"2026-10-17T10:53:38.079285Z","shell.execute_reply.started":"2026-10-17T10:53:34.611232Z","shell.execute_reply":"2026-10-17T10:53:38.07872Z"}},"outputs":[{"name":"stdout","text":"Smallest defect_b component: 93\ndefect_b pixels lost at N=50 (%): 0.0\ndefect_a pixels lost at N=200 (%): 15.2171\n","output_type":"stream"}],"execution_count":14},{"cell_type":"markdown","source":"# Question 11: Multi-Label Combination Stratification","metadata":{}},{"cell_type":"code","source":"\n# Question 11: Multi-Label Combination Stratification\n\nimage_labels = train.pivot(\n    index=\"image_id\",\n    columns=\"defect_type\",\n    values=\"has_defect\"\n).fillna(False).astype(bool)\n\nimage_labels[\"combination\"] = image_labels.apply(\n    lambda row: \"+\".join(\n        defect for defect in DEFECTS if row[defect]\n    ) or \"clean\",\n    axis=1\n)\n\nn_combos = image_labels[\"combination\"].nunique()\n\nb_positive = int(image_labels[\"defect_b\"].sum())\nb_in_val = round(b_positive * 0.20)\n\nprint(\"Unique label combinations:\", n_combos)\nprint(\"defect_b-positive images:\", b_positive)\nprint(\"Expected defect_b images in 20% validation:\", b_in_val)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-17T10:53:38.080283Z","iopub.execute_input":"2026-10-17T10:53:38.080697Z","iopub.status.idle":"2026-10-17T10:53:38.239206Z","shell.execute_reply.started":"2026-10-17T10:53:38.080669Z","shell.execute_reply":"2026-10-17T10:53:38.238391Z"}},"outputs":[{"name":"stdout","text":"Unique label combinations: 15\ndefect_b-positive images: 313\nExpected defect_b images in 20% validation: 63\n","output_type":"stream"}],"execution_count":15},{"cell_type":"markdown","source":"# Question 12: Baseline Model Implementation & Decision Threshold Sweep","metadata":{}},{"cell_type":"code","source":"\n# Question 12: Baseline Model Implementation & Decision Threshold Sweep\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import Dataset, DataLoader\nfrom sklearn.model_selection import train_test_split\n\n# Find the training images\nimage_files = glob.glob(\"/kaggle/input/**/train/**/*\", recursive=True)\nimage_files = [\n    p for p in image_files\n    if p.lower().endswith((\".jpg\", \".jpeg\", \".png\", \".bmp\"))\n]\nimage_map = {Path(p).stem: p for p in image_files}\n\n# Prepare one label-combination string per image\ntrain[\"image_id\"] = train[\"image_id\"].astype(str)\ntrain[\"mask_rle\"] = train[\"mask_rle\"].fillna(\"\").astype(str).str.strip()\ntrain[\"has_defect\"] = train[\"mask_rle\"] != \"\"\n\ntable = train.pivot(\n    index=\"image_id\",\n    columns=\"defect_type\",\n    values=\"has_defect\"\n).fillna(False).astype(bool)\n\ntable[\"combination\"] = table.apply(\n    lambda row: \"+\".join(d for d in DEFECTS if row[d]) or \"clean\",\n    axis=1\n)\n\n# Keep each image and all its masks in the same split\ntrain_ids, val_ids = train_test_split(\n    table.index.tolist(),\n    test_size=0.20,\n    random_state=42,\n    stratify=table[\"combination\"]\n)\n\nmask_lookup = {\n    image_id: dict(zip(group[\"defect_type\"], group[\"mask_rle\"]))\n    for image_id, group in train.groupby(\"image_id\")\n}\n\nclass SurfaceDataset(Dataset):\n    def __init__(self, image_ids):\n        self.image_ids = list(image_ids)\n\n    def __len__(self):\n        return len(self.image_ids)\n\n    def __getitem__(self, idx):\n        image_id = self.image_ids[idx]\n        path = image_map.get(Path(image_id).stem)\n\n        if path is None:\n            raise FileNotFoundError(f\"Image not found: {image_id}\")\n\n        image = cv2.imread(path)\n        image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n        image = torch.from_numpy(\n            image.astype(np.float32) / 255.0\n        ).permute(2, 0, 1)\n\n        masks = [\n            decode_rle(mask_lookup[image_id].get(d, \"\"))\n            for d in DEFECTS\n        ]\n        masks = torch.from_numpy(\n            np.stack(masks).astype(np.float32)\n        )\n\n        return image, masks\n\n\nclass ConvBlock(nn.Module):\n    def __init__(self, in_ch, out_ch):\n        super().__init__()\n        self.block = nn.Sequential(\n            nn.Conv2d(in_ch, out_ch, 3, padding=1),\n            nn.BatchNorm2d(out_ch),\n            nn.ReLU(inplace=True),\n            nn.Conv2d(out_ch, out_ch, 3, padding=1),\n            nn.BatchNorm2d(out_ch),\n            nn.ReLU(inplace=True)\n        )\n\n    def forward(self, x):\n        return self.block(x)\n\n\nclass SmallUNet(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.pool = nn.MaxPool2d(2)\n        self.e1 = ConvBlock(3, 16)\n        self.e2 = ConvBlock(16, 32)\n        self.e3 = ConvBlock(32, 64)\n        self.mid = ConvBlock(64, 128)\n        self.d3 = ConvBlock(128 + 64, 64)\n        self.d2 = ConvBlock(64 + 32, 32)\n        self.d1 = ConvBlock(32 + 16, 16)\n        self.out = nn.Conv2d(16, 4, 1)\n\n    def forward(self, x):\n        a = self.e1(x)\n        b = self.e2(self.pool(a))\n        c = self.e3(self.pool(b))\n        z = self.mid(self.pool(c))\n\n        z = F.interpolate(z, size=c.shape[-2:],\n                          mode=\"bilinear\", align_corners=False)\n        z = self.d3(torch.cat([z, c], dim=1))\n\n        z = F.interpolate(z, size=b.shape[-2:],\n                          mode=\"bilinear\", align_corners=False)\n        z = self.d2(torch.cat([z, b], dim=1))\n\n        z = F.interpolate(z, size=a.shape[-2:],\n                          mode=\"bilinear\", align_corners=False)\n        z = self.d1(torch.cat([z, a], dim=1))\n\n        return self.out(z)\n\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\ntrain_loader = DataLoader(\n    SurfaceDataset(train_ids), batch_size=8,\n    shuffle=True, num_workers=2, pin_memory=True\n)\nval_loader = DataLoader(\n    SurfaceDataset(val_ids), batch_size=8,\n    shuffle=False, num_workers=2, pin_memory=True\n)\n\nmodel = SmallUNet().to(device)\noptimizer = torch.optim.AdamW(model.parameters(), lr=1e-3)\nbce_loss = nn.BCEWithLogitsLoss()\n\n# Train for five epochs using BCE plus Dice loss\nfor epoch in range(5):\n    model.train()\n    running_loss = 0.0\n\n    for images, masks in train_loader:\n        images = images.to(device)\n        masks = masks.to(device)\n\n        optimizer.zero_grad()\n        logits = model(images)\n        probs = torch.sigmoid(logits)\n\n        dice = (\n            2 * (probs * masks).sum((2, 3)) + 1\n        ) / (\n            probs.sum((2, 3)) + masks.sum((2, 3)) + 1\n        )\n\n        loss = bce_loss(logits, masks) + (1 - dice.mean())\n        loss.backward()\n        optimizer.step()\n\n        running_loss += loss.item()\n\n    print(\n        f\"Epoch {epoch + 1}/5, \"\n        f\"loss: {running_loss / len(train_loader):.4f}\"\n    )\n\ntorch.save(model.state_dict(), \"/kaggle/working/milestone1_unet.pt\")\nprint(\"Model saved.\")\n\n# Evaluate all thresholds using the same trained model\nthresholds = [0.3, 0.5, 0.7, 0.9]\nresults = {\n    t: {\"pos_dice\": 0.0, \"pos_n\": 0,\n        \"fp_fraction\": 0.0, \"empty_n\": 0, \"empty_correct\": 0}\n    for t in thresholds\n}\n\nmodel.eval()\nwith torch.no_grad():\n    for images, masks in val_loader:\n        images = images.to(device)\n        masks = masks.to(device)\n        probs = torch.sigmoid(model(images))\n\n        gt_area = masks.sum((2, 3))\n        positive = gt_area > 0\n        empty = ~positive\n\n        for t in thresholds:\n            pred = probs >= t\n            pred_area = pred.sum((2, 3))\n            intersection = (pred * masks).sum((2, 3))\n\n            dice = (\n                2 * intersection /\n                (pred_area + gt_area).clamp(min=1)\n            )\n\n            r = results[t]\n            r[\"pos_dice\"] += dice[positive].sum().item()\n            r[\"pos_n\"] += positive.sum().item()\n\n            r[\"fp_fraction\"] += (\n                pred_area[empty].sum().item() / (128 * 800)\n            )\n            r[\"empty_n\"] += empty.sum().item()\n            r[\"empty_correct\"] += (\n                (pred_area[empty] == 0).sum().item()\n            )\n\nrows = []\nfor t, r in results.items():\n    foreground_dice = r[\"pos_dice\"] / max(r[\"pos_n\"], 1)\n    fp_score = 1 - r[\"fp_fraction\"] / max(r[\"empty_n\"], 1)\n    empty_accuracy = r[\"empty_correct\"] / max(r[\"empty_n\"], 1)\n\n    official = (\n        0.70 * foreground_dice\n        + 0.20 * fp_score\n        + 0.10 * empty_accuracy\n    )\n\n    naive_dice = (\n        r[\"pos_dice\"] + r[\"empty_correct\"]\n    ) / (r[\"pos_n\"] + r[\"empty_n\"])\n\n    rows.append({\n        \"threshold\": t,\n        \"ForegroundDice\": foreground_dice,\n        \"FalsePositiveScore\": fp_score,\n        \"EmptyAccuracy\": empty_accuracy,\n        \"NaiveMeanDice\": naive_dice,\n        \"OfficialScore\": official\n    })\n\nresults_df = pd.DataFrame(rows)\ndisplay(results_df.round(4))\n\nprint(\"Best naive mean Dice threshold:\",\n      results_df.loc[results_df[\"NaiveMeanDice\"].idxmax(), \"threshold\"])\nprint(\"Best official score threshold:\",\n      results_df.loc[results_df[\"OfficialScore\"].idxmax(), \"threshold\"])\n","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}