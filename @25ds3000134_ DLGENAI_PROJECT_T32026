0.608002</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["    epoch  train_loss  val_loss  val_official_proxy  val_fg_dice\n","15     16    0.288193  0.310110            0.718953     0.603358\n","16     17    0.286440  0.311835            0.717036     0.600717\n","17     18    0.281871  0.307925            0.721400     0.606860\n","18     19    0.284496  0.308588            0.720649     0.605990\n","19     20    0.279846  0.306907            0.722138     0.608002"]},"metadata":{},"output_type":"display_data"}],"source":["EPOCHS_EXTRA = 20        # base training length (only used when no checkpoint exists)\n","EPOCHS_UNETPP = 15\n","LR_EXTRA = 3e-4\n","PATIENCE_EXTRA = 6\n","PROXY_THRESHOLD = 0.25   # close to the tuned thresholds (~0.2) used in the final submission\n","\n","class ModelEMA:\n","    def __init__(self, source_model, decay=0.99):\n","        self.ema = copy.deepcopy(source_model).eval()\n","        self.decay = decay\n","        for parameter in self.ema.parameters():\n","            parameter.requires_grad_(False)\n","\n","    @torch.no_grad()\n","    def update(self, source_model):\n","        source_state = source_model.state_dict()\n","        for key, ema_value in self.ema.state_dict().items():\n","            source_value = source_state[key].detach()\n","            if ema_value.is_floating_point():\n","                ema_value.mul_(self.decay).add_(source_value, alpha=1.0 - self.decay)\n","            else:\n","                ema_value.copy_(source_value)\n","\n","def official_proxy(pa, inter, ga):\n","    \"\"\"Official metric (without gate / min-area) from per-(strip,class) tensors [N,4].\"\"\"\n","    pos, emp = ga > 0, ga == 0\n","    fg = (2 * inter[pos] / (pa[pos] + ga[pos]).clamp(min=1)).mean()\n","    fp = 1 - (pa[emp] / (HEIGHT * WIDTH)).mean()\n","    ea = (pa[emp] == 0).float().mean()\n","    return (0.7 * fg + 0.2 * fp + 0.1 * ea).item(), fg.item()\n","\n","@torch.no_grad()\n","def evaluate_proxy(net_eval, use_amp):\n","    net_eval.eval()\n","    val_total, PA, IN, GA = 0.0, [], [], []\n","    for images, masks in val_loader:\n","        images, masks = images.to(DEVICE), masks.to(DEVICE)\n","        with torch.autocast(device_type=\"cuda\", dtype=torch.float16, enabled=use_amp):\n","            logits = net_eval(images)\n","        logits = logits.float()\n","        val_total += metric_aligned_loss(logits, masks).item()\n","        pred = (torch.sigmoid(logits) >= PROXY_THRESHOLD).float()\n","        PA.append(pred.sum((2, 3)).cpu()); IN.append((pred * masks).sum((2, 3)).cpu()); GA.append(masks.sum((2, 3)).cpu())\n","    score, fg = official_proxy(torch.cat(PA), torch.cat(IN), torch.cat(GA))\n","    return score, fg, val_total / max(1, len(val_loader))\n","\n","def train_pretrained_model(net, model_name, epochs=EPOCHS_EXTRA, lr=LR_EXTRA, init_ckpt=None, pct_start=0.15):\n","    \"\"\"\n","    Trains with AMP + OneCycle + EMA. The checkpoint is chosen on an official-metric proxy.\n","    init_ckpt -> warm start (fine-tuning); the starting weights are scored first and kept unless beaten,\n","    so a fine-tuning stage can never return a worse model than it started with.\n","    Early stopping only after 60% of the schedule (OneCycle needs its low-LR phase).\n","    \"\"\"\n","    use_amp = DEVICE.type == \"cuda\"\n","    best_path = f\"/kaggle/working/{model_name}_best_ema.pth\"\n","\n","    if REUSE_CHECKPOINTS and os.path.exists(best_path):\n","        net.load_state_dict(torch.load(best_path, map_location=DEVICE, weights_only=True))\n","        net.eval()\n","        print(f\"{model_name}: existing checkpoint loaded, training skipped.\")\n","        return net, pd.DataFrame(), best_path\n","\n","    if init_ckpt is not None:\n","        net.load_state_dict(torch.load(init_ckpt, map_location=DEVICE, weights_only=True))\n","\n","    optimizer_extra = torch.optim.AdamW(net.parameters(), lr=lr, weight_decay=1e-4)\n","    scheduler_extra = torch.optim.lr_scheduler.OneCycleLR(\n","        optimizer_extra, max_lr=lr, epochs=epochs, steps_per_epoch=len(train_loader),\n","        pct_start=pct_start, div_factor=10 if init_ckpt else 25, final_div_factor=100\n","    )\n","    scaler = torch.amp.GradScaler(\"cuda\", enabled=use_amp)\n","    ema = ModelEMA(net, decay=0.99)\n","\n","    best_score, history_rows, wait = -1.0, [], 0\n","    if init_ckpt is not None:\n","        best_score, fg0, vl0 = evaluate_proxy(ema.ema, use_amp)\n","        torch.save(ema.ema.state_dict(), best_path)\n","        print(f\"{model_name}: starting point official-proxy={best_score:.4f}, fgDice={fg0:.4f}\")\n","\n","    for epoch in range(epochs):\n","        net.train()\n","        train_total = 0.0\n","        for images, masks in tqdm(train_loader, desc=f\"{model_name} {epoch + 1}/{epochs}\"):\n","            images, masks = images.to(DEVICE, non_blocking=True), masks.to(DEVICE, non_blocking=True)\n","            optimizer_extra.zero_grad(set_to_none=True)\n","            with torch.autocast(device_type=\"cuda\", dtype=torch.float16, enabled=use_amp):\n","                logits = net(images)\n","            loss = metric_aligned_loss(logits, masks)          # float32 inside\n","            scaler.scale(loss).backward()\n","            scaler.unscale_(optimizer_extra)\n","            torch.nn.utils.clip_grad_norm_(net.parameters(), 1.0)\n","            scaler.step(optimizer_extra)\n","            scaler.update()\n","            scheduler_extra.step()\n","            ema.update(net)\n","            train_total += loss.item()\n","\n","        score, fg, val_loss = evaluate_proxy(ema.ema, use_amp)\n","        train_loss = train_total / max(1, len(train_loader))\n","        history_rows.append({\"epoch\": epoch + 1, \"train_loss\": train_loss, \"val_loss\": val_loss,\n","                             \"val_official_proxy\": score, \"val_fg_dice\": fg})\n","        if wandb_run is not None:\n","            wandb_run.log({f\"{model_name}/epoch\": epoch + 1, f\"{model_name}/train_loss\": train_loss,\n","                           f\"{model_name}/val_loss_ema\": val_loss,\n","                           f\"{model_name}/val_official_proxy\": score, f\"{model_name}/val_fg_dice\": fg})\n","        print(f\"{model_name} | epoch {epoch + 1}: train={train_loss:.4f}, val={val_loss:.4f}, \"\n","              f\"official-proxy={score:.4f}, fgDice={fg:.4f}\")\n","\n","        if score > best_score:\n","            best_score, wait = score, 0\n","            torch.save(ema.ema.state_dict(), best_path)\n","        else:\n","            wait += 1\n","            if wait >= PATIENCE_EXTRA and (epoch + 1) >= int(0.6 * epochs):\n","                print(f\"Early stopping {model_name}.\")\n","                break\n","\n","    net.load_state_dict(torch.load(best_path, map_location=DEVICE, weights_only=True))\n","    net.eval()\n","    return net, pd.DataFrame(history_rows), best_path\n","\n","model_fpn, history_fpn, fpn_checkpoint = train_pretrained_model(model_fpn, \"fpn_effb4_x2\", epochs=EPOCHS_EXTRA)\n","display(history_fpn.tail())"]},{"cell_type":"markdown","id":"5194e5c2","metadata":{"papermill":{"duration":0.069112,"end_time":"2026-11-09T06:37:29.60657+00:00","exception":false,"start_time":"2026-11-09T06:37:29.537458+00:00","status":"completed"},"tags":[]},"source":["### Train U-Net++–EfficientNet-B3"]},{"cell_type":"code","execution_count":35,"id":"b6c63278","metadata":{"execution":{"iopub.execute_input":"2026-11-09T06:37:29.744935Z","iopub.status.busy":"2026-11-09T06:37:29.743751Z","iopub.status.idle":"2026-11-09T07:32:47.141808Z","shell.execute_reply":"2026-11-09T07:32:47.140912Z"},"papermill":{"duration":3317.533924,"end_time":"2026-11-09T07:32:47.208365+00:00","exception":false,"start_time":"2026-11-09T06:37:29.674441+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"f1ad467829214222aa3241bf9ae771df","version_major":2,"version_minor":0},"text/plain":["unetpp_effb3 1/1