  <td>9</td>\n","      <td>0.105660</td>\n","      <td>0.112368</td>\n","      <td>0.824113</td>\n","    </tr>\n","    <tr>\n","      <th>9</th>\n","      <td>10</td>\n","      <td>0.103105</td>\n","      <td>0.110578</td>\n","      <td>0.828581</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["   epoch  train_loss  val_loss  val_dice\n","5      6    0.123026  0.107988  0.831145\n","6      7    0.113258  0.106138  0.835914\n","7      8    0.110589  0.107546  0.829016\n","8      9    0.105660  0.112368  0.824113\n","9     10    0.103105  0.110578  0.828581"]},"metadata":{},"output_type":"display_data"}],"execution_count":109},{"cell_type":"markdown","source":"## 8. Validation-time inference, ensemble-weight tuning and two-stage strip-gated post-processing","metadata":{}},{"cell_type":"code","source":"import gc\n\n@torch.no_grad()\ndef predict_tta(net, images):\n    net.eval()\n    p0 = torch.sigmoid(net(images))\n    p1 = torch.flip(torch.sigmoid(net(torch.flip(images, dims=[3]))), dims=[3])\n    p2 = torch.flip(torch.sigmoid(net(torch.flip(images, dims=[2]))), dims=[2])\n    p3 = torch.flip(torch.sigmoid(net(torch.flip(images, dims=[2, 3]))), dims=[2, 3])\n    return (p0 + p1 + p2 + p3) / 4.0\n\n\ndef gated_masks_from_probabilities(probabilities, strip_gate_threshold, pixel_threshold):\n    \"\"\"\n    Two-stage post-processing:\n    1) A strip is accepted if its maximum class/pixel confidence reaches the gate.\n    2) Pixels above the lower threshold are retained only in accepted strips.\n    \"\"\"\n    strip_confidence = probabilities.reshape(len(probabilities), -1).max(axis=1)\n    accepted = strip_confidence >= float(strip_gate_threshold)\n    return (probabilities >= float(pixel_threshold)) & accepted[:, None, None, None]\n\n\n# Store validation maps on disk in float16 to avoid keeping three full prediction\n# tensors in system RAM. This is validation inference only, not extra training.\nn_val = len(val_loader.dataset)\nval_shape = (n_val, len(CLASSES), HEIGHT, WIDTH)\nval_scratch = np.memmap(\n    \"/kaggle/working/val_scratch_float16.dat\", mode=\"w+\", dtype=np.float16, shape=val_shape\n)\nval_fpn = np.memmap(\n    \"/kaggle/working/val_fpn_float16.dat\", mode=\"w+\", dtype=np.float16, shape=val_shape\n)\nval_unetpp = np.memmap(\n    \"/kaggle/working/val_unetpp_float16.dat\", mode=\"w+\", dtype=np.float16, shape=val_shape\n)\nval_truth = np.memmap(\n    \"/kaggle/working/val_masks_uint8.dat\", mode=\"w+\", dtype=np.uint8, shape=val_shape\n)\n\noffset = 0\nwith torch.no_grad():\n    for images, masks in tqdm(val_loader, desc=\"Caching validation predictions\"):\n        images = images.to(DEVICE)\n        batch_n = images.shape[0]\n        end = offset + batch_n\n        val_scratch[offset:end] = predict_tta(model, images).cpu().numpy().astype(np.float16)\n        val_fpn[offset:end] = predict_tta(model_fpn, images).cpu().numpy().astype(np.float16)\n        val_unetpp[offset:end] = predict_tta(model_unetpp, images).cpu().numpy().astype(np.float16)\n        val_truth[offset:end] = masks.numpy().astype(np.uint8)\n        offset = end\n\nfor mmap in (val_scratch, val_fpn, val_unetpp, val_truth):\n    mmap.flush()\nassert offset == n_val, \"Validation prediction count does not match validation dataset.\"\nprint(\"Disk-backed validation maps ready:\", val_shape)\n\n# Try several blends that deliberately keep Scratch U-Net's contribution small.\nweight_candidates = [\n    (0.10, 0.45, 0.45),\n    (0.05, 0.475, 0.475),\n    (0.15, 0.425, 0.425),\n    (0.00, 0.50, 0.50),\n    (0.10, 0.50, 0.40),\n    (0.10, 0.40, 0.50),\n    (0.20, 0.40, 0.40),\n]\ninitial_weights = weight_candidates[0]\nstrip_gate_candidates = [0.30, 0.40, 0.50, 0.60, 0.70, 0.80, 0.90]\npixel_threshold_candidates = [0.05, 0.08, 0.10, 0.12, 0.15, 0.20, 0.25]\n\n\ndef evaluate_blend(weights, gate_threshold, pixel_threshold, chunk_size=16):\n    intersections = np.zeros(len(CLASSES), dtype=np.float64)\n    denominators = np.zeros(len(CLASSES), dtype=np.float64)\n\n    for start in range(0, n_val, chunk_size):\n        end = min(start + chunk_size, n_val)\n        probs = (\n            weights[0] * np.asarray(val_scratch[start:end], dtype=np.float32)\n            + weights[1] * np.asarray(val_fpn[start:end], dtype=np.float32)\n            + weights[2] * np.asarray(val_unetpp[start:end], dtype=np.float32)\n        )\n        truth = np.asarray(val_truth[start:end], dtype=np.float32)\n        preds = gated_masks_from_probabilities(probs, gate_threshold, pixel_threshold)\n        preds = preds.astype(np.float32)\n        intersections += (preds * truth).sum(axis=(0, 2, 3))\n        denominators += preds.sum(axis=(0, 2, 3)) + truth.sum(axis=(0, 2, 3))\n\n    class_scores = (2.0 * intersections + 1.0) / (denominators + 1.0)\n    return float(class_scores.mean()), class_scores\n\n\n# First calibrate gate/pixel thresholds on a conservative 10:45:45 blend.\nthreshold_rows = []\nfor gate_t in strip_gate_candidates:\n    for pixel_t in pixel_threshold_candidates:\n        score, class_scores = evaluate_blend(initial_weights, gate_t, pixel_t)\n        threshold_rows.append({\n            \"scratch_weight\": initial_weights[0],\n            \"fpn_weight\": initial_weights[1],\n            \"unetpp_weight\": initial_weights[2],\n            \"strip_gate_threshold\": gate_t,\n            \"pixel_threshold\": pixel_t,\n            \"mean_dice\": score,\n            **{f\"{cls}_dice\": float(class_scores[i]) for i, cls in enumerate(CLASSES)}\n        })\n\ninitial_results = pd.DataFrame(threshold_rows).sort_values(\n    \"mean_dice\", ascending=False\n).reset_index(drop=True)\ninitial_best = initial_results.iloc[0]\ninitial_gate = float(initial_best[\"strip_gate_threshold\"])\ninitial_pixel = float(initial_best[\"pixel_threshold\"])\n\n# Compare ensemble weights at the selected validation thresholds.\nweight_rows = []\nfor weights in weight_candidates:\n    score, class_scores = evaluate_blend(weights, initial_gate, initial_pixel)\n    weight_rows.append({\n        \"scratch_weight\": weights[0],\n        \"fpn_weight\": weights[1],\n        \"unetpp_weight\": weights[2],\n        \"mean_dice\": score,\n        **{f\"{cls}_dice\": float(class_scores[i]) for i, cls in enumerate(CLASSES)}\n    })\n\nweight_results = pd.DataFrame(weight_rows).sort_values(\n    \"mean_dice\", ascending=False\n).reset_index(drop=True)\ndisplay(weight_results)\nbest_weight_row = weight_results.iloc[0]\nbest_ensemble_weights = (\n    float(best_weight_row[\"scratch_weight\"]),\n    float(best_weight_row[\"fpn_weight\"]),\n    float(best_weight_row[\"unetpp_weight\"]),\n)\nprint(\"Selected ensemble weights (Scratch, FPN, U-Net++):\", best_ensemble_weights)\n\n# Re-tune gate and pixel thresholds for the selected blend.\nthreshold_rows = []\nfor gate_t in strip_gate_candidates:\n    for pixel_t in pixel_threshold_candidates:\n        score, class_scores = evaluate_blend(best_ensemble_weights, gate_t, pixel_t)\n        threshold_rows.append({\n            \"scratch_weight\": best_ensemble_weights[0],\n            \"fpn_weight\": best_ensemble_weights[1],\n            \"unetpp_weight\": best_ensemble_weights[2],\n            \"strip_gate_threshold\": gate_t,\n            \"pixel_threshold\": pixel_t,\n            \"mean_dice\": score,\n            **{f\"{cls}_dice\": float(class_scores[i]) for i, cls in enumerate(CLASSES)}\n        })\n\nthreshold_results = pd.DataFrame(threshold_rows).sort_values(\n    \"mean_dice\", ascending=False\n).reset_index(drop=True)\ndisplay(threshold_results.head(15))\nbest_row = threshold_results.iloc[0]\nbest_strip_gate_threshold = float(best_row[\"strip_gate_threshold\"])\nbest_ensemble_threshold = float(best_row[\"pixel_threshold\"])\nbest_validation_mean_dice = float(best_row[\"mean_dice\"])\n\nprint(\"Selected strip gate:\", best_strip_gate_threshold)\nprint(\"Selected pixel threshold:\", best_ensemble_threshold)\nprint(\"Selected validation mean Dice:\", round(best_va