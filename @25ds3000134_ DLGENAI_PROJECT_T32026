":{},"output_type":"display_data"}],"source":["from sklearn.model_selection import train_test_split\n","\n","# Stratify on the label COMBINATION so rare classes (defect_b) appear in both splits\n","image_data[\"combination\"] = image_data[label_cols].apply(\n","    lambda r: \"+\".join(c.replace(\"_present\", \"\") for c in label_cols if r[c]) or \"clean\", axis=1\n",")\n","train_df, val_df = train_test_split(\n","    image_data, test_size=0.2, random_state=42, shuffle=True,\n","    stratify=image_data[\"combination\"]\n",")\n","\n","# Train on ALL defect-positive strips + a sample of clean strips.\n","# (Clean strips teach the model what \"no defect\" looks like -> far fewer false positives.)\n","is_pos = train_df[label_cols].sum(axis=1) > 0\n","pos_df = train_df.loc[is_pos]\n","clean_df = train_df.loc[~is_pos].sample(n=min(int(0.35 * len(pos_df)), int((~is_pos).sum())), random_state=42)\n","train_df = pd.concat([pos_df, clean_df]).sample(frac=1, random_state=42).reset_index(drop=True)\n","\n","# Validation keeps EVERY strip (clean + defective) so it mirrors the test distribution\n","val_df = val_df.reset_index(drop=True)\n","\n","print(\"Training images:\", len(train_df), f\"(positives {len(pos_df)}, clean {len(clean_df)})\")\n","print(\"Validation images:\", len(val_df))\n","print(\"\\nDefect-positive images in validation:\")\n","display(val_df[label_cols].sum().rename(index=lambda x: x.replace(\"_present\", \"\")))"]},{"cell_type":"markdown","id":"1df2e934","metadata":{"papermill":{"duration":0.038252,"end_time":"2026-11-04T13:07:27.51872+00:00","exception":false,"start_time":"2026-11-04T13:07:27.480468+00:00","status":"completed"},"tags":[]},"source":["# Define image and mask loading"]},{"cell_type":"code","execution_count":15,"id":"114d91d5","metadata":{"execution":{"iopub.execute_input":"2026-11-04T13:07:27.59823Z","iopub.status.busy":"2026-11-04T13:07:27.597451Z","iopub.status.idle":"2026-11-04T13:07:33.688263Z","shell.execute_reply":"2026-11-04T13:07:33.687533Z"},"papermill":{"duration":6.131138,"end_time":"2026-11-04T13:07:33.689933+00:00","exception":false,"start_time":"2026-11-04T13:07:27.558795+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Using device: cuda\n"]}],"source":["import torch\n","from torch.utils.data import Dataset, DataLoader\n","\n","DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n","print(\"Using device:\", DEVICE)\n","\n","HEIGHT, WIDTH = 128, 800\n","\n","class DefectDataset(Dataset):\n","    \"\"\"Returns (RGB image in 0-1, 4 binary masks). augment=True -> flips + brightness/contrast.\"\"\"\n","    def __init__(self, dataframe, augment=False):\n","        df = dataframe.reset_index(drop=True)\n","        self.paths = df[\"image_path\"].tolist()\n","        self.rles = df[CLASSES].values.tolist()\n","        self.augment = augment\n","\n","    def __len__(self):\n","        return len(self.paths)\n","\n","    def __getitem__(self, idx):\n","        image = cv2.imread(self.paths[idx])\n","        if image is None:\n","            raise FileNotFoundError(self.paths[idx])\n","        image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n","        image = cv2.resize(image, (WIDTH, HEIGHT)).astype(np.float32) / 255.0\n","\n","        masks = np.stack([decode_rle(r, HEIGHT, WIDTH) for r in self.rles[idx]], axis=0).astype(np.float32)\n","\n","        if self.augment:\n","            if random.random() < 0.5:                      # horizontal flip\n","                image, masks = image[:, ::-1], masks[:, :, ::-1]\n","            if random.random() < 0.5:                      # vertical flip\n","                image, masks = image[::-1], masks[:, ::-1]\n","            if random.random() < 0.5:                      # brightness / contrast\n","                image = np.clip(image * random.uniform(0.8, 1.2) + random.uniform(-0.08, 0.08), 0, 1)\n","\n","        image = torch.from_numpy(np.ascontiguousarray(image.transpose(2, 0, 1)))\n","        masks = torch.from_numpy(np.ascontiguousarray(masks))\n","        return image, masks"]},{"cell_type":"markdown","id":"b5dea00c","metadata":{"papermill":{"duration":0.03618,"end_time":"2026-11-04T13:07:33.765833+00:00","exception":false,"start_time":"2026-11-04T13:07:33.729653+00:00","status":"completed"},"tags":[]},"source":["# 15. Create DataLoaders"]},{"cell_type":"code","execution_count":16,"id":"21aca21c","metadata":{"execution":{"iopub.execute_input":"2026-11-04T13:07:33.840484Z","iopub.status.busy":"2026-11-04T13:07:33.839269Z","iopub.status.idle":"2026-11-04T13:07:33.862751Z","shell.execute_reply":"2026-11-04T13:07:33.861853Z"},"papermill":{"duration":0.062475,"end_time":"2026-11-04T13:07:33.864202+00:00","exception":false,"start_time":"2026-11-04T13:07:33.801727+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Training batches: 793\n","Validation batches: 143\n"]}],"source":["from torch.utils.data import WeightedRandomSampler\n","\n","BATCH_SIZE = 8\n","\n","train_dataset = DefectDataset(train_df, augment=True)\n","val_dataset = DefectDataset(val_df, augment=False)\n","\n","# Oversample strips containing the rare classes (defect_a, defect_b). Each class counts equally\n","# in the foreground-Dice part of the metric per positive strip, so rare ones must be seen more often.\n","sample_weights = (1.0\n","                  + 1.5 * train_df[\"defect_a_present\"].values\n","                  + 3.0 * train_df[\"defect_b_present\"].values)\n","train_sampler = WeightedRandomSampler(\n","    torch.as_tensor(sample_weights, dtype=torch.double), num_samples=len(train_df), replacement=True\n",")\n","\n","train_loader = DataLoader(\n","    train_dataset, batch_size=BATCH_SIZE, sampler=train_sampler, drop_last=True,\n","    num_workers=2, pin_memory=torch.cuda.is_available(), persistent_workers=True\n",")\n","val_loader = DataLoader(\n","    val_dataset, batch_size=BATCH_SIZE * 2, shuffle=False,\n","    num