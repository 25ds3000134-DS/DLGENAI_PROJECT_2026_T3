ch.nn as nn\n","import torch.nn.functional as F\n","from tqdm.auto import tqdm\n","\n","class PretrainedSegmentationModel(nn.Module):\n","    def __init__(self, network, scale=1):\n","        super().__init__()\n","        self.network = network\n","        self.scale = int(scale)          # vertical up-scaling factor used inside the model\n","        self.register_buffer(\"mean\", torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1))\n","        self.register_buffer(\"std\", torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1))\n","\n","    def forward(self, images):\n","        x = (images - self.mean) / self.std\n","        if self.scale > 1:\n","            x = F.interpolate(x, scale_factor=(self.scale, 1), mode=\"bilinear\", align_corners=False)\n","        out = self.network(x)\n","        if self.scale > 1:\n","            out = F.avg_pool2d(out, kernel_size=(self.scale, 1))\n","        return out\n","\n","model_fpn = PretrainedSegmentationModel(\n","    smp.FPN(encoder_name=\"efficientnet-b4\", encoder_weights=\"imagenet\",\n","            in_channels=3, classes=len(CLASSES), activation=None),\n","    scale=2\n",").to(DEVICE)\n","\n","model_unetpp = PretrainedSegmentationModel(       # unchanged (scale 1) so an existing checkpoint still loads\n","    smp.UnetPlusPlus(encoder_name=\"efficientnet-b3\", encoder_weights=\"imagenet\",\n","                     in_channels=3, classes=len(CLASSES), activation=None),\n","    scale=1\n",").to(DEVICE)\n","\n","model_unet_r34 = PretrainedSegmentationModel(\n","    smp.Unet(encoder_name=\"resnet34\", encoder_weights=\"imagenet\",\n","             in_channels=3, classes=len(CLASSES), activation=None),\n","    scale=2\n",").to(DEVICE)\n","\n","print(\"FPN-EfficientNet-B4 (x2), U-Net++-EfficientNet-B3 (x1) and U-Net-ResNet34 (x2) are ready.\")"]},{"cell_type":"markdown","id":"b40ad7d8","metadata":{"papermill":{"duration":0.048396,"end_time":"2026-11-04T14:17:23.937955+00:00","exception":false,"start_time":"2026-11-04T14:17: