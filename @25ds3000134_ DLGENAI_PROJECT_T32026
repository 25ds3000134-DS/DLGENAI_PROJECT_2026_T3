t_d      1            0.25  0.0      100   \n","\n","                                                 weights  \n","defect_a                 {'unetpp': 0.5, 'unet_b4': 0.5}  \n","defect_b                                 {'unetpp': 1.0}  \n","defect_c  {'fpn': 0.33, 'unetpp': 0.33, 'unet_b4': 0.33}  \n","defect_d   {'fpn': 0.25, 'unetpp': 0.5, 'unet_b4': 0.25}  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["Per-class diagnostics:\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>class</th>\n","      <th>n_positive</th>\n","      <th>fg_dice</th>\n","      <th>detection_recall</th>\n","      <th>dice_when_detected</th>\n","      <th>false_alarm_rate</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>defect_a</td>\n","      <td>216</td>\n","      <td>0.4916</td>\n","      <td>0.7778</td>\n","      <td>0.6321</td>\n","      <td>0.0829</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>defect_b</td>\n","      <td>63</td>\n","      <td>0.4548</td>\n","      <td>0.7143</td>\n","      <td>0.6367</td>\n","      <td>0.0248</td>\n","    </tr>\n","    <tr>\n","      <th>2</th>\n","      <td>defect_c</td>\n","      <td>820</td>\n","      <td>0.6811</td>\n","      <td>0.9305</td>\n","      <td>0.7320</td>\n","      <td>0.1199</td>\n","    </tr>\n","    <tr>\n","      <th>3</th>\n","      <td>defect_d</td>\n","      <td>342</td>\n","      <td>0.7783</td>\n","      <td>0.9386</td>\n","      <td>0.8292</td>\n","      <td>0.0299</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["      class  n_positive  fg_dice  detection_recall  dice_when_detected  \\\n","0  defect_a         216   0.4916            0.7778              0.6321   \n","1  defect_b          63   0.4548            0.7143              0.6367   \n","2  defect_c         820   0.6811            0.9305              0.7320   \n","3  defect_d         342   0.7783            0.9386              0.8292   \n","\n","   false_alarm_rate  \n","0            0.0829  \n","1            0.0248  \n","2            0.1199  \n","3            0.0299  "]},"metadata":{},"output_type":"display_data"},{"data":{"text/plain":["34"]},"execution_count":38,"metadata":{},"output_type":"execute_result"}],"source":["import gc\n","\n","@torch.no_grad()\n","def predict_tta(net, images):\n","    net.eval()\n","    use_amp = DEVICE.type == \"cuda\"\n","    with torch.autocast(device_type=\"cuda\", dtype=torch.float16, enabled=use_amp):\n","        p0 = torch.sigmoid(net(images).float())\n","        p1 = torch.flip(torch.sigmoid(net(torch.flip(images, dims=[3])).float()), dims=[3])\n","        p2 = torch.flip(torch.sigmoid(net(torch.flip(images, dims=[2])).float()), dims=[2])\n","        p3 = torch.flip(torch.sigmoid(net(torch.flip(images, dims=[2, 3])).float()), dims=[2, 3])\n","    return (p0 + p1 + p2 + p3) / 4.0\n","\n","def smooth_probs(p, k):\n","    \"\"\"Mean-filter a probability map [B, C, H, W] (k = 1 -> no smoothing).\"\"\"\n","    return p if k <= 1 else F.avg_pool2d(p, kernel_size=k, stride=1, padding=k // 2, count_include_pad=False)\n","\n","# the scratch U-Net (weak) stays in the project for the report but is not part of the ensemble\n","ensemble_models = {\"fpn\": model_fpn, \"unetpp\": model_unetpp}\n","if RUN_THIRD_MODEL and model_unet_b4 is not None:\n","    ensemble_models[\"unet_b4\"] = model_unet_b4\n","model_names = list(ensemble_models)\n","print(\"Ensemble members:\", model_names)\n","\n","# ---- cache validation probabilities (float16, in RAM: ~1.9 GB per model) -------------------\n","n_val = len(val_loader.dataset)\n","val_shape = (n_val, len(CLASSES), HEIGHT, WIDTH)\n","val_probs = {n: torch.zeros(val_shape, dtype=torch.float16) for n in model_names}\n","val_truth = torch.zeros(val_shape, dtype=torch.uint8)\n","\n","offset = 0\n","with torch.no_grad():\n","    for images, masks in tqdm(val_loader, desc=\"Caching validation predictions\"):\n","        images = images.to(DEVICE)\n","        end = offset + images.shape[0]\n","        for n in model_names:\n","            val_probs[n][offset:end] = predict_tta(ensemble_models[n], images).half().cpu()\n","        val_truth[offset:end] = masks.to(torch.uint8)\n","        offset = end\n","assert offset == n_val\n","print(\"Validation maps ready:\", val_shape)\n","\n","\n","# ---- search space ----------------------------------------------------------------------------\n","HW = HEIGHT * WIDTH\n","SMOOTH = [1, 3, 5]\n","PIX_T = [0.10, 0.15, 0.20, 0.25, 0.30, 0.40, 0.50, 0.60, 0.70]\n","GATES = [0.0, 0.30, 0.40, 0.50, 0.60, 0.70, 0.80, 0.90]\n","AREAS = [0, 50, 100, 200, 400, 800, 1500]\n","\n","def _norm(d):\n","    s = float(sum(d.values())); return {k: v / s for k, v in d.items() if v > 0}\n","\n","weight_candidates, seen = [], set()\n","def _add(d):\n","    d = _norm(d); key = tuple(sorted((k, round(v, 4)) for k, v in d.items()))\n","    if key not in seen: seen.add(key); weight_candidates.append(d)\n","\n","_add({n: 1 for n in model_names})\n","for n in model_names:\n","    _add({n: 1})\n","    _add({**{m: 1 for m in model_names}, n: 2})\n","    if len(model_names) > 2:\n","        _add({m: 1 for m in model_names if m != n})\n","print(len(weight_candidates), \"ensemble-weight candidates\")\n","\n","def blend_stats(weights, chunk=32):\n","    \"\"\"Per (smoothing, threshold, strip, class): predicted area / intersection; per (smoothing, strip, class): max prob.\"\"\"\n","    S, T = len(SMOOTH), len(PIX_T)\n","    pa = np.zeros((S, T, n_val, 4)); inter = np.zeros((S, T, n_val, 4))\n","    mx = np.zeros((S, n_val, 4), np.float32); ga = np.zeros((n_val, 4))\n","    for s0 in range(0, n_val, chunk):\n","        e0 = min(s0 + chunk, n_val)\n","        p = sum(w * val_probs[n][s0:e0].to(DEVICE).float() for n, w in weights.items())\n","        y = val_truth[s0:e0].to(DEVICE).bool()\n","        ga[s0:e0] = y.sum((2, 3)).cpu().numpy()\n","        for si, k in enumerate(SMOOTH):\n","            ps = smooth_probs(p, k)\n","            mx[si, s0:e0] = ps.flatten(2).amax(2).cpu().numpy()\n","            for ti, t in enumerate(PIX_T):\n","                pr = ps >= t\n","                pa[si, ti, s0:e0] = pr.sum((2, 3)).cpu().numpy()\n","                inter[si, ti, s0:e0] = (pr & y).sum((2, 3)).cpu().numpy()\n","    return pa, inter, mx, ga\n","\n","def tune_per_class(stats):\n","    \"\"\"Official score is additive over classes -> tune each class independently. Returns {cls: (score, params)}.\"\"\"\n","    pa, inter, mx, ga = stats\n","    pos, emp = ga > 0, ga == 0\n","    n_pos, n_emp = max(pos.sum(), 1), max(emp.sum(), 1)\n","    out = {}\n","    for c, cls in enumerate(CLASSES):\n","        best = (-1e9, None)\n","        p_, e_, g_ = pos[:, c], emp[:, c], ga[:, c]\n","        for si, k in enumerate(SMOOTH):\n","            for ti, t in enumerate(PIX_T):\n","                pa_c, it_c = pa[si, ti, :, c], inter[si, ti, :, c]\n","                for g in GATES:\n","                    gate_ok = mx[si, :, c] >= g\n","                    for a in AREAS:\n","                        keep = gate_ok & (pa_c >= a)\n","                        pa2 = np.where(keep, pa_c, 0.0); it2 = np.where(keep, it_c, 0.0)\n","                        dice = 2 * it2[p_] / np.maximum(pa2[p_] + g_[p_], 1)\n","                        s = (0.7 * dice.sum() / n_pos\n","                             - 0.2 * (pa2[e_] / HW).sum() / n_emp\n","                             + 0.1 * (pa2[e_] == 0).sum() / n_emp)\n","                        if s > best[0]:\n","                            best = (s, {\"smooth\": k, \"pixel_threshold\": t, \"gate\": g, \"min_area\": a})\n","        out[cls] = best\n","    return out\n","\n","# ---- evaluate every ensemble-weight candidate ---------------------------------------------------\n","cand_stats, cand_class, rows = [], [], []\n","for w in weight_candidates:\n","    st = blend_stats(w)\n","    res = tune_per_class(st)\n","    cand_stats.append(st); cand_class.append(res)\n","    total = 0.2 + sum(v[0] for v in res.values())\n","    rows.append({**{n: round(w.get(n, 0.0), 3) for n in model_names}, \"official_score\": round(total, 4)})\n","    print(f\"{ {k: round(v, 3) for k, v in w.items()} }: official validation score = {total:.4f}\")\n","display(pd.DataFrame(rows).sort_values(\"official_score\", ascending=False).reset_index(drop=True))\n","\n","# ---- choose the best candidate FOR EACH CLASS ---------------------------------------------------------\n","class_weights, class_params, class_cand = {}, {}, {}\n","for cls in CLASSES:\n","    ci = int(np.argmax([cand_class[i][cls][0] for i in range(len(weight_candidates))]))\n","    class_cand[cls] = ci\n","    class_weights[cls] = weight_candidates[ci]\n","    class_params[cls] = cand_class[ci][cls][1]\n","\n","ga_all = cand_stats[0][3]\n","def assemble():\n","    PA = np.zeros_like(ga_all); IN = np.zeros_like(ga_all); MXC = np.zeros_like(ga_all)\n","    for c, cls in enumerate(CLASSES):\n","        pa, inter, mx, _ = cand_stats[class_cand[cls]]\n","        q = class_params[cls]; si = SMOOTH.index(q[\"smooth\"]); ti = PIX_T.index(q[\"pixel_threshold\"])\n","        keep = (mx[si, :, c] >= q[\"gate\"]) & (pa[si, ti, :, c] >= q[\"min_area\"])\n","        PA[:, c] = np.where(keep, pa[si, ti, :, c], 0); IN[:, c] = np.where(keep, inter[si, ti, :, c], 0)\n","    return PA, IN\n","\n","PA, IN = assemble()\n","pos, emp = ga_all > 0, ga_all == 0\n","fg = (2 * IN[pos] / np.maximum(PA[pos] + ga_all[pos], 1)).mean()\n","fp = 1 - (PA[emp] / HW).sum() / max(emp.sum(), 1)\n","ea = (PA[emp] == 0).sum() / max(emp.sum(), 1)\n","best_validation_official = 0.7 * fg + 0.2 * fp + 0.1 * ea\n","print()\n","print(f\"Validation OFFICIAL score {best_validation_official:.4f}  (fgDice {fg:.4f}, FP score {fp:.4f}, empty acc {ea:.4f})\")\n","display(pd.DataFrame({cls: {**class_params[cls], \"weights\": {k: round(v, 2) for k, v in class_weights[cls].items()}} for cls in CLASSES}).T)\n","\n","diag = []\n","for c, cls in enumerate(CLASSES):\n","    p_ = pos[:, c]; pred = PA[:, c] > 0\n","    dice = np.where(p_, 2 * IN[:, c] / np.maximum(PA[:, c] + ga_all[:, c], 1), 0)\n","    diag.append({\"class\": cls, \"n_positive\": int(p_.sum()), \"fg_dice\": dice[p_].mean(),\n","                 \"detection_recall\": (pred & p_).sum() / max(p_.sum(), 1),\n","                 \"dice_when_detected\": dice[p_ & pred].mean() if (p_ & pred).any() else 0.0,\n","                 \"false_alarm_rate\": (pred & ~p_).sum() / max((~p_).sum(), 1)})\n","print(\"Per-class diagnostics:\")\n","display(pd.DataFrame(diag).round(4))\n","\n","best_ensemble_weights = class_weights\n","best_ensemble_threshold = float(np.mean([v[\"pixel_threshold\"] for v in class_params.values()]))\n","best_strip_gate_threshold = float(np.mean([v[\"gate\"] for v in class_params.values()]))\n","best_validation_mean_dice = float(fg)\n","\n","del val_probs, val_truth, cand_stats\n","gc.collect()"]},{"cell_type":"markdown","id":"ba5904bb","metadata":{"papermill":{"duration":0.076952,"end_time":"2026-11-09T10:34:58.339416+00:00","exception":false,"start_time":"2026-11-09T10:34:58.262464+00:00","status":"completed"},"tags":[]},"source":["## 9. Locate test images using the original competition IDs\n","\n","This follows the previous notebook's approach: read the competition `sample_submission.csv`, find test images by their filename stems, and preserve the sample submission row order exactly."]},{"cell_type":"code","execution_count":39,"id":"f2bde4b7","metadata":{"execution":{"iopub.execute_input":"2026-11-09T10:34:58.4990