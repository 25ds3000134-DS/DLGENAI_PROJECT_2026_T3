rediction_cache, cursor = {}, 0\n","with torch.no_grad():\n","    for images, _ in tqdm(test_loader, desc=\"Predicting test images\"):\n","        images = images.to(DEVICE)\n","        prob_by_model = {n: predict_tta(ensemble_models[n], images) for n in needed_models}\n","        masks_bool = class_masks_from_models(prob_by_model)\n","        for b in range(len(images)):\n","            image_id = unique_test_ids[cursor]; cursor += 1\n","            prediction_cache[image_id] = {cls: encode_rle(masks_bool[b, ci]) for ci, cls in enumerate(CLASSES)}\n","assert cursor == len(unique_test_ids)\n","\n","# ---- build the file exactly like sample_submission.csv ------------------------------------------\n","submission = sample_submission.copy()\n","submission[\"image_id\"] = submission[\"image_id\"].astype(str)\n","submission[\"defect_type\"] = submission[\"defect_type\"].astype(str)\n","submission[\"mask_rle\"] = [\n","    prediction_cache[i][d].strip() or \" \"          # sample format: empty mask is a single space\n","    for i, d in zip(submission[\"image_id\"], submission[\"defect_type\"])\n","]\n","submission = submission[[\"ID\", \"image_id\", \"defect_type\", \"mask_rle\"]]\n","\n","assert len(submission) == len(sample_submission) == 12000\n","assert (submission[\"ID\"].values == sample_submission[\"ID\"].values).all()\n","assert (submission[\"image_id\"].values == sample_submission[\"image_id\"].astype(str).values).all()\n","assert (submission[\"defect_type\"].values == sample_submission[\"defect_type\"].values).all()\n","assert submission[\"mask_rle\"].notna().all()\n","\n","output_path = \"/kaggle/working/submission.csv\"\n","submission.to_csv(output_path, index=False, quoting=csv.QUOTE_ALL)\n","\n","with open(output_path) as f:\n","    print(\"First lines of the file:\"); [print(\"  \", next(f).rstrip()[:110]) for _ in range(5)]\n","non_empty = (submission[\"mask_rle\"].str.strip() != \"\")\n","print()\n","print(\"Rows:\", len(submission), \"| unique images:\",