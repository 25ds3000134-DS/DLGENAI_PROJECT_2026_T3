 = images.cpu().numpy()\nmasks = masks.numpy()\n\nfig, axes = plt.subplots(3, 3, figsize=(15, 10))\n\nfor i in range(3):\n    image = images[i].transpose(1, 2, 0)\n    true_mask = masks[i].max(axis=0)\n    pred_mask = (probabilities[i] >= 0.5).max(axis=0)\n\n    axes[i, 0].imshow(image)\n    axes[i, 0].set_title(\"Image\")\n\n    axes[i, 1].imshow(true_mask, cmap=\"gray\")\n    axes[i, 1].set_title(\"True Defects\")\n\n    axes[i, 2].imshow(pred_mask, cmap=\"gray\")\n    axes[i, 2].set_title(\"Predicted Defects\")\n\n    for ax in axes[i]:\n        ax.axis(\"off\")\n\nplt.tight_layout()\nplt.show()","metadata":{"execution":{"iopub.execute_input":"2026-11-05T08:30:46.468969Z","iopub.status.busy":"2026-11-05T08:30:46.468407Z","iopub.status.idle":"2026-11-05T08:30:47.306555Z","shell.execute_reply":"2026-11-05T08:30:47.305797Z"},"papermill":{"duration":0.897742,"end_time":"2026-11-05T08:30:47.309883+00:00","exception":false,"start_time":"2026-11-05T08:30:46.412141+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# 24. Evaluate Dice for each defect class","metadata":{"papermill":{"duration":0.056438,"end_time":"2026-11-05T08:30:47.425277+00:00","exception":false,"start_time":"2026-11-05T08:30:47.368839+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"class_scores = {}\n\nwith torch.no_grad():\n    for cls_idx, cls in enumerate(CLASSES):\n        intersections = 0\n        totals = 0\n\n        for images, masks in val_loader:\n            images = images.to(DEVICE)\n            probs = torch.sigmoid(model(images))[:, cls_idx]\n            preds = (probs >= 0.5).float()\n            targets = masks[:, cls_idx].to(DEVICE)\n\n            intersections += (preds * targets).sum().item()\n            totals += preds.sum().item() + targets.sum().item()\n\n        class_scores[cls] = (\n            2 * intersections + 1\n        ) / (totals + 1)\n\nprint(\"Per-class validation Dice:\")\ndisplay(pd.Series(class_scores, name=\"Dice Score\").to_frame())","metadata":{"execution":{"iopub.execute_input":"2026-11-05T08:30:47.538955Z","iopub.status.busy":"2026-11-05T08:30:47.538246Z","iopub.status.idle":"2026-11-05T08:32:22.459076Z","shell.execute_reply":"2026-11-05T08:32:22.458315Z"},"papermill":{"duration":95.044121,"end_time":"2026-11-05T08:32:22.525202+00:00","exception":false,"start_time":"2026-11-05T08:30:47.481081+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# import dill\n# # Save the entire notebook session state\n# dill.dump_session('/kaggle/working/notebook_env.db')\n","metadata":{"execution":{"iopub.execute_input":"2026-11-05T08:32:22.641177Z","iopub.status.busy":"2026-11-05T08:32:22.640383Z","iopub.status.idle":"2026-11-05T08:32:22.644138Z","shell.execute_reply":"2026-11-05T08:32:22.643481Z"},"papermill":{"duration":0.063061,"end_time":"2026-11-05T08:32:22.645607+00:00","exception":false,"start_time":"2026-11-05T08:32:22.582546+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# import dill\n# # Restore everything back into memory\n# dill.load_session('/kaggle/working/notebook_env.db')\n","metadata":{"execution":{"iopub.execute_input":"2026-11-05T08:32:22.76791Z","iopub.status.busy":"2026-11-05T08:32:22.767191Z","iopub.status.idle":"2026-11-05T08:32:22.770719Z","shell.execute_reply":"2026-11-05T08:32:22.770152Z"},"papermill":{"duration":0.067043,"end_time":"2026-11-05T08:32:22.772222+00:00","exception":false,"start_time":"2026-11-05T08:32:22.705179+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# 25. Tune Model 1's prediction threshold","metadata":{"papermill":{"duration":0.056197,"end_time":"2026-11-05T08:32:22.885396+00:00","exception":false,"start_time":"2026-11-05T08:32:22.829199+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"thresholds = [0.20, 0.30, 0.40, 0.50, 0.60]\nthreshold_results = []\n\nmodel.eval()\n\nwith torch.no_grad():\n    for threshold in thresholds:\n        intersection = torch.zeros(len(CLASSES), device=DEVICE)\n        denominator = torch.zeros(len(CLASSES), device=DEVICE)\n\n        for images, masks in val_loader:\n            images = images.to(DEVICE)\n            masks = masks.to(DEVICE)\n\n            probs = torch.sigmoid(model(images))\n            preds = (probs >= threshold).float()\n\n            intersection += (preds * masks).sum(dim=(0, 2, 3))\n            denominator += preds.sum(dim=(0, 2, 3)) + masks.sum(dim=(0, 2, 3))\n\n        dice = (2 * intersection + 1) / (denominator + 1)\n\n        threshold_results.append({\n            \"threshold\": threshold,\n            \"mean_dice\": dice.mean().item()\n        })\n\nthreshold_df = pd.DataFrame(threshold_results)\ndisplay(threshold_df)\n\nbest_threshold = float(\n    threshold_df.loc[threshold_df[\"mean_dice\"].idxmax(), \"threshold\"]\n)\nprint(\"Best threshold for this diagnostic:\", best_threshold)","metadata":{"execution":{"iopub.execute_input":"2026-11-05T08:32:22.998788Z","iopub.status.busy":"2026-11-05T08:32:22.998375Z","iopub.status.idle":"2026-11-05T08:34:21.987299Z","shell.execute_reply":"2026-11-05T08:34:21.986537Z"},"papermill":{"duration":119.108749,"end_time":"2026-11-05T08:34:22.049059+00:00","exception":false,"start_time":"2026-11-05T08:32:22.94031+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def encode_rle(mask):\n    pixels = np.asarray(mask, dtype=np.uint8).T.flatten()\n    pixels = np.concatenate(([0], pixels, [0]))\n\n    changes = np.where(pixels[1:] != pixels[:-1])[0] + 1\n    changes[1::2] -= changes[::2]\n\n    return \" \".join(map(str, changes))","metadata":{"execution":{"iopub.execute_input":"2026-11-05T08:34:22.165957Z","iopub.status.busy":"2026-11-05T08:34:22.165204Z","iopub.status.idle":"2026-11-05T08:34:22.170247Z","shell.execute_reply":"2026-11-05T08:34:22.169465Z"},"papermill":{"duration":0.064743,"end_time":"2026-11-05T08:34:22.171902+00:00","exception":false,"start_time":"2026-11-05T08:34:22.107159+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 6. Install and configure pretrained segmentation models\n\nThe data paths, image IDs, class names, and submission schema below follow the original `dl-25ds3000137-notebook-t32026 (resformer)` notebook. This version keeps the scratch U-Net and replaces the old ResNet34/ResFormer experiments with FPN–EfficientNet-B4 and U-Net++–EfficientNet-B3.","metadata":{"papermill":{"duration":0.059496,"end_time":"2026-11-05T08:34:22.29008+00:00","exception":false,"start_time":"2026-11-05T08:34:22.230584+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"import segmentation_models_pytorch as smp\nprint('segmentation-models-pytorch:', smp.__version__)","metadata":{"execution":{"iopub.execute_input":"2026-11-05T08:34:22.408159Z","iopub.status.busy":"2026-11-05T08:34:22.407596Z","iopub.status.idle":"2026-11-05T08:34:24.782033Z","shell.execute_reply":"2026-11-05T08:34:24.781066Z"},"papermill":{"duration":2.434904,"end_time":"2026-11-05T08:34:24.783838+00:00","exception":false,"start_time":"2026-11-05T08:34:22.348934+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### Model wrapper, ImageNet normalization and internal vertical up-scaling\n\nFor the FPN and the new U-Net-EfficientNet-B4 the strip is bilinearly up-scaled vertically (x2 -> 256x800) inside the model and the logits are average-pooled back to 128x800, so masks, losses and RLE stay on the original grid.\n\n**Run-time switches** (set in the next cell): `RUN_FINETUNE` warm-restarts the FPN and U-Net++ for more epochs; `RUN_THIRD_MODEL` trains a U-Net-EfficientNet-B4 (replaces the weak ResNet34 model).","metadata":{"papermill":{"duration":0.064839,"end_time":"2026-11-05T08:34:24.91755+00:00","exception":false,"start_time":"2026-11-05T08:34:24.852711+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"import copy\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom tqdm.auto import tqdm\n\nRUN_FINETUNE = True        # warm-restart FPN + U-Net++ (never makes a model worse: best-so-far is kept)\nFT_EPOCHS = 12\nRUN_THIRD_MODEL = True     # U-Net-EfficientNet-B4 (x2)\nTHIRD_EPOCHS = 20\n\nclass PretrainedSegmentationModel(nn.Module):\n    def __init__(self, network, scale=1):\n        super().__init__()\n        self.network = network\n        self.scale = int(scale)\n        self.register_buffer(\"mean\", torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1))\n        self.register_buffer(\"std\", torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1))\n\n    def forward(self, images):\n        x = (images - self.mean) / self.std\n        if self.scale > 1:\n            x = F.interpolate(x, scale_factor=(self.scale, 1), mode=\"bilinear\", align_corners=False)\n        out = self.network(x)\n        if self.scale > 1:\n            out = F.avg_pool2d(out, kernel_size=(self.scale, 1))\n        return out\n\nmodel_fpn = PretrainedSegmentationModel(\n    smp.FPN(encoder_name=\"efficientnet-b4\", encoder_weights=\"imagenet\",\n            in_channels=3, classes=len(CLASSES), activation=None), scale=2\n).to(DEVICE)\n\nmodel_unetpp = PretrainedSegmentationModel(\n    smp.UnetPlusPlus(encoder_name=\"efficientnet-b3\", encoder_weights=\"imagenet\",\n                     in_channels=3, classes=len(CLASSES), activation=None), scale=1\n).to(DEVICE)\n\nmodel_unet_b4 = None\nif RUN_THIRD_MODEL:\n    try:\n        model_unet_b4 = PretrainedSegmentationModel(\n            smp.Unet(encoder_name=\"efficientnet-b4\", encoder_weights=\"imagenet\",\n                     in_channels=3, classes=len(CLASSES), activation=None), scale=2\n        ).to(DEVICE)\n    except Exception as exc:\n        print(\"Third model unavailable, continuing without it:\", str(exc)[:200])\n        RUN_THIRD_MODEL = False\n\nprint(\"FPN-B4 (x2), U-Net++-B3 (x1)\", \"and U-Net-B4 (x2)\" if RUN_THIRD_MODEL else \"(third model off)\", \"are ready.\")","metadata":{"execution":{"iopub.execute_input":"2026-11-05T08:34:25.039432Z","iopub.status.busy":"2026-11-05T08:34:25.038639Z","iopub.status.idle":"2026-11-05T08:34:31.808861Z","shell.execute_reply":"2026-11-05T08:34:31.807923Z"},"papermill":{"duration":6.833012,"end_time":"2026-11-05T08:34:31.810627+00:00","exception":false,"start_time":"2026-11-05T08:34:24.977615+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 7. Train / reuse FPN (x2) and U-Net++, train U-Net-B4 (x2), then warm-restart fine-tuning","metadata":{"papermill":{"duration":0.057637,"end_time":"2026-11-05T08:34:31.92974+00:00","exception":false,"start_time":"2026-11-05T08:34:31.872103+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"EPOCHS_EXTRA = 20        # base training length (only used when no checkpoint exists)\nEPOCHS_UNETPP = 15\nLR_EXTRA = 3e-4\nPATIENCE_EXTRA = 6\nPROXY_THRESHOLD = 0.25   # close to the tuned thresholds (~0.2) used in the final submission\n\nclass ModelEMA:\n    def __init__(self, source_model, decay=0.99):\n        self.ema = copy.deepcopy(source_model).eval()\n        self.decay = decay\n        for parameter in self.ema.parameters():\n            parameter.requires_grad_(False)\n\n    @torch.no_grad()\n    def update(self, source_model):\n        source_state = source_model.state_dict()\n        for key, ema_value in self.ema.state_dict().items():\n            source_value = source_state[key].detach()\n            if ema_value.is_floating_point():\n                ema_value.mul_(self.decay).add_(source_value, alpha=1.0 - self.decay)\n            else:\n                ema_value.copy_(source_value)\n\ndef official_proxy(pa, inter, ga):\n    \"\"\"Official metric (without gate / min-area) from per-(strip,class) tensors [N,4].\"\"\"\n    pos, emp = ga > 0, ga == 0\n    fg = (2 * inter[pos] / (pa[pos] + ga[pos]).clamp(min=1)).mean()\n    fp = 1 - (pa[emp] / (HEIGHT * WIDTH)).mean()\n    ea = (pa[emp] == 0).float().mean()\n    return (0.7 * fg + 0.2 * fp + 0.1 * ea).item(), fg.item()\n\n@torch.no_grad()\ndef evaluate_proxy(net_eval, use_amp):\n    net_eval.eval()\n    val_total, PA, IN, GA = 0.0, [], [], []\n    for images, masks in val_loader:\n        images, masks = images.to(DEVICE), masks.to(DEVICE)\n        with torch.autocast(device_type=\"cuda\", dtype=torch.float16, enabled=use_amp):\n            logits = net_eval(images)\n        logits = logits.float()\n        val_total += metric_aligned_loss(logits, masks).item()\n        pred = (torch.sigmoid(logits) >= PROXY_THRESHOLD).float()\n        PA.append(pred.sum((2, 3)).cpu()); IN.append((pred * masks).sum((2, 3)).cpu()); GA.append(masks.sum((2, 3)).cpu())\n    score, fg = official_proxy(torch.cat(PA), torch.cat(IN), torch.cat(GA))\n    return score, fg, val_total / max(1, len(val_loader))\n\ndef train_pretrained_model(net, model_name, epochs=EPOCHS_EXTRA, lr=LR_EXTRA, init_ckpt=None, pct_start=0.15):\n    \"\"\"\n    Trains with AMP + OneCycle + EMA. The checkpoint is chosen on an official-metric proxy.\n    init_ckpt -> warm start (fine-tuning); the starting weights are scored first and kept unless beaten,\n    so a fine-tuning stage can never return a worse model than it started with.\n    Early stopping only after 60% of the schedule (OneCycle needs its low-LR phase).\n    \"\"\"\n    use_amp = DEVICE.type == \"cuda\"\n    best_path = f\"/kaggle/working/{model_name}_best_ema.pth\"\n\n    if REUSE_CHECKPOINTS and os.path.exists(best_path):\n        net.load_state_dict(torch.load(best_path, map_location=DEVICE, weights_only=True))\n        net.eval()\n        print(f\"{model_name}: existing checkpoint loaded, training skipped.\")\n        return net, pd.DataFrame(), best_path\n\n    if init_ckpt is not None:\n        net.load_state_dict(torch.load(init_ckpt, map_location=DEVICE, weights_only=True))\n\n    optimizer_extra = torch.optim.AdamW(net.parameters(), lr=lr, weight_decay=1e-4)\n    scheduler_extra = torch.optim.lr_scheduler.OneCycleLR(\n        optimizer_extra, max_lr=lr, epochs=epochs, steps_per_epoch=len(train_loader),\n        pct_start=pct_start, div_factor=10 if init_ckpt else 25, final_div_factor=100\n    )\n    scaler = torch.amp.GradScaler(\"cuda\", enabled=use_amp)\n    ema = ModelEMA(net, decay=0.99)\n\n    best_score, history_rows, wait = -1.0, [], 0\n    if init_ckpt is not None:\n        best_score, fg0, vl0 = evaluate_proxy(ema.ema, use_amp)\n        torch.save(ema.ema.state_dict(), best_path)\n        print(f\"{model_name}: starting point official-proxy={best_score:.4f}, fgDice={fg0:.4f}\")\n\n    for epoch in range(epochs):\n        net.train()\n        train_total = 0.0\n        for images, masks in tqdm(train_loader, desc=f\"{model_name} {epoch + 1}/{epochs}\"):\n            images, masks = images.to(DEVICE, non_blocking=True), masks.to(DEVICE, non_blocking=True)\n            optimizer_extra.zero_grad(set_to_none=True)\n            with torch.autocast(device_type=\"cuda\", dtype=torch.float16, enabled=use_amp):\n                logits = net(images)\n            loss = metric_aligned_loss(logits, masks)          # float32 inside\n            scaler.scale(loss).backward()\n            scaler.unscale_(optimizer_extra)\n            torch.nn.utils.clip_grad_norm_(net.parameters(), 1.0)\n            scaler.step(optimizer_extra)\n            scaler.update()\n            scheduler_extra.step()\n            ema.update(net)\n            train_total += loss.item()\n\n        score, fg, val_loss = evaluate_proxy(ema.ema, use_amp)\n        train_loss = train_total / max(1, len(train_loader))\n        history_rows.append({\"epoch\": epoch + 1, \"train_loss\": train_loss, \"val_loss\": val_loss,\n                             \"val_official_proxy\": score, \"val_fg_dice\": fg})\n        if wandb_run is not None:\n            wandb_run.log({f\"{model_name}/epoch\": epoch + 1, f\"{model_name}/train_loss\": train_loss,\n                           f\"{model_name}/val_loss_ema\": val_loss,\n                           f\"{model_name}/val_official_proxy\": score, f\"{model_name}/val_fg_dice\": fg})\n        print(f\"{model_name} | epoch {epoch + 1}: train={train_loss:.4f}, val={val_loss:.4f}, \"\n              f\"official-proxy={score:.4f}, fgDice={fg:.4f}\")\n\n        if score > best_score:\n            best_score, wait = score, 0\n            torch.save(ema.ema.state_dict(), best_path)\n        else:\n            wait += 1\n            if wait >= PATIENCE_EXTRA and (epoch + 1) >= int(0.6 * epochs):\n                print(f\"Early stopping {model_name}.\")\n                break\n\n    net.load_state_dict(torch.load(best_path, map_location=DEVICE, weights_only=True))\n    net.eval()\n    return net, pd.DataFrame(history_rows), best_path\n\nmodel_fpn, history_fpn, fpn_checkpoint = train_pretrained_model(model_fpn, \"fpn_effb4_x2\", epochs=EPOCHS_EXTRA)\ndisplay(history_fpn.tail())","metadata":{"execution":{"iopub.execute_input":"2026-11-05T08:34:32.048565Z","iopub.status.busy":"2026-11-05T08:34:32.048062Z","iopub.status.idle":"2026-11-05T10:00:48.533532Z","shell.execute_reply":"2026-11-05T10:00:48.532686Z"},"papermill":{"duration":5176.579759,"end_time":"2026-11-05T10:00:48.566851+00:00","exception":false,"start_time":"2026-11-05T08:34:31.987092+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### Train U-Net++–EfficientNet-B3","metadata":{"papermill":{"duration":0.062869,"end_time":"2026-11-05T10:00:48.691205+00:00","exception":false,"start_time":"2026-11-05T10:00:48.628336+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"model_unetpp, history_unetpp, unetpp_checkpoint = train_pretrained_model(\n    model_unetpp, 