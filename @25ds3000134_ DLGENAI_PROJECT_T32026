0326,"end_time":"2026-11-04T13:07:35.131087+00:00","exception":false,"start_time":"2026-11-04T13:07:34.980761+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Model parameters: 7,766,084\n"]}],"source":["import torch.nn as nn\n","import torch.nn.functional as F\n","\n","class ConvBlock(nn.Module):\n","    def __init__(self, in_ch, out_ch):\n","        super().__init__()\n","        self.block = nn.Sequential(\n","            nn.Conv2d(in_ch, out_ch, 3, padding=1),\n","            nn.BatchNorm2d(out_ch),\n","            nn.ReLU(inplace=True),\n","            nn.Conv2d(out_ch, out_ch, 3, padding=1),\n","            nn.BatchNorm2d(out_ch),\n","            nn.ReLU(inplace=True)\n","        )\n","\n","    def forward(self, x):\n","        return self.block(x)\n","\n","\n","class UNet(nn.Module):\n","    def __init__(self, out_channels=4):\n","        super().__init__()\n","        self.enc1 = ConvBlock(3, 32)\n","        self.enc2 = ConvBlock(32, 64)\n","        self.enc3 = ConvBlock(64, 128)\n","        self.enc4 = ConvBlock(128, 256)\n","\n","        self.pool = nn.MaxPool2d(2)\n","        self.bottleneck = ConvBlock(256, 512)\n","\n","        self.up4 = nn.ConvTranspose2d(512, 256, 2, stride=2)\n","        self.dec4 = ConvBlock(512, 256)\n","        self.up3 = nn.ConvTranspose2d(256, 128, 2, stride=2)\n","        self.dec3 = ConvBlock(256, 128)\n","        self.up2 = nn.ConvTranspose2d(128, 64, 2, stride=2)\n","        self.dec2 = ConvBlock(128, 64)\n","        self.up1 = nn.ConvTranspose2d(64, 32, 2, stride=2)\n","        self.dec1 = ConvBlock(64, 32)\n","\n","        self.output = nn.Conv2d(32, out_channels, 1)\n","\n","    def forward(self, x):\n","        e1 = self.enc1(x)\n","        e2 = self.enc2(self.pool(e1))\n","        e3 = self.enc3(self.pool(e2))\n","        e4 = self.enc4(self.pool(e3))\n","        b = self.bottleneck(self.pool(e4))\n","\n","        d4 = self.dec4(torch.cat([self.up4(b), e4], dim=1))\n","        d3 = self.dec3(torch.cat([self.up3(d4), e3], dim=1))\n","        d2 = self.dec2(torch.cat([self.up2(d3), e2], dim=1))\n","        d1 = self.dec1(torch.cat([self.up1(d2), e1], dim=1))\n","\n","        return self.output(d1)\n","\n","\n","model = UNet().to(DEVICE)\n","print(\"Model parameters:\", f\"{sum(p.numel() for p in model.parameters()):,}\")"]},{"cell_type":"markdown","id":"0e76c4b6","metadata":{"papermill":{"duration":0.036842,"end_time":"2026-11-04T13:07:35.205966+00:00","exception":false,"start_time":"2026-11-04T13:07:35.169124+00:00","status":"completed"},"tags":[]},"source":["# 18. Define the combined loss and Dice metric"]},{"cell_type":"code","execution_count":19,"id":"8f40c01e","metadata":{"execution":{"iopub.execute_input":"2026-11-04T13:07:35.284789Z","iopub.status.busy":"2026-11-04T13:07:35.284174Z","iopub.status.idle":"2026-11-04T13:07:35.295522Z","shell.execute_reply":"2026-11-04T13:07:35.294538Z"},"papermill":{"duration":0.054122,"end_time":"2026-11-04T13:07:35.297212+00:00","exception":false,"start_time":"2026-11-04T13:07:35.24309+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Independent-sigmoid outputs and BCE + Dice (positive/empty weighted) loss ready.\n"]}],"source":["def metric_aligned_loss(logits, targets, pos_weight=None, eps=1.0):\n","    \"\"\"\n","    BCE + soft-Dice. Dice is computed on every (strip, class) mask:\n","      * positive masks  -> reward overlap            (70% foreground-Dice part of the metric)\n","      * empty masks     -> soft-Dice = 1 - 1/(sum(p)+1), which punishes ANY predicted mass\n","                           (the 20% false-positive + 10% empty-accuracy parts)\n","    Independent sigmoid per class (multi-label), never softmax.\n","    \"\"\"\n","    logits = logits.float()\n","    targets = targets.float()\n","    probs = torch.sigmoid(logits)\n","\n","    p = probs.flatten(2)\n","    t = targets.flatten(2)\n","    dice_loss_map = 1.0 - (2.0 * (p * t).sum(2) + eps) / (p.sum(2) + t.sum(2) + eps)   # [B, 4]\n","    positive = t.sum(2) > 0\n","\n","    fg = dice_loss_map[positive].mean() if positive.any() else probs.mean() * 0.0\n","    empty = dice_loss_map[~positive].mean() if (~positive).any() else probs.mean() * 0.0\n","\n","    if pos_weight is None:\n","        bce = F.binary_cross_entropy_with_logits(logits, targets)\n","    else:\n","        bce = F.binary_cross_entropy_with_logits(logits, targets, pos_weight=pos_weight.view(1, -1, 1, 1))\n","\n","    return bce + 0.7 * fg + 0.3 * empty\n","\n","\n","def dice_loss(logits, targets, smooth=1.0):\n","    probs = torch.sigmoid(logits).flatten(2)\n","    targets = targets.flatten(2)\n","    dice = (2 * (probs * targets).sum(2) + smooth) / (probs.sum(2) + targets.sum(2) + smooth)\n","    return 1 - dice.mean()\n","\n","\n","bce_loss = nn.BCEWithLogitsLoss()\n","\n","def combined_loss(logits, targets):\n","    return metric_aligned_loss(logits, targets)\n","\n","\n","@torch.no_grad()\n","def batch_dice_score(logits, targets, threshold=0.5, smooth=1.0):\n","    preds = (torch.sigmoid(logits.float()) >= threshold).float().flatten(2)\n","    targets = targets.flatten(2)\n","    inter = (preds * targets).sum(2)\n","    den = preds.sum(2) + targets.sum(2)\n","    return ((2 * inter + smooth) / (den + smooth)).mean().item()\n","\n","\n","print(\"Independent-sigmoid outputs and BCE + Dice (positive/empty weighted) loss ready.\")"]},{"cell_type":"markdown","id":"f8d3eebc","metadata":{"papermill":{"duration":0.039915,"end_time":"2026-11-04T13:07:35.380374+00:00","exception":false,"start_time":"2026-11-04T13:07:35.340459+00:00","status":"completed"},"tags":[]},"source":["## 19. Weights & Biases experiment tracking"]},{"cell_type":"code","execution_count":20,"id":"c7e90358","metadata":{"execution":{"iopub.execute_input":"2026-11-04T13:07:35.45513Z","iopub.status.busy":"2026-11-04T13:07:35.454105Z","iopub.status.idle":"2026-11-04T13:07:39.280518Z","shell.execute_reply":"2026