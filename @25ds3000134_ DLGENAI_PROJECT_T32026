>\n","    <tr>\n","      <th>19</th>\n","      <td>20</td>\n","      <td>0.279700</td>\n","      <td>0.302577</td>\n","      <td>0.726331</td>\n","      <td>0.613751</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["    epoch  train_loss  val_loss  val_official_proxy  val_fg_dice\n","15     16    0.292123  0.306253            0.722581     0.608514\n","16     17    0.291976  0.305149            0.723378     0.609394\n","17     18    0.286793  0.306202            0.723088     0.609285\n","18     19    0.280258  0.303366            0.725905     0.613236\n","19     20    0.279700  0.302577            0.726331     0.613751"]},"metadata":{},"output_type":"display_data"}],"source":["EPOCHS_EXTRA = 20        # FPN-B4 (x2) and U-Net-ResNet34 (x2)\n","EPOCHS_UNETPP = 15\n","LR_EXTRA = 3e-4\n","PATIENCE_EXTRA = 6\n","\n","class ModelEMA:\n","    def __init__(self, source_model, decay=0.99):\n","        self.ema = copy.deepcopy(source_model).eval()\n","        self.decay = decay\n","        for parameter in self.ema.parameters():\n","            parameter.requires_grad_(False)\n","\n","    @torch.no_grad()\n","    def update(self, source_model):\n","        source_state = source_model.state_dict()\n","        for key, ema_value in self.ema.state_dict().items():\n","            source_value = source_state[key].detach()\n","            if ema_value.is_floating_point():\n","                ema_value.mul_(self.decay).add_(source_value, alpha=1.0 - self.decay)\n","            else:\n","                ema_value.copy_(source_value)\n","\n","def official_proxy(pa, inter, ga):\n","    \"\"\"Official metric (no min-area / gate) from per-(strip,class) tensors [N,4].\"\"\"\n","    pos, emp = ga > 0, ga == 0\n","    fg = (2 * inter[pos] / (pa[pos] + ga[pos]).clamp(min=1)).mean()\n","    fp = 1 - (pa[emp] / (HEIGHT * WIDTH)).mean()\n","    ea = (pa[emp] == 0).float().mean()\n","    return (0.7 * fg + 0.2 * fp + 0.1 * ea).item(), fg.item()\n","\n","def train_pretrained_model(net, model_name, epochs=EPOCHS_EXTRA, lr=LR_EXTRA):\n","    use_amp = DEVICE.type == \"cuda\"\n","    best_path = f\"/kaggle/working/{model_name}_best_ema.pth\"\n","\n","    if REUSE_CHECKPOINTS and os.path.exists(best_path):\n","        net.load_state_dict(torch.load(best_path, map_location=DEVICE, weights_only=True))\n","        net.eval()\n","        print(f\"{model_name}: existing checkpoint loaded, training skipped.\")\n","        return net, pd.DataFrame(), best_path\n","\n","    optimizer_extra = torch.optim.AdamW(net.parameters(), lr=lr, weight_decay=1e-4)\n","    scheduler_extra = torch.optim.lr_scheduler.OneCycleLR(\n","        optimizer_extra, max_lr=lr, epochs=epochs, steps_per_epoch=len(train_loader), pct_start=0.15\n","    )\n","    scaler = torch.amp.GradScaler(\"cuda\", enabled=use_amp)\n","    ema = ModelEMA(net, decay=0.99)\n","    best_score, history_rows, wait = -1.0, [], 0\n","\n","    for epoch in range(epochs):\n","        net.train()\n","        train_total = 0.0\n","        for images, masks in tqdm(train_loader, desc=f\"{model_name} {epoch + 1}/{epochs}\"):\n","            images, masks = images.to(DEVICE, non_blocking=True), masks.to(DEVICE, non_blocking=True)\n","            optimizer_extra.zero_grad(set_to_none=True)\n","            with torch.autocast(device_type=\"cuda\", dtype=torch.float16, enabled=use_amp):\n","                logits = net(images)\n","            loss = metric_aligned_loss(logits, masks)          # float32 inside\n","            scaler.scale(loss).backward()\n","            scaler.unscale_(optimizer_extra)\n","            torch.nn.utils.clip_grad_norm_(net.parameters(), 1.0)\n","            scaler.step(optimizer_extra)\n","            scaler.update()\n","            scheduler_extra.step()\n","            ema.update(net)\n","            train_total += loss.item()\n","\n","        ema.ema.eval()\n","        val_total, PA, IN, GA = 0.0, [], [], []\n","        with torch.no_grad():\n","            for images, masks in val_loader:\n","                images, masks = images.to(DEVICE), masks.to(DEVICE)\n","                with torch.autocast(device_type=\"cuda\", dtype=torch.float16, enabled=use_amp):\n","                    logits = ema.ema(images)\n","                logits = logits.float()\n","                val_total += metric_aligned_loss(logits, masks).item()\n","                pred = (torch.sigmoid(logits) >= 0.4).float()\n","                PA.append(pred.sum((2, 3)).cpu()); IN.append((pred * masks).sum((2, 3)).cpu()); GA.append(masks.sum((2, 3)).cpu())\n","\n","        score, fg = official_proxy(torch.cat(PA), torch.cat(IN), torch.cat(GA))\n","        train_loss, val_loss = train_total / max(1, len(train_loader)), val_total / max(1, len(val_loader))\n","        history_rows.append({\"epoch\": epoch + 1, \"train_loss\": train_loss, \"val_loss\": val_loss,\n","                             \"val_official_proxy\": score, \"val_fg_dice\": fg})\n","\n","        if wandb_run is not None:\n","            wandb_run.log({f\"{model_name}/epoch\": epoch + 1, f\"{model_name}/train_loss\": train_loss,\n","                           f\"{model_name}/val_loss_ema\": val_loss,\n","                           f\"{model_name}/val_official_proxy\": score, f\"{model_name}/val_fg_dice\": fg})\n","\n","        print(f\"{model_name} | epoch {epoch + 1}: train={train_loss:.4f}, val={val_loss:.4f}, \"\n","              f\"official-proxy={score:.4f}, fgDice={fg:.4f}\")\n","        if score > best_score:\n","            best_score, wait = score, 0\n","            torch.save(ema.ema.state_dict(), best_path)\n","        else:\n","            wait += 1\n","            if wait >= PATIENCE_EXTRA:\n","                print(f\"Early stopping {model_name}.\")\n","                break\n","\n","    net.load_state_dict(torch.load(best_path, map_location=DEVICE, weights_only=True))\n","    net.eval()\n","    return net, pd.DataFrame(history_rows), best_path\n","\n","model_fpn, history_fpn, fpn_checkpoint = train_pretrained_model(model_fpn, \"fpn_effb4_x2\")\n","display(history_fpn.tail())"]},{"cell_type":"markdown","id":"932fa24f","metadata":{"papermill":{"duration":0.051707,"end_time":"2026-11-04T15:44:54.238408+00:00","exception":false,"start_time":"2026-11-04T15:44:54.186701+00:00","status":"completed"},"tags":[]},"source":["### Train U-Net++–EfficientNet-B3"]},{"cell_type":"code","execution_count":35,"id":"d000201a","metadata":{"execution":{"iopub.execute_input":"2026-11-04T15:44:54.342514Z","iopub.status.busy":"2026-11-04T15:44:54.342164Z","iopub.status.idle":"2026-11-04T16:38:51.775747Z","shell.execute_reply":"2026-11-04T16:38:51.774983Z"},"papermill":{"duration":3237.543154,"end_time":"2026-11-04T16:38:51.831731+00:00","exception":false,"start_time":"2026-11-04T15:44:54.288577+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"45308789eab943f3868a8fd2772110fd","version_major":2,"version_minor":0},"text/plain":["unetpp_effb3 1/15:   0%|          | 0/793 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["unetpp_effb3 | epoch 1: train=1.4829, val=1.0839, official-proxy=0.4993, fgDice=0.4319\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"4ac79dff036b4ef99898eb46fe11a5e9","version_major":2,"version_minor":0},"text/plain":["unetpp_effb3 2/15:   0%|          | 0/793 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["unetpp_effb3 | epoch 2: train=0.8294, val=0.6542, official-proxy=0.6369, fgDice=0.5837\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"d7b44567777945768d3dff6800972d33","version_major":2,"version_minor":0},"text/plain":["unetpp_effb3 3/15:   0%|          | 0/793 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["unetpp_effb3 | epoch 3: train=0.6809, val=0.6064, 