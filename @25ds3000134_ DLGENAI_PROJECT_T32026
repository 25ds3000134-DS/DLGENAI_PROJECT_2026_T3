  for parameter in self.ema.parameters():\n            parameter.requires_grad_(False)\n\n    @torch.no_grad()\n    def update(self, source_model):\n        source_state = source_model.state_dict()\n        for key, ema_value in self.ema.state_dict().items():\n            source_value = source_state[key].detach()\n            if ema_value.is_floating_point():\n                ema_value.mul_(self.decay).add_(source_value, alpha=1.0 - self.decay)\n            else:\n                ema_value.copy_(source_value)\n\ndef train_pretrained_model(net, model_name, epochs=EPOCHS_EXTRA, lr=LR_EXTRA):\n    optimizer_extra = torch.optim.AdamW(net.parameters(), lr=lr, weight_decay=1e-4)\n    scheduler_extra = torch.optim.lr_scheduler.ReduceLROnPlateau(\n        optimizer_extra, mode=\"min\", factor=0.5, patience=2\n    )\n    ema = ModelEMA(net, decay=0.99)\n    best_val_loss = float(\"inf\")\n    best_path = f\"/kaggle/working/{model_name}_best_ema.pth\"\n    history_rows = []\n    wait = 0\n\n    for epoch in range(epochs):\n        net.train()\n        train_total = 0.0\n        for images, masks in tqdm(train_loader, desc=f\"{model_name} {epoch + 1}/{epochs}\"):\n            images, masks = images.to(DEVICE), masks.to(DEVICE)\n            optimizer_extra.zero_grad(set_to_none=True)\n            loss = metric_aligned_loss(net(images), masks)\n            loss.backward()\n            torch.nn.utils.clip_grad_norm_(net.parameters(), 1.0)\n            optimizer_extra.step()\n            ema.update(net)\n            train_total += loss.item()\n\n        ema.ema.eval()\n        val_total, dice_total = 0.0, 0.0\n        with torch.no_grad():\n            for images, masks in val_loader:\n                images, masks = images.to(DEVICE), masks.to(DEVICE)\n                logits = ema.ema(images)\n                val_total += metric_aligned_loss(logits, masks).item()\n                dice_total += batch_dice_score(logits, masks)\n\n        train_loss = train_total / max(1, len(train_loader))\n        val_loss = val_total / max(1, len(val_loader))\n        val_dice = dice_total / max(1, len(val_loader))\n        scheduler_extra.step(val_loss)\n        history_rows.append({\n            \"epoch\": epoch + 1, \"train_loss\": train_loss,\n            \"val_loss\": val_loss, \"val_dice\": val_dice\n        })\n\n        if wandb_run is not None:\n            wandb_run.log({\n                f\"{model_name}/epoch\": epoch + 1,\n                f\"{model_name}/train_loss\": train_loss,\n                f\"{model_name}/val_loss_ema\": val_loss,\n                f\"{model_name}/val_dice_ema\": val_dice\n            })\n\n        print(f\"{model_name} | epoch {epoch + 1}: train={train_loss:.4f}, val={val_loss:.4f}, EMA Dice={val_dice:.4f}\")\n        if val_loss < best_val_loss:\n            best_val_loss = val_loss\n            wait = 0\n            torch.save(ema.ema.state_dict(), best_path)\n        else:\n            wait += 1\n            if wait >= PATIENCE_EXTRA:\n                print(f\"Early stopping {model_name}.\")\n                break\n\n    if not os.path.exists(best_path):\n        raise RuntimeError(f\"No best checkpoint was saved for {model_name}.\")\n    net.load_state_dict(torch.load(best_path, map_location=DEVICE, weights_only=True))\n    net.eval()\n    return net, pd.DataFrame(history_rows), best_path\n\nmodel_fpn, history_fpn, fpn_checkpoint = train_pretrained_model(model_fpn, \"fpn_effb4\")\ndisplay(history_fpn.tail())\n","metadata":{"execution":{"iopub.execute_input":"2026-10-29T16:39:29.615144Z","iopub.status.busy":"2026-10-29T16:39:29.614345Z","iopub.status.idle":"2026-10-29T17:10:43.327206Z","shell.execute_reply":"2026-10-29T17:10:43.326552Z","shell.execute_reply.started":"2026-10-29T16:39:29.615112Z"}},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"d12d9c4acc3b480b8e10a8cdc64a6aeb","version_major":2,"version_minor":0},"text/plain":["fpn_effb4 1/12:   0%|          | 0/1187 [00:00<?, ?it/s]"]},"me