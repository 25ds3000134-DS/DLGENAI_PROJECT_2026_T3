p(image * random.uniform(0.8, 1.2) + random.uniform(-0.08, 0.08), 0, 1)\n\n        image = torch.from_numpy(np.ascontiguousarray(image.transpose(2, 0, 1)))\n        masks = torch.from_numpy(np.ascontiguousarray(masks))\n        return image, masks","metadata":{"execution":{"iopub.execute_input":"2026-11-05T07:27:01.64643Z","iopub.status.busy":"2026-11-05T07:27:01.645657Z","iopub.status.idle":"2026-11-05T07:27:08.067366Z","shell.execute_reply":"2026-11-05T07:27:08.066457Z"},"papermill":{"duration":6.470947,"end_time":"2026-11-05T07:27:08.068929+00:00","exception":false,"start_time":"2026-11-05T07:27:01.597982+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# 15. Create DataLoaders","metadata":{"papermill":{"duration":0.04219,"end_time":"2026-11-05T07:27:08.156392+00:00","exception":false,"start_time":"2026-11-05T07:27:08.114202+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"from torch.utils.data import WeightedRandomSampler\n\nBATCH_SIZE = 8\n\ntrain_dataset = DefectDataset(train_df, augment=True)\nval_dataset = DefectDataset(val_df, augment=False)\n\n# Oversample strips containing the rare classes (defect_a, defect_b). Each class counts equally\n# in the foreground-Dice part of the metric per positive strip, so rare ones must be seen more often.\nsample_weights = (1.0\n                  + 1.5 * train_df[\"defect_a_present\"].values\n                  + 3.0 * train_df[\"defect_b_present\"].values)\ntrain_sampler = WeightedRandomSampler(\n    torch.as_tensor(sample_weights, dtype=torch.double), num_samples=len(train_df), replacement=True\n)\n\ntrain_loader = DataLoader(\n    train_dataset, batch_size=BATCH_SIZE, sampler=train_sampler, drop_last=True,\n    num_workers=2, pin_memory=torch.cuda.is_available(), persistent_workers=True\n)\nval_loader = DataLoader(\n    val_dataset, batch_size=BATCH_SIZE * 2, shuffle=False,\n    num_workers=2, pin_memory=torch.cuda.is_available(), persist