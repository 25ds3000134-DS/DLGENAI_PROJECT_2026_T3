 self.scale = int(scale)\n","        self.register_buffer(\"mean\", torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1))\n","        self.register_buffer(\"std\", torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1))\n","\n","    def forward(self, images):\n","        x = (images - self.mean) / self.std\n","        if self.scale > 1:\n","            x = F.interpolate(x, scale_factor=(self.scale, 1), mode=\"bilinear\", align_corners=False)\n","        out = self.network(x)\n","        if self.scale > 1:\n","            out = F.avg_pool2d(out, kernel_size=(self.scale, 1))\n","        return out\n","\n","model_fpn = PretrainedSegmentationModel(\n","    smp.FPN(encoder_name=\"efficientnet-b4\", encoder_weights=\"imagenet\",\n","            in_channels=3, classes=len(CLASSES), activation=None), scale=2\n",").to(DEVICE)\n","\n","model_unetpp = PretrainedSegmentationModel(\n","    smp.UnetPlusPlus(encoder_name=\"efficientnet-b3\", encoder_weights=\"imagenet\",\n","                     in_channels=3, classes=len(CLASSES), activation=None), scale=1\n",").to(DEVICE)\n","\n","model_unet_b4 = None\n","if RUN_THIRD_MODEL:\n","    try:\n","        model_unet_b4 = PretrainedSegmentationModel(\n","            smp.Unet(encoder_name=\"efficientnet-b4\", encoder_weights=\"imagenet\",\n","                     in_channels=3, classes=len(CLASSES), activation=None), scale=2\n","        ).to(DEVICE)\n","    except Exception as exc:\n","        print(\"Third model unavailable, continuing without it:\", str(exc)[:200])\n","        RUN_THIRD_MODEL = False\n","\n","print(\"FPN-B4 (x2), U-Net++-B3 (x1)\", \"and U-Net-B4 (x2)\" if RUN_THIRD_MODEL else \"(third model off)\", \"are ready.\")"]},{"cell_type":"markdown","id":"f5857193","metadata":{"papermill":{"duration":0.05775,"end_time":"2026-11-09T05:09:25.758702+00:00","exception":false,"start_time":"2026-11-09T05:09:25.700952+00:00","status":"completed"},"tags":[]},"source":["## 7. Train / reuse FPN (x2) and U-Net++, train U-Net-B4 (x2), then