n":0.063762,"end_time":"2026-11-05T12:34:39.648339+00:00","exception":false,"start_time":"2026-11-05T12:34:39.584577+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"history_fpn_ft, history_unetpp_ft = pd.DataFrame(), pd.DataFrame()\nif RUN_FINETUNE:\n    model_fpn, history_fpn_ft, fpn_checkpoint = train_pretrained_model(\n        model_fpn, \"fpn_effb4_x2_ft\", epochs=FT_EPOCHS, lr=1e-4, init_ckpt=fpn_checkpoint, pct_start=0.1\n    )\n    display(history_fpn_ft.tail())\n    model_unetpp, history_unetpp_ft, unetpp_checkpoint = train_pretrained_model(\n        model_unetpp, \"unetpp_effb3_ft\", epochs=FT_EPOCHS, lr=1e-4, init_ckpt=unetpp_checkpoint, pct_start=0.1\n    )\n    display(history_unetpp_ft.tail())\nelse:\n    print(\"Fine-tuning skipped (RUN_FINETUNE = False).\")","metadata":{"execution":{"iopub.execute_input":"2026-11-05T12:34:39.778326Z","iopub.status.busy":"2026-11-05T12:34:39.777825Z","iopub.status.idle":"2026-11-05T14:05:35.65087Z","shell.execute_reply":"2026-11-05T14:05:35.650003Z"},"papermill":{"duration":5456.00258,"end_time":"2026-11-05T14:05:35.71457+00:00","exception":false,"start_time":"2026-11-05T12:34:39.71199+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 8. Validation inference, per-class ensemble and post-processing tuned on the OFFICIAL metric\n\nValidation probabilities (4-way flip TTA) are cached for every ensemble model. The official score is additive over classes, so **each class gets its own** ensemble weights, probability smoothing (1/3/5 px), pixel threshold, strip gate (max prob needed to report the class) and minimum area, all maximising 0.7 x foreground Dice + 0.2 x FP score + 0.1 x empty accuracy on the full validation split.","metadata":{"papermill":{"duration":0.067859,"end_time":"2026-11-05T14:05:35.854496+00:00","exception":false,"start_time":"2026-11-05T14:05:35.786637+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"import gc\n\n@torch.no_grad()\ndef predict_tta(net, images):\n    net.eval()\n    use_amp = DEVICE.type == \"cuda\"\n    with torch.autocast(device_type=\"cuda\", dtype=torch.float16, enabled=use_amp):\n        p0 = torch.sigmoid(net(images).float())\n        p1 = torch.flip(torch.sigmoid(net(torch.flip(images, dims=[3])).float()), dims=[3])\n        p2 = torch.flip(torch.sigmoid(net(torch.flip(images, dims=[2])).float()), dims=[2])\n        p3 = torch.flip(torch.sigmoid(net(torch.flip(images, dims=[2, 3])).float()), dims=[2, 3])\n    return (p0 + p1 + p2 + p3) / 4.0\n\ndef smooth_probs(p, k):\n    \"\"\"Mean-filter a probability map [B, C, H, W] (k = 1 -> no smoothing).\"\"\"\n    return p if k <= 1 else F.avg_pool2d(p, kernel_size=k, stride=1, padding=k // 2, count_include_pad=False)\n\n# the scratch U-Net (weak) stays in the project for the report but is not part of the ensemble\nensemble_models = {\"fpn\": model_fpn, \"unetpp\": model_unetpp}\nif RUN_THIRD_MODEL and model_unet_b4 is not None:\n    ensemble_models[\"unet_b4\"] = model_unet_b4\nmodel_names = list(ensemble_models)\nprint(\"Ensemble members:\", model_names)\n\n# ---- cache validation probabilities (float16, in RAM: ~1.9 GB per model) -------------------\nn_val = len(val_loader.dataset)\nval_shape = (n_val, len(CLASSES), HEIGHT, WIDTH)\nval_probs = {n: torch.zeros(val_shape, dtype=torch.float16) for n in model_names}\nval_truth = torch.zeros(val_shape, dtype=torch.uint8)\n\noffset = 0\nwith torch.no_grad():\n    for images, masks in tqdm(val_loader, desc=\"Caching validation predictions\"):\n        images = images.to(DEVICE)\n        end = offset + images.shape[0]\n        for n in model_names:\n            val_probs[n][offset:end] = predict_tta(ensemble_models[n], images).half().cpu()\n        val_truth[offset:end] = masks.to(torch.uint8)\n        offset = end\nassert offset == n_val\nprint(\"Validation maps ready:\", val_shape)\n\n\n# ---- search space ----------------------------------------------------------------------------\nHW = HEIGHT * WIDTH\nSMOOTH = [1, 3, 5]\nPIX_T = [0.10, 0.15, 0.20, 0.25, 0.30, 0.40, 0.50, 0.60, 0.70]\nGATES = [0.0, 0.30, 0.40, 0.50, 0.60, 0.70, 0.80, 0.90]\nAREAS = [0, 50, 100, 200, 400, 800, 1500]\n\ndef _norm(d):\n    s = float(sum(d.values())); return {k: v / s for k, v in d.items() if v > 0}\n\nweight_candidates, seen = [], set()\ndef _add(d):\n    d = _norm(d); key = tuple(sorted((k, round(v, 4)) for k, v in d.items()))\n    if key not in seen: seen.add(key); weight_candidates.append(d)\n\n_add({n: 1 for n in model_names})\nfor n in model_names:\n    _add({n: 1})\n    _add({**{m: 1 for m in model_names}, n: 2})\n    if len(model_names) > 2:\n        _add({m: 1 for m in model_names if m != n})\nprint(len(weight_candidates), \"ensemble-weight candidates\")\n\ndef blend_stats(weights, chunk=32):\n    \"\"\"Per (smoothing, threshold, strip, class): predicted area / intersection; per (smoothing, strip, class): max prob.\"\"\"\n    S, T = len(SMOOTH), len(PIX_T)\n    pa = np.zeros((S, T, n_val, 4)); inter = np.zeros((S, T, n_val, 4))\n    mx = np.zeros((S, n_val, 4), np.float32); ga = np.zeros((n_val, 4))\n    for s0 in range(0, n_val, chunk):\n        e0 = min(s0 + chunk, n_val)\n        p = sum(w * val_probs[n][s0:e0].to(DEVICE).float() for n, w in weights.items())\n        y = val_truth[s0:e0].to(DEVICE).bool()\n        ga[s0:e0] = y.sum((2, 3)).cpu().numpy()\n        for si, k in enumerate(SMOOTH):\n            ps = smooth_probs(p, k)\n            mx[si, s0:e0] = ps.flatten(2).amax(2).cpu().numpy()\n            for ti, t in enumerate(PIX_T):\n                pr = ps >= t\n                pa[si, ti, s0:e0] = pr.sum((2, 3)).cpu().numpy()\n                inter[si, ti, s0:e0] = (pr & y).sum((2, 3)).cpu().numpy()\n    return pa, inter, mx, ga\n\ndef tune_per_class(stats):\n    \"\"\"Official score is additive over classes -> tune each class independently. Returns {cls: (score, params)}.\"\"\"\n    pa, inter, mx, ga = stats\n    pos, emp = ga > 0, ga == 0\n    n_pos, n_emp = max(pos.sum(), 1), max(emp.sum(), 1)\n    out = {}\n    for c, cls in enumerate(CLASSES):\n        best = (-1e9, None)\n        p_, e_, g_ = pos[:, c], emp[:, c], ga[:, c]\n        for si, k in enumerate(SMOOTH):\n            for ti, t in enumerate(PIX_T):\n                pa_c, it_c = pa[si, ti, :, c], inter[si, ti, :, c]\n                for g in GATES:\n                    gate_ok = mx[si, :, c] >= g\n                    for a in AREAS:\n                        keep = gate_ok & (pa_c >= a)\n                        pa2 = np.where(keep, pa_c, 0.0); it2 = np.where(keep, it_c, 0.0)\n                        dice = 2 * it2[p_] / np.maximum(pa2[p_] + g_[p_], 1)\n                        s = (0.7 * dice.sum() / n_pos\n                             - 0.2 * (pa2[e_] / HW).sum() / n_emp\n                             + 0.1 * (pa2[e_] == 0).sum() / n_emp)\n                        if s > best[0]:\n                            best = (s, {\"smooth\": k, \"pixel_threshold\": t, \"gate\": g, \"min_area\": a})\n        out[cls] = best\n    return out\n\n# ---- evaluate every ensemble-weight candidate ---------------------------------------------------\ncand_stats, cand_class, rows = [], [], []\nfor w in weight_candidates:\n    st = blend_stats(w)\n    res = tune_per_class(st)\n    cand_stats.append(st); cand_class.append(res)\n    total = 0.2 + sum(v[0] for v in res.values())\n    rows.append({**{n: round(w.get(n, 0.0), 3) for n in model_names}, \"official_score\": round(total, 4)})\n    print(f\"{ {k: round(v, 3) for k, v in w.items()} }: official validation score = {total:.4f}\")\ndisplay(pd.DataFrame(rows).sort_values(\"official_score\", ascending=False).reset_index(drop=True))\n\n# ---- choose the best candidate FOR EACH CLASS ---------------------------------------------------------\nclass_weights, class_params, class_cand = {}, {}, {}\nfor cls in CLASSES:\n    ci = int(np.argmax([cand_class[i][cls][0] for i in range(len(weight_candidates))]))\n    class_cand[cls] = ci\n    class_weights[cls] = weight_candidates[ci]\n    class_params[cls] = cand_class[ci][cls][1]\n\nga_all = cand_stats[0][3]\ndef assemble():\n    PA = np.zeros_like(ga_all); IN = np.zeros_like(ga_all); MXC = np.zeros_like(ga_all)\n    for c, cls in enumerate(CLASSES):\n        pa, inter, mx, _ = cand_stats[class_cand[cls]]\n        q = class_params[cls]; si = SMOOTH.index(q[\"smooth\"]); ti = PIX_T.index(q[\"pixel_threshold\"])\n        keep = (mx[si, :, c] >= q[\"gate\"]) & (pa[si, ti, :, c] >= q[\"min_area\"])\n        PA[:, c] = np.where(keep, pa[si, ti, :, c], 0); IN[:, c] = np.where(keep, inter[si, ti, :, c], 0)\n    return PA, IN\n\nPA, IN = assemble()\npos, emp = ga_all > 0, ga_all == 0\nfg = (2 * IN[pos] / np.maximum(PA[pos] + ga_all[pos], 1)).mean()\nfp = 1 - (PA[emp] / HW).sum() / max(emp.sum(), 1)\nea = (PA[emp] == 0).sum() / max(emp.sum(), 1)\nbest_validation_official = 0.7 * fg + 0.2 * fp + 0.1 * ea\nprint()\nprint(f\"Validation OFFICIAL score {best_validation_official:.4f}  (fgDice {fg:.4f}, FP score {fp:.4f}, empty acc {ea:.4f})\")\ndisplay(pd.DataFrame({cls: {**class_params[cls], \"weights\": {k: round(v, 2) for k, v in class_weights[cls].items()}} for cls in CLASSES}).T)\n\ndiag = []\nfor c, cls in enumerate(CLASSES):\n    p_ = pos[:, c]; pred = PA[:, c] > 0\n    dice = np.where(p_, 2 * IN[:, c] / np.maximum(PA[:, c] + ga_all[:, c], 1), 0)\n    diag.append({\"class\": cls, \"n_positive\": int(p_.sum()), \"fg_dice\": dice[p_].mean(),\n                 \"detection_recall\": (pred & p_).sum() / max(p_.sum(), 1),\n                 \"dice_when_detected\": dice[p_ & pred].mean() if (p_ & pred).any() else 0.0,\n                 \"false_alarm_rate\": (pred & ~p_).sum() / max((~p_).sum(), 1)})\nprint(\"Per-class diagnostics:\")\ndisplay(pd.DataFrame(diag).round(4))\n\nbest_ensemble_weights = class_weights\nbest_ensemble_threshold = float(np.mean([v[\"pixel_threshold\"] for v in class_params.values()]))\nbest_strip_gate_threshold = float(np.mean([v[\"gate\"] for v in class_params.values()]))\nbest_validation_mean_dice = float(fg)\n\ndel val_probs, val_truth, cand_stats\ngc.collect()","metadata":{"execution":{"iopub.execute_input":"2026-11-05T14:05:35.99061Z","iopub.status.busy":"2026-11-05T14:05:35.989999Z","iopub.status.idle":"2026-11-05T14:11:35.685935Z","shell.execute_reply":"2026-11-05T14:11:35.685171Z"},"papermill":{"duration":359.766274,"end_time":"2026-11-05T14:11:35.687545+00:00","exception":false,"start_time":"2026-11-05T14:05:35.921271+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 9. Locate test images using the original competition IDs\n\nThis follows the previous notebook's approach: read the competition `sample_submission.csv`, find test images by their filename stems, and preserve the sample submission row order exactly.","metadata":{"papermill":{"duration":0.069936,"end_time":"2026-11-05T14:11:35.828172+00:00","exception":false,"start_time":"2026-11-05T14:11:35.758236+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"all_image_paths = glob.glob(\"/kaggle/input/**/*\", recursive=True)\nvalid_extensions = (\".png\", \".jpg\", \".jpeg\", \".bmp\")\nrequested_ids = sample_submission[\"image_id\"].astype(str).unique()\nrequested_stems = {Path(image_id).stem for image_id in requested_ids}\n\n# Prefer paths in a test directory, then fall back to any input image matching a requested ID.\ntest_candidates = [\n    path for path in all_image_paths\n    if path.lower().endswith(valid_extensions)\n    and \"/test/\" in path.replace(\"\\\\\", \"/\").lower()\n    and Path(path).stem in requested_stems\n]\nif not test_candidates:\n    test_candidates = [\n        path for path in all_image_paths\n        if path.lower().endswith(valid_extensions)\n        and Path(path).stem in requested_stems\n    ]\n\ntest_image_map = {}\nfor path in test_candidates:\n    test_image_map.setdefault(Path(path).stem, path)\n\nmissing_ids = [image_id for image_id in requested_ids if Path(image_id).stem not in test_image_map]\nif missing_ids:\n    # Match any remaining requested IDs anywhere under /kaggle/input.\n    fallback_paths = [\n        path for path in all_image_paths\n        if path.lower().endswith(valid_extensions)\n        and Path(path).stem in {Path(image_id).stem for image_id in missing_ids}\n    ]\n    for path in fallback_paths:\n        test_image_map.setdefault(Path(path).stem, path)\n\nmissing_ids = [image_id for image_id in requested_ids if Path(image_id).stem not in test_image_map]\nif missing_ids:\n    raise FileNotFoundError(\n        f\"Could not locate {len(missing_ids)} test images. Example IDs: {missing_ids[:5]}\"\n    )\n\nprint(\"Requested unique test images:\", len(requested_ids))\nprint(\"Matched test image paths:\", len(test_image_map))\n","metadata":{"execution":{"iopub.execute_input":"2026-11-05T14:11:36.062392Z","iopub.status.busy":"2026-11-05T14:11:36.062018Z","iopub.status.idle":"2026-11-05T14:11:39.379042Z","shell.execute_reply":"2026-11-05T14:11:39.37837Z"},"papermill":{"duration":3.487192,"end_time":"2026-11-05T14:11:39.380831+00:00","exception":false,"start_time":"2026-11-05T14:11:35.893639+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 10. Final submission\n\nEvery test strip is predicted by the ensemble members (4-way flip TTA). For each class the tuned blend, smoothing, threshold, strip gate and minimum area are applied, and `submission.csv` is written in exactly the sample-submission format (all fields quoted, `ID,image_id,defect_type,mask_rle`, empty mask = a single space).","metadata":{"papermill":{"duration":0.070327,"end_time":"2026-11-05T14:11:39.525462+00:00","exception":false,"start_time":"2026-11-05T14:11:39.455135+00:00","status":"completed"},"tags":[]}},{"cell_type":"code","source":"import csv\n\nunique_test_ids = sample_submission[\"image_id\"].astype(str).drop_duplicates().tolist()\ntest_df = pd.DataFrame({\"image_id\": unique_test_ids})\ntest_df[\"image_path\"] = test_df[\"image_id\"].map(lambda x: test_image_map[Path(x).stem])\nfor cls in CLASSES:\n    test_df[cls] = \"\"\ntest_loader = DataLoader(DefectDataset(test_df, augment=False), batch_size=16, shuffle=False,\n                         num_workers=2, pin_memory=torch.cuda.is_available())\n\nneeded_models = sorted({n for w in class_weights.values() for n in w})\nprint(\"Models used for the test predictions:\", needed_models)\n\ndef class_masks_from_models(prob_by_model):\n    \"\"\"prob_by_model: {name: [B,4,H,W] tensor}. Per-class blend -> smoothing -> threshold -> gate -> min area.\"\"\"\n    out = []\n    for c, cls in enumerate(CLASSES):\n        q, w = class_params[cls], class_weights[cls]\n        p = sum(wt * prob_by_model[n][:, c:c + 1] for n, wt in w.items())\n        p = smooth_probs(p, q[\"smooth\"])\n        m = p >= q[\"pixel_threshold\"]\n        keep = (p.flatten(1).amax(1) >= q[\"gate\"]) & (m.flatten(1).sum(1) >= max(q[\"min_area\"], 1))\n        out.append((m & keep[:, None, None, None])[:, 0])\n    return torch.stack(out, dim=1).cpu().numpy()\n\nfor n in needed_models:\n    ensemble_models[n].eval()\nprediction_cache, cursor = {}, 0\nwith torch.no_grad():\n    for images, _ in tqdm(test_loader, desc=\"Predicting test images\"):\n        images = images.to(DEVICE)\n        prob_by_model = {n: predict_tta(ensemble_models[n], images) for n in needed_models}\n        masks_bool = class_masks_from_models(prob_by_model)\n        for b in range(len(images)):\n            image_id = unique_test_ids[cursor]; cursor += 1\n            prediction_cache[image_id] = {cls: encode_rle(masks_bool[b, ci]) for ci, cls in enumerate(CLASSES)}\nassert cursor == len(unique_test_ids)\n\n# ---- build the file exactly like sample_submission.csv ------------------------------------------\nsubmission = sample_submission.copy()\nsubmission[\"image_id\"] = submis