     return mask.reshape((width, height)).T\n","\n","    values = np.asarray(rle.split(), dtype=int)\n","    starts = values[0::2] - 1\n","    lengths = values[1::2]\n","\n","    for start, length in zip(starts, lengths):\n","        mask[start:start + length] = 1\n","\n","    return mask.reshape((width, height)).T\n","\n","\n","overlap_pixels = 0\n","\n","for image_id, group in train.groupby(\"image_id\"):\n","    masks = [\n","        decode_rle(rle).astype(bool)\n","        for rle in group[\"mask_rle\"]\n","    ]\n","\n","    if len(masks) > 1:\n","        overlap_pixels += np.sum(np.stack(masks).sum(axis=0) > 1)\n","\n","print(\"Total overlapping pixels:\", overlap_pixels)\n"]},{"cell_type":"markdown","id":"dcbe74f2","metadata":{"papermill":{"duration":0.002871,"end_time":"2026-11-02T05:49:37.625462+00:00","exception":false,"start_time":"2026-11-02T05:49:37.622591+00:00","status":"completed"},"tags":[]},"source":["# RLE Integrity and Boundary Validation"]},{"cell_type":"code","execution_count":5,"id":"5b557d3d","metadata":{"execution":{"iopub.execute_input":"2026-11-02T05:49:37.633029Z","iopub.status.busy":"2026-11-02T05:49:37.632256Z","iopub.status.idle":"2026-11-02T05:49:38.233866Z","shell.execute_reply":"2026-11-02T05:49:38.23268Z"},"papermill":{"duration":0.607611,"end_time":"2026-11-02T05:49:38.235949+00:00","exception":false,"start_time":"2026-11-02T05:49:37.628338+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Total RLE runs: 797406\n","Malformed rows: 0\n","Invalid runs: 0\n","Largest endpoint: 102400\n"]}],"source":["\n","# Check RLE format and image boundaries\n","total_runs = 0\n","malformed_rows = 0\n","invalid_runs = 0\n","max_endpoint = 0\n","\n","for rle in train[\"mask_rle\"]:\n","    if not rle:\n","        continue\n","\n","    values = rle.split()\n","\n","    if len(values) % 2 != 0:\n","        malformed_rows += 1\n","        continue\n","\n","    try:\n","        values = list(map(int, values))\n","    except ValueError:\n","        malformed_rows += 1\n","        continue\n","\n","    total_runs += len(values) // 2\n","\n","    for start, length in zip(values[0::2], values[1::2]):\n","        endpoint = start + length - 1\n","        max_endpoint = max(max_endpoint, endpoint)\n","\n","        if start < 1 or length < 1 or endpoint > 128 * 800:\n","            invalid_runs += 1\n","\n","print(\"Total RLE runs:\", total_runs)\n","print(\"Malformed rows:\", malformed_rows)\n","print(\"Invalid runs:\", invalid_runs)\n","print(\"Largest endpoint:\", max_endpoint)\n"]},{"cell_type":"markdown","id":"4e750417","metadata":{"papermill":{"duration":0.003039,"end_time":"2026-11-02T05:49:38.24213+00:00","exception":false,"start_time":"2026-11-02T05:49:38.239091+00:00","status":"completed"},"tags":[]},"source":["# Q5 Geometric Distortion Under Resizing"]},{"cell_type":"code","execution_count":6,"id":"d27e87b3","metadata":{"execution":{"iopub.execute_input":"2026-11-02T05:49:38.249821Z","iopub.status.busy":"2026-11-02T05:49:38.249448Z","iopub.status.idle":"2026-11-02T05:49:38.255424Z","shell.execute_reply":"2026-11-02T05:49:38.254494Z"},"papermill":{"duration":0.012105,"end_time":"2026-11-02T05:49:38.257355+00:00","exception":false,"start_time":"2026-11-02T05:49:38.24525+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Horizontal scale: 0.32\n","Vertical scale: 2.0\n","Scale ratio: 6.25\n"]}],"source":["\n","# Original and resized image dimensions\n","original_width, original_height = 800, 128\n","new_width, new_height = 256, 256\n","\n","sx = new_width / original_width\n","sy = new_height / original_height\n","\n","print(\"Horizontal scale:\", sx)\n","print(\"Vertical scale:\", sy)\n","print(\"Scale ratio:\", max(sx, sy) / min(sx, sy))\n"]},{"cell_type":"markdown","id":"24170bd0","metadata":{"papermill":{"duration":0.00293,"end_time":"2026-11-02T05:49:38.263377+00:00","exception":false,"start_time":"2026-11-02T05:49:38.260447+00:00","status":"completed"},"tags":[]},"source":["# Photometric Invisibility & Defect Feature Types"]},{"cell_type":"code","execution_count":7,"id":"3c2d7df7","metadata":{"execution":{"iopub.execute_input":"2026-11-02T05:49:38.270919Z","iopub.status.busy":"2026-11-02T05:49:38.27056Z","iopub.status.idle":"2026-11-02T05:49:50.361822Z","shell.execute_reply":"2026-11-02T05:49:50.360818Z"},"papermill":{"duration":12.09735,"end_time":"2026-11-02T05:49:50.363723+00:00","exception":false,"start_time":"2026-11-02T05:49:38.266373+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Training images found: 11393\n","defect_a Cohen's d: 0.0051\n","defect_b Cohen's d: -0.0964\n","defect_c Cohen's d: 0.0498\n","defect_d Cohen's d: -0.1709\n"]}],"source":["\n","#Q6 Photometric Invisibility & Defect Feature Types (Cohen's d)\n","\n","import glob\n","from pathlib import Path\n","import cv2\n","DEFECTS = [\"defect_a\", \"defect_b\", \"defect_c\", \"defect_d\"]\n","image_files = glob.glob(\"/kaggle/input/**/train/**/*\", recursive=True)\n","image_files = [\n","    p for p in image_files\n","    if p.lower().endswith((\".jpg\", \".jpeg\", \".png\", \".bmp\"))\n","]\n","image_map = {Path(p).stem: p for p in image_files}\n","\n","print(\"Training images found:\", len(image_map))\n","\n","rng = np.random.default_rng(42)\n","kernel = np.ones((7, 7), np.uint8)\n","\n","for defect in DEFECTS:\n","    defect_pixels, bg_pixels = [], []\n","\n","    rows = train[\n","        (train[\"defect_type\"] == defect) &\n","        (train[\"mask_rle\"] != \"\")\n","    ].sample(frac=1, random_state=42).head(100)\n","\n","    for _, row in rows.iterrows():\n","        image_id = Path(str(row[\"image_id\"])).stem\n","        path = image_map.get(image_id)\n","\n","        if path is None:\n","            continue\n","\n","        image = cv2.imread(path, cv2.IMREAD_GRAYSCALE)\n","        if image is None:\n","            continue\n","\n","        mask = decode_rle(row[\"mask_rle\"]).astype(bool)\n","        if mask.shape != image.shape or not mask.any():\n","            continue\n","\n","        expanded = cv2.dilate(mask.astype(np.uint8), kernel).astype(bool)\n","        background = expanded & ~mask\n","\n","        if not background.any():\n","            continue\n","\n","        d_values = image[mask].ravel()\n","        b_values = image[background].ravel()\n","\n","        # Sample pixels so large defects do not dominate memory.\n","        if len(d_values) > 20000:\n","            d_values = rng.choice(d_values, 20000, replace=False)\n","        if len(b_values) > 20000:\n","            b_values = rng.choice(b_values, 20000, replace=False)\n","\n","        defect_pixels.extend(d_values.tolist())\n","        bg_pixels.extend(b_values.tolist())\n","\n","    d_pixels = np.asarray(defect_pixels, dtype=float)\n","    b_pixels = np.asarray(bg_pixels, dtype=float)\n","\n","    if len(d_pixels) < 2 or len(b_pixels) < 2:\n","        print(defect, \"not enough pixels to calculate Cohen's d\")\n","        continue\n","\n","    pooled_sd = np.sqrt(\n","        ((len(d_pixels) - 1) * d_pixels.var(ddof=1)\n","         + (len(b_pixels) - 1) * b_pixels.var(ddof=1))\n","        / (len(d_pixels) + len(b_pixels) - 2)\n","    )\n","\n","    cohens_d = (\n","        (d_pixels.mean() - b_pixels.mean()) / pooled_sd\n","        if pooled_sd > 0 else 0.0\n","    )\n","\n","    print(defect, \"Cohen's d:\", round(cohens_d, 4))\n"]},{"cell_type":"markdown","id":"94898f88","metadata":{"papermill":{"duration":0.003088,"end_time":"2026-11-02T05:49:50.370109+00:00","exception":false,"start_time":"2026-11-02T05:49:50.367021+00:00","status":"completed"},"tags":[]},"source":["# Questions 7 and 8: Metric Behavior and Official Competition Weighted Metric"]},{"cell_type":"code","execution_count":8,"id":"8e5490a3","metadata":{"execution":{"iopub.execute_input":"2026-11-02T05:49:50.378389Z","iopub.status.busy":"2026-11-02T05:49:50.377638Z","iopub.status.idle":"2026-11-02T05:49:50.385239Z","shell.execute_reply":"2026-11-02T05:49:50.384202Z"},"papermill":{"duration":0.014078,"end_time":"2026-11-02T05:49:50.387327+00:00","exception":false,"start_time":"2026-11-02T05:49:50.373249+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Q7 answer: 1.0 0.0\n","ForegroundDice: 0.64\n","FalsePositiveScore: 0.999\n","EmptyAccuracy: 0.9\n","Final weighted score: 0.7378\n"]}],"source":["\n","# Question 7: Metric Behavior — The Discontinuous Step Function of Naive Dice\n","\n","dice1 = 1.0  # empty prediction and empty ground truth\n","dice2 = 0.0  # two predicted pixels, but empty ground truth\n","\n","print(\"Q7 answer:\", dice1, dice2)\n","\n","\n","# Question 8: Official Competition Weighted Metric — Toy Batch Calculation\n","\n","foreground_dice = (6 * 0.80 + 4 * 0.40) / 10\n","\n","fp_fraction = (4 * (1024 / 102400)) / 40\n","false_positive_score = 1 - fp_fraction\n","\n","empty_accuracy = 36 / 40\n","\n","final_score = (\n","    0.70 * foreground_dice\n","    + 0.20 * false_positive_score\n","    + 0.10 * empty_accuracy\n",")\n","\n","print(\"ForegroundDice:\", round(foreground_dice, 4))\n","print(\"FalsePositiveScore:\", round(false_positive_score, 4))\n","print(\"EmptyAccuracy:\", round(empty_accuracy, 4))\n","print(\"Final weighted score:\", round(final_score, 4))\n"]},{"cell_type":"markdown","id":"7ca85c4e","metadata":{"papermill":{"duration":0.003202,"end_time":"2026-11-02T05:49:50.393897+00:00","exception":false,"start_time":"2026-11-02T05:49:50.390695+00:00","status":"completed"},"tags":[]},"source":["# Question 9: The “All-Empty Baseline” on the Full Training Set"]},{"cell_type":"code","execution_count":9,"id":"e822838a","metadata":{"execution":{"iopub.execute_input":"2026-11-02T05:49:50.401984Z","iopub.status.busy":"2026-11-02T05:49:50.401602Z","iopub.status.idle":"2026-11-02T05:49:50.414046Z","shell.execute_reply":"2026-11-02T05:49:50.413087Z"},"papermill":{"duration":0.018774,"end_time":"2026-11-02T05:49:50.415967+00:00","exception":false,"start_time":"2026-11-02T05:49:50.397193+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Total pairs: 45572\n","Empty ground-truth pairs: 38371\n","Naive mean Dice: 0.842\n","Official competition score: 0.3\n"]}],"source":["\n","# Question 9: The “All-Empty Baseline” on the Full Training Set\n","\n","total_pairs = len(train)\n","empty_pairs = (train[\"mask_rle\"] == \"\").sum()\n","positive_pairs = total_pairs - empty_pairs\n","\n","# Empty-aware naive Dice: empty pairs score 1, positive pairs score 0\n","naive_dice = empty_pairs / total_pairs\n","\n","# All-empty predictions: no false positives, but no true defects detected\n","foreground_dice = 0.0 if positive_pairs else 1.0\n","false_positive_score = 1.0\n","empty_accuracy = 1.0\n","\n","official_score = (\n","    0.70 * foreground_dice\n","    + 0.20 * false_positive_score\n","    + 0.10 * empty_accuracy\n",")\n","\n","print(\"Total pairs:\", total_pairs)\n","print(\"Empty ground-truth pairs:\", empty_pairs)\n","print(\"Naive mean Dice:\", round(naive_dice, 4))\n","print(\"Official competition score:\", round(official_score, 4))\n"]},{"cell_type":"markdown","id":"81601e78","metadata":{"papermill":{"duration":0.00319,"end_time":"2026-11-02T05:49:50.42258+00:00","exception":false,"start_time":"2026-11-02T05:49:50.41939+00:00","status":"completed"},"tags":[]},"source":["# Question 10: Morphological Noise Filtering — Minimum Area Recall Ceilings"]},{"cell_type":"code","execution_count":10,"id":"0b7f6d6d","metadata":{"execution":{"iopub.execute_input":"2026-11-02T05:49:50.430938Z","iopub.status.busy":"2026-11-02T05:49:50.430558Z","iopub.status.idle":"2026-11-02T05:49:54.208058Z","shell.execute_reply":"2026-11-02T05:49:54.206421Z"},"papermill":{"duration":3.784423,"end_time":"2026-11-02T05:49:54.210631+00:00","exception":false,"start_time":"2026-11-02T05:49:50.426208+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Smallest defect_b component: 93\n","defect_b pixels lost at N=50 (%): 0.0\n","defect_a pixels lost at N=200 (%): 15.2171\n"]}],"source":["\n","# Question 10: Morphological Noise Filtering — Minimum Area Recall Ceilings\n","\n","import cv2\n","\n","min_area_b = float(\"inf\")\n","total_b_pixels = 0\n","lost_b_pixels = 0\n","\n","total_a_pixels = 0\n","lost_a_pixels = 0\n","\n","for _, row in train.iterrows():\n","    rle = row[\"mask_rle\"]\n","    if not rle:\n","        continue\n","\n","    defect = row[\"defect_type\"]\n","    if defect not in (\"defect_a\", \"defect_b\"):\n","        continue\n","\n","    mask = decode_rle(rle).astype(np.uint8)\n","    total_pixels = int(mask.sum())\n","\n","    if total_pixels == 0:\n","        continue\n","\n","    _, labels, stats, _ = cv2.connectedComponentsWithStats(\n","        mask, connectivity=8\n","    )\n","    areas = stats[1:, cv2.CC_STAT_AREA]\n","\n","    if defect == \"defect_b\":\n","        if len(areas):\n","            min_area_b = min(min_area_b, int(areas.min()))\n","        total_b_pixels += total_pixels\n","        lost_b_pixels += int(areas[areas < 50].sum())\n","\n","    elif defect == \"defect_a\":\n","        total_a_pixels += total_pixels\n","        lost_a_pixels += int(areas[areas < 200].sum())\n","\n","lost_b_pct = 100 * lost_b_pixels / total_b_pixels\n","lost_a_pct = 100 * lost_a_pixels / total_a_pixels\n","\n","print(\"Smallest defect_b component:\", min_area_b)\n","print(\"defect_b pixels lost at N=50 (%):\", round(lost_b_pct, 4))\n","print(\"defect_a pixels lost at N=200 (%):\", round(lost_a_pct, 4))\n"]},{"cell_type":"markdown","id":"cf652c45","metadata":{"papermill":{"duration":0.005674,"end_time":"2026-11-02T05:49:54.220517+00:00","exception":false,"start_time":"2026-11-02T05:49:54.214843+00:00","status":"completed"},"tags":[]},"source":["# Question 11: Multi-Label Combination Stratification"]},{"cel