n# Prefer paths in a test directory, then fall back to any input image matching a requested ID.\ntest_candidates = [\n    path for path in all_image_paths\n    if path.lower().endswith(valid_extensions)\n    and \"/test/\" in path.replace(\"\\\\\", \"/\").lower()\n    and Path(path).stem in requested_stems\n]\nif not test_candidates:\n    test_candidates = [\n        path for path in all_image_paths\n        if path.lower().endswith(valid_extensions)\n        and Path(path).stem in requested_stems\n    ]\n\ntest_image_map = {}\nfor path in test_candidates:\n    test_image_map.setdefault(Path(path).stem, path)\n\nmissing_ids = [image_id for image_id in requested_ids if Path(image_id).stem not in test_image_map]\nif missing_ids:\n    # Match any remaining requested IDs anywhere under /kaggle/input.\n    fallback_paths = [\n        path for path in all_image_paths\n        if path.lower().endswith(valid_extensions)\n        and Path(path).stem in {Path(image_id).stem for image_id in missing_ids}\n    ]\n    for path in fallback_paths:\n        test_image_map.setdefault(Path(path).stem, path)\n\nmissing_ids = [image_id for image_id in requested_ids if Path(image_id).stem not in test_image_map]\nif missing_ids:\n    raise FileNotFoundError(\n        f\"Could not locate {len(missing_ids)} test images. Example IDs: {missing_ids[:5]}\"\n    )\n\nprint(\"Requested unique test images:\", len(requested_ids))\nprint(\"Matched test image paths:\", len(test_image_map))\n","metadata":{"execution":{"iopub.execute_input":"2026-10-29T18:10:11.591087Z","iopub.status.busy":"2026-10-29T18:10:11.590748Z","iopub.status.idle":"2026-10-29T18:10:14.547091Z","shell.execute_reply":"2026-10-29T18:10:14.546328Z","shell.execute_reply.started":"2026-10-29T18:10:11.591065Z"}},"outputs":[{"name":"stdout","output_type":"stream","text":["Requested unique test images: 3000\n","Matched test image paths: 3000\n"]}],"execution_count":111},{"cell_type":"markdown","source":"## 10. Final submission from 3-fold models\n\nThe final CV cell averages predictions from each fold, applies class-specific strip gates and pixel thresholds selected using out-of-fold predictions, and preserves the original sample submission order and columns.\n","metadata":{}},{"cell_type":"code","source":"submission = sample_submission.copy()\nsubmission[\"image_id\"] = submission[\"image_id\"].astype(str)\nsubmission[\"defect_type\"] = submission[\"defect_type\"].astype(str)\nsubmission[\"mask_rle\"] = \"\"\n\nprediction_cache = {}\nunique_test_ids = submission[\"image_id\"].drop_duplicates().tolist()\n\nmodel.eval()\nmodel_fpn.eval()\nmodel_unetpp.eval()\n\nwith torch.no_grad():\n    for image_id in tqdm(unique_test_ids, desc=\"Predicting test images\"):\n        image_path = test_image_map[Path(image_id).stem]\n        image = cv2.imread(image_path)\n        if image is None:\n            raise ValueError(f\"Could not read test image: {image_path}\")\n        image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n        image = cv2.resize(image, (WIDTH, HEIGHT))\n        image = image.astype(np.float32) / 255.0\n        image_tensor = torch.from_numpy(image.transpose(2, 0, 1)).unsqueeze(0).to(DEVICE)\n\n        probabilities = (\n            best_ensemble_weights[0] * predict_tta(model, image_tensor)\n            + best_ensemble_weights[1] * predict_tta(model_fpn, image_tensor)\n            + best_ensemble_weights[2] * predict_tta(model_unetpp, image_tensor)\n        )\n        gated_masks = gated_masks_from_probabilities(\n            probabilities.detach().cpu().numpy(),\n            strip_gate_threshold=best_strip_gate_threshold,\n            pixel_threshold=best_ensemble_threshold,\n        )[0]\n\n        prediction_cache[image_id] = {\n            cls: encode_rle(gated_masks[class_idx])\n            for class_idx, cls in enumerate(CLASSES)\n        }\n\nfor row_idx, row in tqdm(submission.iterrows(), total=len(submission), desc=\"Encoding RLE\"):\n    image_id = str(row[\"image_id\"])\n    def