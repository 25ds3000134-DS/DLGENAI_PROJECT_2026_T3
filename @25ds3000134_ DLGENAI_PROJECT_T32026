s = val_loss_sum / max(1, len(val_loader))\n    val_dice = val_dice_sum / max(1, len(val_loader))\n\n    history.append({\n        \"epoch\": epoch + 1,\n        \"train_loss\": train_loss,\n        \"val_loss\": val_loss,\n        \"val_dice\": val_dice\n    })\n\n    if wandb_run is not None:\n        wandb_run.log({\n            \"model1/epoch\": epoch + 1,\n            \"model1/train_loss\": train_loss,\n            \"model1/val_loss\": val_loss,\n            \"model1/val_dice\": val_dice,\n            \"model1/learning_rate\": optimizer.param_groups[0][\"lr\"],\n        })\n\n    print(\n        f\"Scratch U-Net epoch {epoch + 1}: \"\n        f\"train_loss={train_loss:.4f}, \"\n        f\"val_loss={val_loss:.4f}, \"\n        f\"val_dice={val_dice:.4f}\"\n    )\n\n    if val_loss < best_val_loss - 1e-6:\n        best_val_loss = val_loss\n        scratch_wait = 0\n        torch.save(model.state_dict(), \"/kaggle/working/unet_scratch_best.pth\")\n        print(\"Best Scratch U-Net checkpoint saved.\")\n    else:\n        scratch_wait += 1\n        print(f\"No validation-loss improvement ({scratch_wait}/{SCRATCH_PATIENCE}).\")\n        if scratch_wait >= SCRATCH_PATIENCE:\n            print(\"Early stopping Scratch U-Net.\")\n            break\n\n# Always continue with the best validation checkpoint, not the final epoch.\nmodel.load_state_dict(\n    torch.load(\"/kaggle/working/unet_scratch_best.pth\", map_location=DEVICE, weights_only=True)\n)\nmodel.eval()\nprint(\"Scratch U-Net best checkpoint restored.\")\n","metadata":{"execution":{"iopub.execute_input":"2026-10-29T16:17:14.430938Z","iopub.status.busy":"2026-10-29T16:17:14.430611Z","iopub.status.idle":"2026-10-29T16:35:04.600231Z","shell.execute_reply":"2026-10-29T16:35:04.599323Z","shell.execute_reply.started":"2026-10-29T16:17:14.430908Z"}},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"ab769eaca90245f1b21f250fcfc28e78","version_major":2,"version_minor":0},"text/plain":["Epoch 1/