6047</td>\n","      <td>0.0289</td>\n","    </tr>\n","    <tr>\n","      <th>2</th>\n","      <td>defect_c</td>\n","      <td>820</td>\n","      <td>0.6778</td>\n","      <td>0.9537</td>\n","      <td>0.7107</td>\n","      <td>0.2296</td>\n","    </tr>\n","    <tr>\n","      <th>3</th>\n","      <td>defect_d</td>\n","      <td>342</td>\n","      <td>0.7708</td>\n","      <td>0.9444</td>\n","      <td>0.8162</td>\n","      <td>0.0377</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["      class  n_positive  fg_dice  detection_recall  dice_when_detected  \\\n","0  defect_a         216   0.4629            0.7407              0.6250   \n","1  defect_b          63   0.4607            0.7619              0.6047   \n","2  defect_c         820   0.6778            0.9537              0.7107   \n","3  defect_d         342   0.7708            0.9444              0.8162   \n","\n","   false_alarm_rate  \n","0            0.0824  \n","1            0.0289  \n","2            0.2296  \n","3            0.0377  "]},"metadata":{},"output_type":"display_data"},{"data":{"text/plain":["51"]},"execution_count":37,"metadata":{},"output_type":"execute_result"}],"source":["import gc\n","\n","@torch.no_grad()\n","def predict_tta(net, images):\n","    net.eval()\n","    use_amp = DEVICE.type == \"cuda\"\n","    with torch.autocast(device_type=\"cuda\", dtype=torch.float16, enabled=use_amp):\n","        p0 = torch.sigmoid(net(images).float())\n","        p1 = torch.flip(torch.sigmoid(net(torch.flip(images, dims=[3])).float()), dims=[3])\n","        p2 = torch.flip(torch.sigmoid(net(torch.flip(images, dims=[2])).float()), dims=[2])\n","        p3 = torch.flip(torch.sigmoid(net(torch.flip(images, dims=[2, 3])).float()), dims=[2, 3])\n","    return (p0 + p1 + p2 + p3) / 4.0\n","\n","\n","ensemble_models = {\"scratch\": model, \"fpn\": model_fpn, \"unetpp\": model_unetpp, \"unet_r34\": model_unet_r34}\n","model_names = list(ensemble_models)\n","pretrained_names = [n for n in model_names if n != \"scratch\"]\n","\n","# ---- cache validation probabilities (float16, in RAM: ~1.9 GB per model) -------------------\n","n_val = len(val_loader.dataset)\n","val_shape = (n_val, len(CLASSES), HEIGHT, WIDTH)\n","val_probs = {n: torch.zeros(val_shape, dtype=torch.float16) for n in model_names}\n","val_truth = torch.zeros(val_shape, dtype=torch.uint8)\n","\n","offset = 0\n","with torch.no_grad():\n","    for images, masks in tqdm(val_loader, desc=\"Caching validation predictions\"):\n","        images = images.to(DEVICE)\n","        end = offset + images.shape[0]\n","        for n in model_names:\n","            val_probs[n][offset:end] = predict_tta(ensemble_models[n], images).half().cpu()\n","        val_truth[offset:end] = masks.to(torch.uint8)\n","        offset = end\n","assert offset == n_val\n","print(\"Validation maps ready:\", val_shape)\n","\n","\n","# ---- official competition metric -------------------------------------------------------------\n","HW = HEIGHT * WIDTH\n","PIX_T = [0.10, 0.15, 0.20, 0.25, 0.30, 0.40, 0.50, 0.60, 0.70]   # pixel thresholds\n","GATES = [0.0, 0.30, 0.40, 0.50, 0.60, 0.70, 0.80, 0.90]          # strip gate (max prob to report class)\n","AREAS = [0, 50, 100, 200, 400, 800, 1500]                        # minimum predicted pixels\n","\n","def _norm(d):\n","    s = float(sum(d.values())); return {k: v / s for k, v in d.items() if v > 0}\n","\n","weight_candidates, seen = [], set()\n","def _add(d):\n","    d = _norm(d); key = tuple(sorted((k, round(v, 4)) for k, v in d.items()))\n","    if key not in seen: seen.add(key); weight_candidates.append(d)\n","\n","_add({n: 1 for n in pretrained_names})\n","_add({**{n: 1 for n in pretrained_names}, \"scratch\": 0.25})\n","_add({**{n: 1 for n in pretrained_names}, \"fpn\": 2})\n","for n in pretrained_names:\n","    _add({n: 1})\n","    _add({m: 1 for m in pretrained_names if m != n})\n","\n","def blend_stats(weights, chunk=32):\n","    \"\"\"Per (strip, class): predicted area / intersection per pixel threshold, max prob, GT area (GPU).\"\"\"\n","    T = len(PIX_T)\n","    pa = np.zeros((T, n_val, 4)); inter = np.zeros((T, n_val, 4))\n","    mx = np.zeros((n_val, 4), np.float32); ga = np.zeros((n_val, 4))\n","    for s in range(0, n_val, chunk):\n","        e = min(s + chunk, n_val)\n","        p = sum(w * val_probs[n][s:e].to(DEVICE).float() for n, w in weights.items())\n","        y = val_truth[s:e].to(DEVICE).bool()\n","        mx[s:e] = p.flatten(2).amax(2).cpu().numpy()\n","        ga[s:e] = y.sum((2, 3)).cpu().numpy()\n","        for ti, t in enumerate(PIX_T):\n","            pr = p >= t\n","            pa[ti, s:e] = pr.sum((2, 3)).cpu().numpy()\n","            inter[ti, s:e] = (pr & y).sum((2, 3)).cpu().numpy()\n","    return pa, inter, mx, ga\n","\n","def tune_per_class(pa, inter, mx, ga):\n","    \"\"\"The official score is additive over classes, so each class is tuned independently.\"\"\"\n","    pos, emp = ga > 0, ga == 0\n","    n_pos, n_emp = max(pos.sum(), 1), max(emp.sum(), 1)\n","    params, total = {}, 0.2\n","    for c, cls in enumerate(CLASSES):\n","        best = (-1e9, None)\n","        p_, e_, g_ = pos[:, c], emp[:, c], ga[:, c]\n","        for ti, t in enumerate(PIX_T):\n","            for g in GATES:\n","                for a in AREAS:\n","                    keep = (mx[:, c] >= g) & (pa[ti, :, c] >= a)\n","                    pa2 = np.where(keep, pa[ti, :, c], 0.0)\n","                    it2 = np.where(keep, inter[ti, :, c], 0.0)\n","                    dice = 2 * it2[p_] / np.maximum(pa2[p_] + g_[p_], 1)\n","                    s = (0.7 * dice.sum() / n_pos\n","                         - 0.2 * (pa2[e_] / HW).sum() / n_emp\n","                         + 0.1 * (pa2[e_] == 0).sum() / n_emp)\n","                    if s > best[0]:\n","                        best = (s, (t, g, a))\n","        params[cls] = {\"pixel_threshold\": best[1][0], \"gate\": best[1][1], \"min_area\": best[1][2]}\n","        total += best[0]\n","    return params, total\n","\n","def apply_params_stats(params, pa, inter, mx, ga):\n","    PA = np.zeros_like(ga); IN = np.zeros_like(ga)\n","    for c, cls in enumerate(CLASSES):\n","        q = params[cls]; ti = PIX_T.index(q[\"pixel_threshold\"])\n","        keep = (mx[:, c] >= q[\"gate\"]) & (pa[ti, :, c] >= q[\"min_area\"])\n","        PA[:, c] = np.where(keep, pa[ti, :, c], 0); IN[:, c] = np.where(keep, inter[ti, :, c], 0)\n","    return PA, IN\n","\n","def official_components(params, pa, inter, mx, ga):\n","    pos, emp = ga > 0, ga == 0\n","    PA, IN = apply_params_stats(params, pa, inter, mx, ga)\n","    fg = (2 * IN[pos] / np.maximum(PA[pos] + ga[pos], 1)).mean()\n","    fp = 1 - (PA[emp] / HW).sum() / max(emp.sum(), 1)\n","    ea = (PA[emp] == 0).sum() / max(emp.sum(), 1)\n","    return 0.7 * fg + 0.2 * fp + 0.1 * ea, fg, fp, ea\n","\n","def class_diagnostics(params, pa, inter, mx, ga):\n","    PA, IN = apply_params_stats(params, pa, inter, mx, ga)\n","    rows = []\n","    for c, cls in enumerate(CLASSES):\n","        pos = ga[:, c] > 0; pred = PA[:, c] > 0\n","        dice = np.where(pos, 2 * IN[:, c] / np.maximum(PA[:, c] + ga[:, c], 1), 0)\n","        rows.append({\"class\": cls, \"n_positive\": int(pos.sum()),\n","                     \"fg_dice\": dice[pos].mean(),\n","                     \"detection_recall\": (pred & pos).sum() / max(pos.sum(), 1),\n","                     \"dice_when_detected\": dice[pos & pred].mean() if (pos & pred).any() else 0.0,\n","                     \"false_alarm_rate\": (pred & ~pos).sum() / max((~pos).sum(), 1)})\n","    return pd.DataFrame(rows).round(4)\n","\n","\n","# ---- search blends; tune post-processing for each ----------------------------------------------\n","rows, best_overall = [], None\n","for w in weight_candidates:\n","    stats = blend_stats(w)\n","    params, total = tune_per_class(*stats)\n","    rows.append({**{n: round(w.get(n, 0.0), 3) for n in model_names}, \"official_score\": round(total, 4)})\n","    print(f\"{ {k: round(v, 3) for k, v in w.items()} }: official validation score = {total:.4f}\")\n","    if best_overall is None or total > best_overall[0]:\n","        best_overall = (total, w, params, stats)\n","\n","weight_results = pd.DataFrame(rows).sort_values(\"official_score\", ascending=False).reset_index(drop=True)\n","display(weight_results)\n","\n","best_validation_official, best_ensemble_weights, class_params, best_stats = best_overall\n","score, fg, fp, ea = official_components(class_params, *best_stats)\n","print(\"\\nSelected weights:\", {k: round(v, 3) for k, v in best_ensemble_weights.items()})\n","print(f\"Validation OFFICIAL score {score:.4f}  (fgDice {fg:.4f}, FP score {fp:.4f}, empty acc {ea:.4f})\")\n","display(pd.DataFrame(class_params).T)\n","print(\"Per-class diagnostics (where is the foreground Dice lost?):\")\n","display(class_diagnostics(class_params, *best_stats))\n","\n","best_ensemble_threshold = float(np.mean([v[\"pixel_threshold\"] for v in class_params.values()]))\n","best_strip_gate_threshold = float(np.mean([v[\"gate\"] for v in class_params.values()]))\n","best_validation_mean_dice = float(fg)\n","\n","del val_probs, val_truth, best_stats\n","gc.collect()"]},{"cell_type":"markdown","id":"3d43d2b7","metadata":{"papermill":{"duration":0.052241,"end_time":"2026-11-04T17:13:28.079285+00:00","exception":false,"start_time":"2026-11-04T17:13:28.027044+00:00","status":"completed"},"tags":[]},"source":["## 9. Locate test images using the original competition IDs\n","\n","This follows the previous notebook's approach: read the competition `sample_submission.csv`, find test images by their filename stems, and preserve the sample submission row order exactly."]},{"cell_type":"code","execution_count":38,"id":"fa33ccfe","metadata":{"execution":{"iopub.execute_input":"2026-11-04T17:13:28.183414Z","iopub.status.busy":"2026-11-04T17:13:28.183078Z","iopub.status.idle":"2026-11-04T17:13:33.835148Z","shell.execute_reply":"2026-11-04T1