et,\n    batch_size=BATCH_SIZE,\n    shuffle=True,\n    num_workers=0,\n    pin_memory=torch.cuda.is_available()\n)\n\nval_loader = DataLoader(\n    val_dataset,\n    batch_size=BATCH_SIZE,\n    shuffle=False,\n    num_workers=0,\n    pin_memory=torch.cuda.is_available()\n)\n\nprint(\"Training batches:\", len(train_loader))\nprint(\"Validation batches:\", len(val_loader))\n","metadata":{"execution":{"iopub.execute_input":"2026-10-29T16:17:02.108046Z","iopub.status.busy":"2026-10-29T16:17:02.107709Z","iopub.status.idle":"2026-10-29T16:17:02.123731Z","shell.execute_reply":"2026-10-29T16:17:02.122962Z","shell.execute_reply.started":"2026-10-29T16:17:02.108016Z"}},"outputs":[{"name":"stdout","output_type":"stream","text":["Training batches: 1187\n","Validation batches: 570\n"]}],"execution_count":90},{"cell_type":"markdown","source":"# Verify one batch before training","metadata":{}},{"cell_type":"code","source":"images, masks = next(iter(train_loader))\n\nprint(\"Image batch:\", images.shape)\nprint(\"Mask batch:\", masks.shape)\nprint(\"Image range:\", images.min().item(), images.max().item())\nprint(\"Mask values:\", torch.unique(masks))","metadata":{"execution":{"iopub.execute_input":"2026-10-29T16:17:02.125533Z","iopub.status.busy":"2026-10-29T16:17:02.124649Z","iopub.status.idle":"2026-10-29T16:17:02.227216Z","shell.execute_reply":"2026-10-29T16:17:02.226428Z","shell.execute_reply.started":"2026-10-29T16:17:02.125498Z"}},"outputs":[{"name":"stdout","output_type":"stream","text":["Image batch: torch.Size([4, 3, 128, 800])\n","Mask batch: torch.Size([4, 4, 128, 800])\n","Image range: 0.0 1.0\n","Mask values: tensor([0., 1.])\n"]}],"execution_count":91},{"cell_type":"markdown","source":"# 17. The U-Net model from Scratch","metadata":{}},{"cell_type":"code","source":"import torch.nn as nn\nimport torch.nn.functional as F\n\nclass ConvBlock(nn.Module):\n    def __init__(self, in_ch, out_ch):\n        super().__init__()\n        self.block = nn.Sequential(\n            nn.Conv2d(in_ch, out_ch, 3, padding=1),\n            nn.BatchNorm2d(out_ch),\n            nn.ReLU(inplace=True),\n            nn.Conv2d(out_ch, out_ch, 3, padding=1),\n            nn.BatchNorm2d(out_ch),\n            nn.ReLU(inplace=True)\n        )\n\n    def forward(self, x):\n        return self.block(x)\n\n\nclass UNet(nn.Module):\n    def __init__(self, out_channels=4):\n        super().__init__()\n        self.enc1 = ConvBlock(3, 32)\n        self.enc2 = ConvBlock(32, 64)\n        self.enc3 = ConvBlock(64, 128)\n        self.enc4 = ConvBlock(128, 256)\n\n        self.pool = nn.MaxPool2d(2)\n        self.bottleneck = ConvBlock(256, 512)\n\n        self.up4 = nn.ConvTranspose2d(512, 256, 2, stride=2)\n        self.dec4 = ConvBlock(512, 256)\n        self.up3 = nn.ConvTranspose2d(256, 128, 2, stride=2)\n        self.dec3 = ConvBlock(256, 128)\n        self.up2 = nn.ConvTranspose2d(128, 64, 2, stride=2)\n        self.dec2 = ConvBlock(128, 64)\n        self.up1 = nn.ConvTranspose2d(64, 32, 2, stride=2)\n        self.dec1 = ConvBlock(64, 32)\n\n        self.output = nn.Conv2d(32, out_channels, 1)\n\n    def forward(self, x):\n        e1 = self.enc1(x)\n        e2 = self.enc2(self.pool(e1))\n        e3 = self.enc3(self.pool(e2))\n        e4 = self.enc4(self.pool(e3))\n        b = self.bottleneck(self.pool(e4))\n\n        d4 = self.dec4(torch.cat([self.up4(b), e4], dim=1))\n        d3 = self.dec3(torch.cat([self.up3(d4), e3], dim=1))\n        d2 = self.dec2(torch.cat([self.up2(d3), e2], dim=1))\n        d1 = self.dec1(torch.cat([self.up1(d2), e1], dim=1))\n\n        return self.output(d1)\n\n\nmodel = UNet().to(DEVICE)\nprint(\"Model parameters:\", f\"{sum(p.numel() for p in model.parameters()):,}\")","metadata":{"execution":{"iopub.execute_input":"2026-10-29T16:17:02.228681Z","iopub.status.busy":"2026-10-29T16:17:02.228334Z","iopub.status.idle":"2026-10-29T16:17:02.312812Z","shell.execute_reply":"2026-10-29T16:17:02.312098Z","shell.execute_reply.started":"2026-10-29T16:17:02.22866Z"}},"outputs":[{"name":"stdout","output_type":"stream","text":["Model parameters: 7,766,084\n"]}],"execution_count":92},{"cell_type":"markdown","source":"# 18. Define the combined loss and Dice metric","metadata":{}},{"cell_type":"code","source":"def metric_aligned_loss(logits, targets, pos_weight=None, eps=1e-6):\n    \"\"\"\n    Multi-label objective aligned to the competition's known score components:\n    70% foreground Dice, 20% false-positive control, 10% empty-image accuracy.\n    BCE is retained as a small (5%) optimization stabilizer; the three metric\n    components keep their 70:20:10 ratio within the remaining 95%.\n    Each channel is independent: sigmoid is applied separately, never softmax.\n    \"\"\"\n    probs = torch.sigmoid(logits)\n    targets = targets.float()\n\n    # Foreground Dice: calculate only on class masks that actually contain defects.\n    p = probs.flatten(2)\n    t = targets.flatten(2)\n    intersection = (p * t).sum(dim=2)\n    denominator = p.sum(dim=2) + t.sum(dim=2)\n    positive_masks = (t.sum(dim=2) > 0)\n    dice_per_mask = 1.0 - (2.0 * intersection + 1.0) / (denominator + 1.0)\n    if positive_masks.any():\n        foreground_dice_loss = dice_per_mask[positive_masks].mean()\n    else:\n        foreground_dice_loss = probs.mean() * 0.0\n\n    # False-positive penalty on individual class masks whose ground truth is empty.\n    empty_class_masks = (t.sum(dim=2) == 0)\n    if empty_class_masks.any():\n        fp_loss = p[empty_class_masks].mean()\n    else:\n        fp_loss = probs.mean() * 0.0\n\n    # Empty-image penalty: all four channels should remain quiet on fully clean images.\n    empty_images = (targets.flatten(1).sum(dim=1) == 0)\n    if empty_images.any():\n        empty_image_loss = probs[empty_images].flatten(1).amax(dim=1).mean()\n    else:\n        empty_image_loss = probs.mean() * 0.0\n\n    if pos_weight is None:\n        bce = F.binary_cross_entropy_with_logits(logits, targets)\n    else:\n        bce = F.binary_cross_entropy_with_logits(\n            logits, targets, pos_weight=pos_weight.view(1, -1, 1, 1)\n        )\n\n    # Preserve the metric's 70:20:10 relative emphasis, with a 5% BCE stabilizer.\n    return (\n        0.665 * foreground_dice_loss\n        + 0.190 * fp_loss\n        + 0.095 * empty_image_loss\n        + 0.050 * bce\n    )\n\n\ndef dice_loss(logits, targets, smooth=1.0):\n    probs = torch.sigmoid(logits)\n    probs = probs.flatten(2)\n    targets = targets.flatten(2)\n    intersection = (probs * targets).sum(dim=2)\n    denominator = probs.sum(dim=2) + targets.sum(dim=2)\n    dice = (2 * intersection + smooth) / (denominator + smooth)\n    return 1 - dice.mean()\n\n\nbce_loss = nn.BCEWithLogitsLoss()\n\ndef combined_loss(logits, targets):\n    return metric_aligned_loss(logits, targets)\n\n\n@torch.no_grad()\ndef batch_dice_score(logits, targets, threshold=0.5, smooth=1.0):\n    # Independent per-class binary predictions; overlapping channels are allowed.\n    preds = (torch.sigmoid(logits) >= threshold).float()\n    preds = preds.flatten(2)\n    targets = targets.flatten(2)\n    intersection = (preds * targets).sum(dim=2)\n    denominator = preds.sum(dim=2) + targets.sum(dim=2)\n    return ((2 * intersection + smooth) /\n            (denominator + smooth)).mean().item()\n\n\nprint(\"Independent-sigmoid outputs and metric-aligned loss functions ready.\")\n","metadata":{"execution":{"iopub.execute_input":"2026-10-29T16:17:02.314178Z","iopub.status.busy":"2026-10-29T16:17:02.313805Z","iopub.status.idle":"2026-10-29T16:17:02.323752Z","shell.execute_reply":"2026-10-29T16:17:02.322982Z","shell.execute_reply.started":"2026-10-29T16:17:02.31415Z"}},"outputs":[{"name":"stdout","output_type":"stream","text":["Loss functions ready.\n"]}],"execution_count":93},{"cell_type":"markdown","source":"## 19. Weights & Biases experiment tracking","metadata":{}},{"cell_type":"code","source":"# Track the experiments in the course W&B project.\nimport os\n\