in/test prevalence differ.\ntrain_df = train_df.reset_index(drop=True)\nval_df = val_df.reset_index(drop=True)\n\nprint(\"Training images (all clean + defective):\", len(train_df))\nprint(\"Validation images:\", len(val_df))\nprint(\"Train positives:\")\ndisplay(train_df[label_cols].sum().rename(index=lambda x: x.replace(\"_present\", \"\")))\nprint(\"Validation positives:\")\ndisplay(val_df[label_cols].sum().rename(index=lambda x: x.replace(\"_present\", \"\")))\nprint(\"Clean train images:\", int((train_df[label_cols].sum(axis=1) == 0).sum()))\nprint(\"Clean validation images:\", int((val_df[label_cols].sum(axis=1) == 0).sum()))\n","metadata":{"execution":{"iopub.execute_input":"2026-11-13T04:54:55.481672Z","iopub.status.busy":"2026-11-13T04:54:55.481153Z","iopub.status.idle":"2026-11-13T04:54:56.106322Z","shell.execute_reply":"2026-11-13T04:54:56.104926Z"},"papermill":{"duration":0.653533,"end_time":"2026-11-13T04:54:56.108375+00:00","exception":false,"start_time":"2026-11-13T04:54:55.454842+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"id":"b693974d","cell_type":"markdown","source":"# Define image and mask loading","metadata":{"papermill":{"duration":0.023544,"end_time":"2026-11-13T04:54:56.155058+00:00","exception":false,"start_time":"2026-11-13T04:54:56.131514+00:00","status":"completed"},"tags":[]}},{"id":"08b435c6","cell_type":"code","source":"import torch\nfrom torch.utils.data import Dataset, DataLoader\n\nDEVICE = torch.device(\"cpu\")\nassert DEVICE.type == \"cpu\"\nprint(\"Using device:\", DEVICE, \"| CUDA visibility:\", repr(os.environ.get(\"CUDA_VISIBLE_DEVICES\", \"\")))\n\nHEIGHT, WIDTH = 128, 800\n\nclass DefectDataset(Dataset):\n    \"\"\"Returns (RGB image in 0-1, 4 binary masks). augment=True -> flips + brightness/contrast.\"\"\"\n    def __init__(self, dataframe, augment=False):\n        df = dataframe.reset_index(drop=True)\n        self.paths = df[\"image_path\"].tolist()\n        self.rles = df[CLASSES].values.tolist()\n        self.augment = augment\n\n    def __len__(self):\n        return len(self.paths)\n\n    def __getitem__(self, idx):\n        image = cv2.imread(self.paths[idx])\n        if image is None:\n            raise FileNotFoundError(self.paths[idx])\n        image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n        image = cv2.resize(image, (WIDTH, HEIGHT)).astype(np.float32) / 255.0\n\n        masks = np.stack([decode_rle(r, HEIGHT, WIDTH) for r in self.rles[idx]], axis=0).astype(np.float32)\n\n        if self.augment:\n            if random.random() < 0.5:                      # horizontal flip\n                image, masks = image[:, ::-1], masks[:, :, ::-1]\n            if random.random() < 0.5:                      # vertical flip\n                image, masks = image[::-1], masks[:, ::-1]\n            if random.random() < 0.5:                      # mild brightness / contrast\n                alpha = random.uniform(0.90, 1.10)\n                beta = random.uniform(-0.04, 0.04)\n                image = np.clip(image * alpha + beta, 0, 1)\n            if random.random() < 0.20:                      # mild sensor-like noise\n                noise = np.random.normal(0.0, 0.012, image.shape).astype(np.float32)\n                image = np.clip(image + noise, 0, 1)\n\n        image = torch.from_numpy(np.ascontiguousarray(image.transpose(2, 0, 1)))\n        masks = torch.from_numpy(np.ascontiguousarray(masks))\n        return image, masks","metadata":{"execution":{"iopub.execute_input":"2026-11-13T04:54:56.204738Z","iopub.status.busy":"2026-11-13T04:54:56.204054Z","iopub.status.idle":"2026-11-13T04:55:01.154837Z","shell.execute_reply":"2026-11-13T04:55:01.153925Z"},"papermill":{"duration":4.978512,"end_time":"2026-11-13T04:55:01.157086+00:00","exception":false,"start_time":"2026-11-13T04:54:56.178574+00:00","status":"completed"},"tags":[]},"outputs":[],"execution_count":null},{"id":"b9f5d479","cell_type":"markdown","source":"# 15. Create DataLoaders","metadata":{"papermill":{"duration":0.024234,"end_time":"2026-11-13T04:55:01.206027+00:00","exception":false,"start_time":"2026-11-13T04:55:01.181793+00:00","status":"completed"},"tags":[]}},{"id":"e13ef70a","cell_type":"code","source":"from torch.utils.data import DataLoader, WeightedRandomSampler\n\n# CPU-only weighted sampler exposes rare defect classes more often during training.\n# It still samples clean images, and the validation loader always keeps natural prevalence.\ntrain_dataset = DefectDataset(train_df, augment=True)\nval_dataset = DefectDataset(val_df, augment=False)\n\nclass_counts = {cls: int(train_df[cls + \"_present\"].sum()) for cls in CLASSES}\nmax_count = max(class_counts.values())\nclass_sampling_weight = {\n    cls: min(3.5, max(1.0, (max_count / max(int(class_counts[cls]), 1)) ** 0.5))\n    for cls in CLASSES\n}\n\nsample_weights = []\nfor _, row in train_df.iterrows():\n    present = [cls for cls in CLASSES if int(row[cls + \"_present\"]) == 1]\n    if not present:\n        sample_weights.append(1.0)  # retain clean strips\n    else:\n        # Modest mean class weight avoids overwhelming clean-image exposure.\n        sample_weights.append(1.0 + 0.50 * float(np.mean([class_sampling_weight[c] for c in present]) - 1.0))\n\ntrain_sampler = WeightedRandomSampler(\n    weights=torch.as_tensor(sample_weights, dtype=torch.double),\n    num_samples=len(train_dataset),\n    replacement=True\n)\n\nBATCH_SIZE = 8\nNUM_WORKERS = 0\ntrain_loader = DataLoader(\n    train_dataset, batch_size=BATCH_SIZE, sampler=train_sampler,\n    drop_last=False, num_workers=NUM_WORKERS, pin_memory=False\n)\nval_loader = DataLoader(\n    val_dataset, batch_size=BATCH_SIZE * 2, shuffle=False,\n    num_workers=NUM_WORKERS, pin_memory=False\n)\nprint(\"Training batches:\", len(train_loader))\nprint(\"Validation batches:\", len(val_loader))\nprint(\"Class sampling weights:\", class_sampling_weight)\nprint(\"Clean-image sampling weight: 1.0\")\n","metadata":{"execution":{"iopub.execute_input":"2026-11-13T04:55:01.255357Z","iopub.status.busy":"2026-11-13T04:55:01.254221Z","iopub.status.idle":"2026-11-13T04:55:01.282443Z","shell.execute_reply":"2026-11-13T04:55:01.280899Z"},"papermill":{"duration":0.054996,"end_time":"2026-11-13T04:55:01.284067+00:00","exception":true,"start_time":"2026-11-13T04:55:01.229071+00:00","status":"failed"},"tags":[]},"outputs":[],"execution_count":null},{"id":"5097a5dc","cell_type":"markdown","source":"# Verify one batch before training","metadata":{"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]}},{"id":"70e72dfb","cell_type":"code","source":"images, masks = next(iter(train_loader))\n\nprint(\"Image batch:\", images.shape)\nprint(\"Mask batch:\", masks.shape)\nprint(\"Image range:\", images.min().item(), images.max().item())\nprint(\"Mask values:\", torch.unique(masks))","metadata":{"execution":{"iopub.execute_input":"2026-11-11T16:43:55.499854Z","iopub.status.busy":"2026-11-11T16:43:55.499509Z","iopub.status.idle":"2026-11-11T16:43:55.790133Z","shell.execute_reply":"2026-11-11T16:43:55.788612Z"},"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]},"outputs":[],"execution_count":null},{"id":"6b8cc1bf","cell_type":"markdown","source":"# 17. The U-Net model from Scratch","metadata":{"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]}},{"id":"c6fa555d","cell_type":"code","source":"import torch.nn as nn\nimport torch.nn.functional as F\n\nclass ConvBlock(nn.Module):\n    \"\"\"Two-convolution block used by the scratch encoder-decoder.\"\"\"\n    def __init__(self, in_ch, out_ch):\n        super().__init__()\n        self.block = nn.Sequential(\n            nn.Conv2d(in_ch, out_ch, 3, padding=1, bias=False),\n            nn.BatchNorm2d(out_ch),\n            nn.ReLU(inplace=True),\n            nn.Conv2d(out_ch, out_ch, 3, padding=1, bias=False),\n            nn.BatchNorm2d(out_ch),\n            nn.ReLU(inplace=True)\n        )\n\n    def forward(self, x):\n        return self.block(x)\n\n\nclass UNetScratch(nn.Module):\n    \"\"\"Compact U-Net implemented from scratch (no pretrained weights).\"\"\"\n    def __init__(self, out_channels=4, base=16):\n        super().__init__()\n        self.pool = nn.MaxPool2d(2)\n        self.enc1 = ConvBlock(3, base)\n        self.enc2 = ConvBlock(base, base * 2)\n        self.enc3 = ConvBlock(base * 2, base * 4)\n        self.enc4 = ConvBlock(base * 4, base * 8)\n        self.mid = ConvBlock(base * 8, base * 16)\n        self.up4 = nn.ConvTranspose2d(base * 16, base * 8, 2, stride=2)\n        self.dec4 = ConvBlock(base * 16, base * 8)\n        self.up3 = nn.ConvTranspose2d(base * 8, base * 4, 2, stride=2)\n        self.dec3 = ConvBlock(base * 8, base * 4)\n        self.up2 = nn.ConvTranspose2d(base * 4, base * 2, 2, stride=2)\n        self.dec2 = ConvBlock(base * 4, base * 2)\n        self.up1 = nn.ConvTranspose2d(base * 2, base, 2, stride=2)\n        self.dec1 = ConvBlock(base * 2, base)\n        self.head = nn.Conv2d(base, out_channels, 1)\n\n    def forward(self, x):\n        e1 = self.enc1(x)\n        e2 = self.enc2(self.pool(e1))\n        e3 = self.enc3(self.pool(e2))\n        e4 = self.enc4(self.pool(e3))\n        z = self.mid(self.pool(e4))\n        z = self.dec4(torch.cat([self.up4(z), e4], dim=1))\n        z = self.dec3(torch.cat([self.up3(z), e3], dim=1))\n        z = self.dec2(torch.cat([self.up2(z), e2], dim=1))\n        z = self.dec1(torch.cat([self.up1(z), e1], dim=1))\n        return self.head(z)\n\nmodel = UNetScratch().to(DEVICE)\nprint(\"Scratch U-Net parameters:\", f\"{sum(p.numel() for p in model.parameters()):,}\")\n","metadata":{"execution":{"iopub.execute_input":"2026-11-11T16:43:55.884359Z","iopub.status.busy":"2026-11-11T16:43:55.883973Z","iopub.status.idle":"2026-11-11T16:43:55.928174Z","shell.execute_reply":"2026-11-11T16:43:55.92713Z"},"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]},"outputs":[],"execution_count":null},{"id":"c84a33e8","cell_type":"markdown","source":"# 18. Define the combined loss and Dice metric","metadata":{"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]}},{"id":"b417f5db","cell_type":"code","source":"def metric_aligned_loss(logits, targets, pos_weight=None, eps=1.0):\n    \"\"\"\n    BCE + soft-Dice. Dice is computed on every (strip, class) mask:\n      * positive masks  -> reward overlap            (70% foreground-Dice part of the metric)\n      * empty masks     -> soft-Dice = 1 - 1/(sum(p)+1), which punishes ANY predicted mass\n                           (the 20% false-positive + 10% empty-accuracy parts)\n    Independent sigmoid per class (multi-label), never softmax.\n    \"\"\"\n    logits = logits.float()\n    targets = targets.float()\n    probs = torch.sigmoid(logits)\n\n    p = probs.flatten(2)\n    t = targets.flatten(2)\n    dice_loss_map = 1.0 - (2.0 * (p * t).sum(2) + eps) / (p.sum(2) + t.sum(2) + eps)   # [B, 4]\n    positive = t.sum(2) > 0\n\n    fg = dice_loss_map[positive].mean() if positive.any() else probs.mean() * 0.0\n    empty = dice_loss_map[~positive].mean() if (~positive).any() else probs.mean() * 0.0\n\n    if pos_weight is None:\n        pos_weight = globals().get(\"CLASS_POS_WEIGHT_TENSOR\", None)\n    if pos_weight is None:\n        bce = F.binary_cross_entropy_with_logits(logits, targets)\n    else:\n        bce = F.binary_cross_entropy_with_logits(\n            logits, targets,\n            pos_weight=pos_weight.to(logits.device).view(1, -1, 1, 1)\n        )\n\n    return bce + 0.7 * fg + 0.3 * empty\n\n\ndef dice_loss(logits, targets, smooth=1.0):\n    probs = torch.sigmoid(logits).flatten(2)\n    targets = targets.flatten(2)\n    dice = (2 * (probs * targets).sum(2) + smooth) / (probs.sum(2) + targets.sum(2) + smooth)\n    return 1 - dice.mean()\n\n\nbce_loss = nn.BCEWithLogitsLoss()\n\ndef combined_loss(logits, targets):\n    return metric_aligned_loss(logits, targets)\n\n\n@torch.no_grad()\ndef batch_dice_score(logits, targets, threshold=0.5, smooth=1.0):\n    preds = (torch.sigmoid(logits.float()) >= threshold).float().flatten(2)\n    targets = targets.flatten(2)\n    inter = (preds * targets).sum(2)\n    den = preds.sum(2) + targets.sum(2)\n    return ((2 * inter + smooth) / (den + smooth)).mean().item()\n\n\nprint(\"Independent-sigmoid outputs and BCE + Dice (positive/empty weighted) loss ready.\")","metadata":{"execution":{"iopub.execute_input":"2026-11-11T16:43:56.025672Z","iopub.status.busy":"2026-11-11T16:43:56.025334Z","iopub.status.idle":"2026-11-11T16:43:56.037829Z","shell.execute_reply":"2026-11-11T16:43:56.036918Z"},"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]},"outputs":[],"execution_count":null},{"id":"f97a43d9","cell_type":"markdown","source":"## Training and validation experiments\n","metadata":{"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]}},{"id":"6d97ae76","cell_type":"markdown","source":"## 19. CPU-only training plan and experiment tracking\n\nThis notebook intentionally forces **CPU execution**. It does not select CUDA, enable AMP, or use GPU memory. CPU training is slower, so the default experiment budget is deliberately modest and can be increased after checking runtime.\n\nThe three required, distinct segmentation approaches are:\n1. **Scratch U-Net** — custom encoder-decoder built in this notebook.\n2. **Pretrained ResNet-18 U-Net** — U-Net decoder with ImageNet-pretrained ResNet-18 encoder.\n3. **Pretrained MobileNetV2 DeepLabV3+** — a different segmentation architecture and lightweight ImageNet-pretrained encoder.\n\nThe pretrained encoders are obtained through `segmentation-models-pytorch`. Kaggle Internet must be enabled for the first download unless the weights are already cached. The notebook will stop with a clear error rather than silently claiming an untrained model is pretrained.\n\nFor academic authenticity, keep the experiment history, explain each design choice, and cite the third-party library/backbone. Do not submit code or results you cannot explain in the viva.\n","metadata":{"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]}},{"id":"9de3ec92","cell_type":"code","source":"import gc\nimport time\nimport torch\n\n# Hard CPU-only setting, even if Kaggle detects a GPU.\nDEVICE = torch.device(\"cpu\")\nassert DEVICE.type == \"cpu\"\nassert os.environ.get(\"CUDA_VISIBLE_DEVICES\", \"\") == \"\", \"CUDA must remain hidden for this CPU-only notebook.\"\ntorch.set_num_threads(min(4, os.cpu_count() or 2))\ntorch.manual_seed(2026)\nnp.random.seed(2026)\nrandom.seed(2026)\n\nBATCH_SIZE = 8\nNUM_WORKERS = 0\nEPOCHS_PRIMARY = 7\nEARLY_STOPPING_PATIENCE = 3\nFREEZE_ENCODER_EPOCHS = 1\n\n# The previous notebook already logged three distinct model runs to W&B.\n# Default this improvement run to the strongest previous architecture.\n# Set True only if you want to retrain all three (much longer CPU runtime).\nTRAIN_ALL_THREE = False\nAUXILIARY_EPOCHS = 2\n\n# Estimate class-specific positive pixel prevalence from RLE labels.\ntotal_train_pixels = len(train_df) * HEIGHT * WIDTH\npositive_pixels = np.array([\n    sum(mask_area(str(v).strip()) for v in train_df[cls].fillna(\"\").tolist())\n    for cls in CLASSES\n], dtype=np.float64)\nclass_pos_weights = np.sqrt(\n    np.maximum(total_train_pixels - positive_pixels, 1.0) /\n    np.maximum(positive_pixels, 1.0)\n)\nclass_pos_weights = np.clip(class_pos_weights, 1.0, 8.0).astype(np.float32)\nCLASS_POS_WEIGHT_TENSOR = torch.tensor(class_pos_weights, dtype=torch.float32)\n\nprint(\"DEVICE:\", DEVICE, \"| CPU threads:\", torch.get_num_threads())\nprint(\"Train images:\", len(train_dataset), \"| Validation images:\", len(val_dataset))\nprint(\"Positive pixels:\", dict(zip(CLASSES, positive_pixels.astype(int))))\nprint(\"BCE positive weights:\", dict(zip(CLASSES, class_pos_weights.round(3))))\n","metadata":{"execution":{"iopub.execute_input":"2026-11-11T16:43:56.181796Z","iopub.status.busy":"2026-11-11T16:43:56.181399Z","iopub.status.idle":"2026-11-11T16:43:56.432685Z","shell.execute_reply":"2026-11-11T16:43:56.431582Z"},"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]},"outputs":[],"execution_count":null},{"id":"ed8ea0a9","cell_type":"markdown","source":"## 20. Official validation metric","metadata":{"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]}},{"id":"27e5347f","cell_type":"code","source":"@torch.no_grad()\ndef official_score_from_counts(pred_area, intersection, gt_area):\n    \"\"\"Compute the competition's weighted metric from [N,4] arrays/tensors.\"\"\"\n    if torch.is_tensor(pred_area):\n        pred_area = pred_area.cpu().numpy()\n        intersection = intersection.cpu().numpy()\n        gt_area = gt_area.cpu().numpy()\n    positive = gt_area > 0\n    empty = ~positive\n    fg_dice = (\n        2.0 * intersection[positive] /\n        np.maximum(pred_area[positive] + gt_area[positive], 1)\n    ).mean() if positive.any() else 0.0\n    fp_score = (\n        1.0 - (pred_area[empty] / float(HEIGHT * WIDTH)).mean()\n    ) if empty.any() else 1.0\n    empty_accuracy = (pred_area[empty] == 0).mean() if empty.any() else 1.0\n    score = 0.70 * fg_dice + 0.20 * fp_score + 0.10 * empty_accuracy\n    return float(score), float(fg_dice), float(fp_score), float(empty_accuracy)\n\n\n@torch.no_grad()\ndef evaluate_fixed_threshold(net, threshold=0.20):\n    net.eval()\n    pred_area, intersections, gt_area = [], [], []\n    for images, masks in val_loader:\n        images = images.to(DEVICE)\n        masks = masks.to(DEVICE)\n        probs = torch.sigmoid(net(images).float())\n        preds = probs >= threshold\n        pred_area.append(preds.sum((2, 3)).cpu())\n        intersections.append((preds & masks.bool()).sum((2, 3)).cpu())\n        gt_area.append(masks.sum((2, 3)).cpu())\n    return official_score_from_counts(\n        torch.cat(pred_area), torch.cat(intersections), torch.cat(gt_area)\n    )\n","metadata":{"execution":{"iopub.execute_input":"2026-11-11T16:43:56.528236Z","iopub.status.busy":"2026-11-11T16:43:56.527826Z","iopub.status.idle":"2026-11-11T16:43:56.53875Z","shell.execute_reply":"2026-11-11T16:43:56.537642Z"},"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]},"outputs":[],"execution_count":null},{"id":"dfb0e6d2","cell_type":"markdown","source":"## 21. Build the three model variants","metadata":{"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]}},{"id":"54cc1811","cell_type":"code","source":"import segmentation_models_pytorch as smp\n\nclass RGBNormalize(nn.Module):\n    \"\"\"ImageNet normalization wrapper for pretrained RGB encoders.\"\"\"\n    def __init__(self, network):\n        super().__init__()\n        self.network = network\n        self.register_buffer(\n            \"mean\", torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1)\n        )\n        self.register_buffer(\n            \"std\", torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1)\n        )\n\n    def forward(self, x):\n        return self.network((x - self.mean) / self.std)\n\n\n# Model 1: custom scratch model.\nmodel_scratch = UNetScratch().to(DEVICE)\n\n# Models 2 and 3: genuinely pretrained ImageNet encoders.\ntry:\n    model_resnet_unet = RGBNormalize(\n        smp.Unet(\n            encoder_name=\"resnet18\", encoder_weights=\"imagenet\",\n            in_channels=3, classes=len(CLASSES), activation=None\n        )\n    ).to(DEVICE)\n\n    model_mobilenet_deeplab = RGBNormalize(\n        smp.DeepLabV3Plus(\n            encoder_name=\"mobilenet_v2\", encoder_weights=\"imagenet\",\n            in_channels=3, classes=len(CLASSES), activation=None\n        )\n    ).to(DEVICE)\nexcept Exception as exc:\n    raise RuntimeError(\n        \"Pretrained encoder weights could not be loaded. In Kaggle, enable Internet \"\n        \"or attach/cache the ImageNet weights, then rerun this cell. The notebook \"\n        \"does not silently replace a pretrained model with random weights.\"\n    ) from exc\n\nmodels = {\n    \"scratch_unet\": model_scratch,\n    \"resnet18_unet_pretrained\": model_resnet_unet,\n    \"mobilenetv2_deeplabv3plus_pretrained\": model_mobilenet_deeplab,\n}\nfor model_name, net in models.items():\n    print(model_name, f\"{sum(p.numel() for p in net.parameters()):,} parameters\")\n","metadata":{"execution":{"iopub.execute_input":"2026-11-11T16:43:56.638211Z","iopub.status.busy":"2026-11-11T16:43:56.637166Z","iopub.status.idle":"2026-11-11T16:44:11.936687Z","shell.execute_reply":"2026-11-11T16:44:11.935457Z"},"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]},"outputs":[],"execution_count":null},{"id":"135838e4","cell_type":"markdown","source":"## 22. Train each model on CPU and log three separate W&B runs","metadata":{"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]}},{"id":"739dded8","cell_type":"code","source":"# W&B credentials are read from Kaggle Secrets; local CSV logs are always saved.\nWANDB_ENTITY = \"25ds3000134-ds\"\nWANDB_PROJECT = \"25DS3000134_DLGENAI_PROJECT_T32026\"\nwandb_api_key = None\ntry:\n    from kaggle_secrets import UserSecretsClient\n    wandb_api_key = UserSecretsClient().get_secret(\"WANDB_API_KEY\")\nexcept Exception:\n    pass\n\n\ndef start_wandb_run(model_name, epochs):\n    if not wandb_api_key:\n        print(\"W&B key not found; continuing with local logs.\")\n        return None\n    try:\n        import wandb\n        wandb.login(key=wandb_api_key)\n        return wandb.init(\n            entity=WANDB_ENTITY, project=WANDB_PROJECT,\n            name=f\"cpu-v30-{model_name}\", reinit=\"finish_previous\",\n            config={\n                \"model\": model_name, \"device\": \"cpu\",\n                \"image_height\": HEIGHT, \"image_width\": WIDTH,\n                \"batch_size\": BATCH_SIZE, \"epochs_max\": epochs,\n                \"loss\": \"class-weighted BCE + positive/empty soft Dice\",\n                \"all_clean_training_images\": True,\n                \"weighted_rare_class_sampling\": True,\n                \"freeze_encoder_epochs\": FREEZE_ENCODER_EPOCHS,\n                \"validation_split\": 0.20\n            }\n        )\n    except Exception as exc:\n        print(\"W&B run unavailable:\", str(exc)[:180])\n        return None\n\n\ndef get_pretrained_encoder(net):\n    inner = getattr(net, \"network\", net)\n    return getattr(inner, \"encoder\", None)\n\n\ndef train_one_model(model_name, net, epochs, lr_encoder=4e-5, lr_decoder=2e-4):\n    # Train on CPU. Freeze pretrained encoder briefly, then fine-tune all layers.\n    net.to(DEVICE)\n    encoder = get_pretrained_encoder(net)\n    if encoder is not None:\n        enc_params = list(encoder.parameters())\n        enc_ids = {id(p) for p in enc_params}\n        dec_params = [p for p in net.parameters() if id(p) not in enc_ids]\n        optimizer = torch.optim.AdamW(\n            [{\"params\": enc_params, \"lr\": lr_encoder},\n             {\"params\": dec_params, \"lr\": lr_decoder}],\n            weight_decay=1e-4\n        )\n    else:\n        optimizer = torch.optim.AdamW(net.parameters(), lr=lr_decoder, weight_decay=1e-4)\n\n    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(\n        optimizer, T_max=max(1, epochs + 2)\n    )\n    checkpoint = f\"/kaggle/working/{model_name}_v30_best_cpu.pth\"\n    best_score, wait, rows = -1.0, 0, []\n    run = start_wandb_run(model_name, epochs)\n    start = time.time()\n\n    for epoch in range(1, epochs + 1):\n        freeze_now = encoder is not None and epoch <= FREEZE_ENCODER_EPOCHS\n        if encoder is not None:\n            for p in encoder.parameters():\n                p.requires_grad = not freeze_now\n\n        net.train()\n        if freeze_now:\n            encoder.eval()\n\n        running_loss, batches = 0.0, 0\n        for images, masks in train_loader:\n            images, masks = images.to(DEVICE), masks.to(DEVICE)\n            optimizer.zero_grad(set_to_none=True)\n            logits = net(images)\n            loss = metric_aligned_loss(logits, masks)\n            loss.backward()\n            torch.nn.utils.clip_grad_norm_(net.parameters(), 1.0)\n            optimizer.step()\n            running_loss += float(loss.detach())\n            batches += 1\n\n        scheduler.step()\n        val_score, val_fg, val_fp, val_empty = evaluate_fixed_threshold(net, threshold=0.20)\n        row = {\n            \"model\": model_name, \"epoch\": epoch,\n            \"train_loss\": running_loss / max(1, batches),\n            \"val_official_at_0.20\": val_score,\n            \"val_foreground_dice\": val_fg,\n            \"val_fp_score\": val_fp,\n            \"val_empty_accuracy\": val_empty,\n            \"encoder_frozen\": bool(freeze_now),\n            \"lr_encoder\": optimizer.param_groups[0][\"lr\"],\n            \"lr_decoder\": optimizer.param_groups[-1][\"lr\"]\n        }\n        rows.append(row)\n        print(\n            f\"{model_name} | epoch {epoch}/{epochs} | \"\n            f\"loss={row['train_loss']:.4f} | official@0.20={val_score:.4f} \"\n            f\"| fgDice={val_fg:.4f}\"\n        )\n        if run is not None:\n            run.log(row)\n\n        if val_score > best_score + 1e-5:\n            best_score, wait = val_score, 0\n            torch.save(net.state_dict(), checkpoint)\n        else:\n            wait += 1\n            if wait >= EARLY_STOPPING_PATIENCE:\n                print(\"Early stopping:\", model_name)\n                break\n\n    net.load_state_dict(torch.load(checkpoint, map_location=DEVICE, weights_only=True))\n    net.eval()\n    if run is not None:\n        run.summary[\"best_validation_official_at_0.20\"] = best_score\n        run.finish()\n    print(f\"{model_name} finished in {(time.time()-start)/60:.1f} min; best={best_score:.4f}\")\n    return net, pd.DataFrame(rows), checkpoint\n\n\nif TRAIN_ALL_THREE:\n    models_to_train = models\n    epoch_plan = {\n        \"scratch_unet\": AUXILIARY_EPOCHS,\n        \"resnet18_unet_pretrained\": EPOCHS_PRIMARY,\n        \"mobilenetv2_deeplabv3plus_pretrained\": AUXILIARY_EPOCHS\n    }\nelse:\n    models_to_train = {\n        \"resnet18_unet_pretrained\": models[\"resnet18_unet_pretrained\"]\n    }\n    epoch_plan = {\"resnet18_unet_pretrained\": EPOCHS_PRIMARY}\n\nhistories, checkpoints, fixed_scores = {}, {}, {}\nfor name, net in models_to_train.items():\n    models[name], histories[name], checkpoints[name] = train_one_model(\n        name, net, epochs=epoch_plan[name]\n    )\n    fixed_scores[name] = evaluate_fixed_threshold(models[name], threshold=0.20)[0]\n    gc.collect()\n\nhistory_all = pd.concat(histories.values(), ignore_index=True)\nhistory_all.to_csv(\"/kaggle/working/cpu_model_comparison_v24.csv\", index=False)\ndisplay(history_all)\nprint(\"Fixed-threshold scores:\", fixed_scores)\n","metadata":{"execution":{"iopub.execute_input":"2026-11-11T16:44:12.044333Z","iopub.status.busy":"2026-11-11T16:44:12.043711Z","iopub.status.idle":"2026-11-12T02:37:52.439623Z","shell.execute_reply":"2026-11-12T02:37:52.438664Z"},"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]},"outputs":[],"execution_count":null},{"id":"67292c85","cell_type":"markdown","source":"## 23. Tune thresholds on validation data and choose the best model\n\nThe tuning below uses only the held-out validation split. It searches per-class thresholds and minimum component areas against the weighted competition metric. The chosen model is selected from the three validation results; the test set is not used for model selection.\n","metadata":{"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]}},{"id":"a709f23a","cell_type":"code","source":"@torch.no_grad()\ndef predict_four_way_tta(net, images):\n    \"\"\"Average original, horizontal, vertical and combined-flip predictions.\"\"\"\n    p0 = torch.sigmoid(net(images).float())\n    ph = torch.flip(\n        torch.sigmoid(net(torch.flip(images, dims=[3])).float()), dims=[3]\n    )\n    pv = torch.flip(\n        torch.sigmoid(net(torch.flip(images, dims=[2])).float()), dims=[2]\n    )\n    phv = torch.flip(\n        torch.sigmoid(net(torch.flip(images, dims=[2, 3])).float()), dims=[2, 3]\n    )\n    return (p0 + ph + pv + phv) / 4.0\n\n\n@torch.no_grad()\ndef tune_model_on_validation(net):\n    # Crucial correction: tune thresholds on the SAME TTA probabilities used at test time.\n    net.eval()\n    n = len(val_dataset)\n    thresholds = [0.03, 0.05, 0.08, 0.10, 0.12, 0.15, 0.18, 0.22, 0.26, 0.30, 0.35, 0.45, 0.55]\n    areas = [0, 10, 20, 50, 100, 200]\n    pred_counts = np.zeros((len(thresholds), n, 4), dtype=np.int32)\n    intersections = np.zeros_like(pred_counts)\n    gt_area = np.zeros((n, 4), dtype=np.int32)\n\n    offset = 0\n    for images, masks in val_loader:\n        probs = predict_four_way_tta(net, images.to(DEVICE))\n        b = len(images)\n        gt_area[offset:offset+b] = masks.sum((2, 3)).cpu().numpy()\n        for ti, threshold in enumerate(thresholds):\n            pred = probs >= threshold\n            pred_counts[ti, offset:offset+b] = pred.sum((2, 3)).cpu().numpy()\n            intersections[ti, offset:offset+b] = (\n                (pred & masks.bool()).sum((2, 3)).cpu().numpy()\n            )\n        offset += b\n\n    pos = gt_area > 0\n    empty = ~pos\n    params = {}\n\n    # Optimize each class independently using the competition's three score components.\n    for c, cls in enumerate(CLASSES):\n        pos_c = pos[:, c]\n        empty_c = empty[:, c]\n        n_pos_c = max(int(pos_c.sum()), 1)\n        n_empty_c = max(int(empty_c.sum()), 1)\n        best_value, best_param = -1e9, None\n\n        for ti, threshold in enumerate(thresholds):\n            for min_area in areas:\n                pa = pred_counts[ti, :, c].copy()\n                it = intersections[ti, :, c].copy()\n                keep = pa >= min_area\n                pa[~keep] = 0\n                it[~keep] = 0\n\n                dice_mean = (\n                    2.0 * it[pos_c] /\n                    np.maximum(pa[pos_c] + gt_area[pos_c, c], 1)\n                ).mean() if pos_c.any() else 0.0\n                fp_score = (\n                    1.0 - (pa[empty_c] / float(HEIGHT * WIDTH)).mean()\n                ) if empty_c.any() else 1.0\n                empty_accuracy = (\n                    (pa[empty_c] == 0).mean()\n                ) if empty_c.any() else 1.0\n                value = 0.70 * dice_mean + 0.20 * fp_score + 0.10 * empty_accuracy\n\n                if value > best_value:\n                    best_value = value\n                    best_param = {\n                        \"threshold\": float(threshold),\n                        \"min_area\": int(min_area),\n                        \"gate\": 0.0\n                    }\n        params[cls] = best_param\n\n    final_pa, final_it = [], []\n    for images, masks in val_loader:\n        probs = predict_four_way_tta(net, images.to(DEVICE)).cpu().numpy()\n        batch_pa = np.zeros((len(images), 4), dtype=np.int32)\n        batch_it = np.zeros_like(batch_pa)\n        y = masks.numpy()\n        for c, cls in enumerate(CLASSES):\n            q = params[cls]\n            binary = probs[:, c] >= q[\"threshold\"]\n            area = binary.sum((1, 2))\n            binary[area < q[\"min_area\"]] = False\n            batch_pa[:, c] = binary.sum((1, 2))\n            batch_it[:, c] = (binary * y[:, c]).sum((1, 2))\n        final_pa.append(batch_pa)\n        final_it.append(batch_it)\n\n    score, fg, fp, ea = official_score_from_counts(\n        np.concatenate(final_pa), np.concatenate(final_it), gt_area\n    )\n    return score, fg, fp, ea, params\n\n\ntuned_results = {}\nfor name in models_to_train:\n    result = tune_model_on_validation(models[name])\n    tuned_results[name] = result\n    print(\n        name, \"TTA-tuned official:\", round(result[0], 5),\n        \"| FG Dice:\", round(result[1], 5),\n        \"| FP score:\", round(result[2], 5),\n        \"| empty accuracy:\", round(result[3], 5)\n    )\n    print(\"Class parameters:\", result[4])\n\nbest_model_name = max(tuned_results, key=lambda k: tuned_results[k][0])\nbest_model = models[best_model_name]\nbest_validation_official = tuned_results[best_model_name][0]\nbest_class_params = tuned_results[best_model_name][4]\nprint(\"Selected:\", best_model_name)\nprint(\"TTA-tuned validation score:\", round(best_validation_official, 5))\n","metadata":{"execution":{"iopub.execute_input":"2026-11-12T02:37:52.584934Z","iopub.status.busy":"2026-11-12T02:37:52.584583Z","iopub.status.idle":"2026-11-12T02:54:47.141604Z","shell.execute_reply":"2026-11-12T02:54:47.140624Z"},"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]},"outputs":[],"execution_count":null},{"id":"659e4fa2","cell_type":"markdown","source":"## 24. Test image discovery and RLE helpers","metadata":{"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]}},{"id":"81233979","cell_type":"code","source":"# Reuse the official competition sample-submission order.\nall_image_paths = glob.glob(\"/kaggle/input/**/*\", recursive=True)\nvalid_extensions = (\".png\", \".jpg\", \".jpeg\", \".bmp\")\nrequested_ids = sample_submission[\"image_id\"].astype(str).unique()\nrequested_stems = {Path(x).stem for x in requested_ids}\ntest_candidates = [\n    p for p in all_image_paths\n    if p.lower().endswith(valid_extensions)\n    and \"/test/\" in p.replace(\"\\\\\", \"/\").lower()\n    and Path(p).stem in requested_stems\n]\nif not test_candidates:\n    test_candidates = [\n        p for p in all_image_paths\n        if p.lower().endswith(valid_extensions) and Path(p).stem in requested_stems\n    ]\ntest_image_map = {}\nfor pth in test_candidates:\n    test_image_map.setdefault(Path(pth).stem, pth)\nmissing = [x for x in requested_ids if Path(x).stem not in test_image_map]\nif missing:\n    raise FileNotFoundError(f\"Missing {len(missing)} test images; examples: {missing[:5]}\")\n\ndef apply_minimum_mask_area(binary_mask, min_area):\n    \"\"\"Match validation tuning: discard a whole class mask if its total area is too small.\"\"\"\n    binary_mask = binary_mask.astype(np.uint8)\n    if int(binary_mask.sum()) < int(min_area):\n        binary_mask[:] = 0\n    return binary_mask\n\n\ndef encode_rle(mask):\n    pixels = np.asarray(mask, dtype=np.uint8).T.flatten()\n    pixels = np.concatenate(([0], pixels, [0]))\n    changes = np.where(pixels[1:] != pixels[:-1])[0] + 1\n    changes[1::2] -= changes[::2]\n    return \" \".join(map(str, changes))\n","metadata":{"execution":{"iopub.execute_input":"2026-11-12T02:54:47.28672Z","iopub.status.busy":"2026-11-12T02:54:47.286314Z","iopub.status.idle":"2026-11-12T02:54:51.154564Z","shell.execute_reply":"2026-11-12T02:54:51.153598Z"},"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]},"outputs":[],"execution_count":null},{"id":"441ec67f","cell_type":"markdown","source":"## 25. CPU-only test inference and submission generation","metadata":{"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]}},{"id":"1bfeb171","cell_type":"code","source":"class TestImageDataset(torch.utils.data.Dataset):\n    def __init__(self, ids):\n        self.ids = list(ids)\n    def __len__(self):\n        return len(self.ids)\n    def __getitem__(self, idx):\n        image_id = self.ids[idx]\n        image = cv2.imread(test_image_map[Path(image_id).stem])\n        if image is None:\n            raise FileNotFoundError(test_image_map[Path(image_id).stem])\n        image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n        image = cv2.resize(image, (WIDTH, HEIGHT)).astype(np.float32) / 255.0\n        tensor = torch.from_numpy(np.ascontiguousarray(image.transpose(2, 0, 1)))\n        return image_id, tensor\n\n\ntest_ids = sample_submission[\"image_id\"].astype(str).drop_duplicates().tolist()\ntest_loader = DataLoader(\n    TestImageDataset(test_ids), batch_size=BATCH_SIZE,\n    shuffle=False, num_workers=0, pin_memory=False\n)\n\nbest_model.eval()\nprediction_cache = {}\nwith torch.no_grad():\n    for batch_ids, images in test_loader:\n        images = images.to(DEVICE)\n        # Exactly the same TTA averaging used for validation threshold tuning.\n        probs = predict_four_way_tta(best_model, images).cpu().numpy()\n\n        for b, image_id in enumerate(batch_ids):\n            masks_for_image = {}\n            for c, cls in enumerate(CLASSES):\n                q = best_class_params[cls]\n                binary = (probs[b, c] >= q[\"threshold\"]).astype(np.uint8)\n                if probs[b, c].max() < q[\"gate\"]:\n                    binary[:] = 0\n                binary = apply_minimum_mask_area(binary, q[\"min_area\"])\n                masks_for_image[cls] = encode_rle(binary)\n            prediction_cache[image_id] = masks_for_image\n\nsubmission = sample_submission.copy()\nsubmission[\"image_id\"] = submission[\"image_id\"].astype(str)\nsubmission[\"defect_type\"] = submission[\"defect_type\"].astype(str)\nsubmission[\"mask_rle\"] = [\n    prediction_cache[image_id][defect].strip() or \" \"\n    for image_id, defect in zip(submission[\"image_id\"], submission[\"defect_type\"])\n]\nsubmission = submission[[\"ID\", \"image_id\", \"defect_type\", \"mask_rle\"]]\n\nassert len(submission) == len(sample_submission)\nassert submission[\"ID\"].equals(sample_submission[\"ID\"])\nassert submission[\"image_id\"].equals(sample_submission[\"image_id\"].astype(str))\nassert submission[\"defect_type\"].equals(sample_submission[\"defect_type\"].astype(str))\nassert submission[\"mask_rle\"].notna().all()\n\noutput_path = \"/kaggle/working/submission.csv\"\nsubmission.to_csv(output_path, index=False)\nprint(\"Saved:\", output_path)\nprint(\"Chosen model:\", best_model_name)\nprint(\"Validation official score:\", round(best_validation_official, 5))\nprint(\"Submission rows:\", len(submission), \"| images:\", submission[\"image_id\"].nunique())\nprint(\"Non-empty masks:\", int((submission[\"mask_rle\"].str.strip() != \"\").sum()))\ndisplay(submission.head())\n","metadata":{"execution":{"iopub.execute_input":"2026-11-12T02:54:51.27108Z","iopub.status.busy":"2026-11-12T02:54:51.270734Z","iopub.status.idle":"2026-11-12T03:33:26.627169Z","shell.execute_reply":"2026-11-12T03:33:26.626234Z"},"papermill":{"duration":null,"end_time":null,"exception":null,"start_time":null,"status":"pending"},"tags":[]},"outputs":[],"execution_count":null}]}